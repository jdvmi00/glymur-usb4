+/* One RAM-test FEC setup before training, never a live-stream command. */
+static int dp_set_fec_ready_probe(void *ctx, bool enable)
+{
+	struct qcom_usb4_dp *dp = ctx;
+	u8 ready, status, tx[4] = { enable, 0x0a, 0, 0 }, rx[4] = {};
+	int ret;
+
+	if (!fec_dsc_probe)
+		return -EOPNOTSUPP;
+	mutex_lock(&dp->fifo_lock);
+	if (dp->fec_setup_attempted) {
+		mutex_unlock(&dp->fifo_lock);
+		return -EBUSY;
+	}
+	dp->fec_setup_attempted = true;
+	mutex_unlock(&dp->fifo_lock);
+
+	/* Receiver readiness may survive a host reset. Require encoding off. */
+	ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_CONFIGURATION, &ready);
+	if (ret)
+		return ret;
+	if (ready != 0 && ready != DP_FEC_READY)
+		return -EINVAL;
+	ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_STATUS, &status);
+	if (ret)
+		return ret;
+	if (status)
+		return -EBUSY;
+	dev_info(dp->dev, "FEC DSC probe begin: retained readiness=%#x\n", ready);
+	if (ready) {
+		ret = drm_dp_dpcd_write_byte(&dp->aux, DP_FEC_CONFIGURATION, 0);
+		if (ret)
+			return ret;
+		ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_CONFIGURATION, &ready);
+		if (ret)
+			return ret;
+		if (ready)
+			return -EIO;
+	}
+	if (enable) {
+		ret = drm_dp_dpcd_write_byte(&dp->aux, DP_FEC_CONFIGURATION, DP_FEC_READY);
+		if (ret)
+			return ret;
+		ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_CONFIGURATION, &ready);
+		if (ret)
+			return ret;
+		if (ready != DP_FEC_READY)
+			return -EIO;
+	}
+
+	/* dp_control owns fifo_lock and validates the echoed opcode. */
+	ret = dp_control(dp, tx, rx);
+	dev_info(dp->dev, "FEC DSC probe ret=%d reply=%*ph\n", ret, 4, rx);
+	return ret;
+}
