+++ b/drivers/thunderbolt/qcom-usb4-events.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/unaligned.h>
+
+#include "qcom-usb4-events.h"
+
+#define QCOM_USB4_EVENTS_HEADER_SIZE 16
+
+int qcom_usb4_events_decode(const u8 *snapshot, size_t size, u32 consumer,
+			    struct qcom_usb4_events *events)
+{
+	struct qcom_usb4_events decoded = {};
+	u32 layout, tail, head, i, j;
+
+	if (!snapshot || !events || size < QCOM_USB4_EVENTS_HEADER_SIZE)
+		return -EINVAL;
+
+	layout = get_unaligned_le32(snapshot);
+	decoded.capacity = layout & 0xffff;
+	decoded.stride = layout >> 16;
+	decoded.producer = get_unaligned_le32(snapshot + 4);
+	if (!decoded.capacity || !decoded.stride ||
+	    consumer >= decoded.capacity || decoded.producer >= decoded.capacity)
+		return -EINVAL;
+
+	/* Validate the entire ring, not just the unread portion; no size overflow. */
+	if (decoded.capacity > (size - QCOM_USB4_EVENTS_HEADER_SIZE) / decoded.stride)
+		return -EINVAL;
+
+	decoded.consumer = consumer;
+	decoded.auxiliary = get_unaligned_le32(snapshot + 8);
+	decoded.reserved = get_unaligned_le32(snapshot + 12);
+	if (decoded.producer >= consumer) {
+		tail = decoded.producer - consumer;
+		head = 0;
+	} else {
+		tail = decoded.capacity - consumer;
+		head = decoded.producer;
+	}
+	decoded.pending_modulo = tail + head;
+	decoded.spans[0].count = tail;
+	decoded.spans[1].count = head;
+	if (tail)
+		decoded.spans[0].data = snapshot + QCOM_USB4_EVENTS_HEADER_SIZE +
+			(size_t)consumer * decoded.stride;
+	if (head)
+		decoded.spans[1].data = snapshot + QCOM_USB4_EVENTS_HEADER_SIZE;
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < decoded.spans[i].count; j++)
+			if (decoded.spans[i].data[(size_t)j * decoded.stride] == 4)
+				decoded.type4_records++;
+
+	*events = decoded;
+	return 0;
+}
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-events.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QCOM_USB4_EVENTS_H
+#define QCOM_USB4_EVENTS_H
+
+#include <linux/types.h>
+
+struct qcom_usb4_event_span {
+	const u8 *data;
+	u32 count;
+};
+
+struct qcom_usb4_events {
+	u32 capacity;
+	u32 stride;
+	u32 producer;
+	u32 consumer;
+	u32 pending_modulo;
+	u32 auxiliary;
+	u32 reserved;
+	u32 type4_records;
+	/* Unread records in order: tail, then head. Empty spans have NULL data. */
+	struct qcom_usb4_event_span spans[2];
+};
+
+/*
+ * Decode the recovered MCU event format from a stable, ordinary-memory copy.
+ * snapshot must remain immutable and alive while the returned spans are used;
+ * it must not overlap events. This does not capture live shared RAM or MMIO.
+ * size is the accessible snapshot length. On error, events is unchanged.
+ *
+ * A caller must separately establish coherent publication and no producer
+ * overwrite. Every modulo count can conceal complete laps, including zero.
+ * producer is the next private cursor only after the caller consumes the
+ * spans; this helper neither updates a cursor nor writes a shared reader.
+ * auxiliary and reserved have unknown semantics and are left uninterpreted.
+ * Type 4 signals a Windows stop waiter, but supplies no proven freshness token
+ * or MCU/DMA halt guarantee. type4_records is only a record count.
+ */
+int qcom_usb4_events_decode(const u8 *snapshot, size_t size, u32 consumer,
+			    struct qcom_usb4_events *events);
+
+#endif
