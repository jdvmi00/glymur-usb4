+/*
+ * Decide which TX lane blocks DP may program.
+ *
+ * Without dedicated DP TX blocks, dp_tx/dp_tx2 alias the lane blocks that
+ * USB3 also programs (qmp_combo_parse_dt()).  On the v8 USB43DP PHY the DP
+ * lane table rewrites the interface-select, lane-mode and clock-buffer
+ * registers of both blocks, which takes the block carrying the live USB3
+ * link away from the USB3 PCS.  With dp_lanes_exclusive set, DP programs
+ * only the block that carries its lanes while USB3 shares the port (USB3DP
+ * mode, DP on two or one lanes).  The block USB3 occupies follows the cable
+ * orientation (block A in normal, block B in reverse orientation), so DP
+ * takes the other one: block B in normal, block A in reverse.  This is
+ * independent of dp_mode_ignore_reverse, which only concerns the DP PCS's
+ * own lane numbering.  In DP-only mode DP owns both blocks.
+ */
+static void qmp_combo_dp_lane_blocks(struct qmp_combo *qmp, bool *use_tx,
+				     bool *use_tx2)
+{
+	const struct qmp_phy_cfg *cfg = qmp->cfg;
+	bool reverse = qmp->orientation == TYPEC_ORIENTATION_REVERSE;
+
+	*use_tx = true;
+	*use_tx2 = true;
+
+	if (!cfg->dp_lanes_exclusive || qmp->dp_tx != qmp->tx)
+		return;
+
+	if (qmp->qmpphy_mode != QMPPHY_MODE_USB3DP)
+		return;
+
+	if (qmp->dp_opts.lanes >= 4)
+		return;
+
+	if (reverse)
+		*use_tx2 = false;
+	else
+		*use_tx = false;
+}
