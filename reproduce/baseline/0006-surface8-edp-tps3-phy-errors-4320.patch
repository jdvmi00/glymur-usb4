--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c	2026-09-10 23:53:39.075244217 -0500
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c	2026-09-10 23:54:34.488806141 -0500
@@ -1587,7 +1587,13 @@
 
 	*training_step = DP_TRAINING_2;
 
-	if (drm_dp_tps4_supported(panel->dpcd)) {
+	/*
+	 * Bring-up (Surface Laptop 8, glymur/mahua): the Sharp LQ138P1JX61 eDP
+	 * 1.4 panel advertises TPS4 but channel equalisation never completes
+	 * with it, while the firmware trains the same panel as a DPCD 1.2 sink
+	 * (TPS3). Prefer TPS3 until the TPS4 path on this SoC is understood.
+	 */
+	if (0 && drm_dp_tps4_supported(panel->dpcd)) {
 		pattern = DP_TRAINING_PATTERN_4;
 		state_ctrl_bit = 4;
 	} else if (drm_dp_tps3_supported(panel->dpcd)) {
@@ -1835,8 +1841,17 @@
 	ctrl->phy_opts.dp.link_rate = ctrl->link->link_params.rate / 100;
 	ctrl->phy_opts.dp.ssc = drm_dp_max_downspread(dpcd);
 
-	phy_configure(phy, &ctrl->phy_opts);
-	phy_power_on(phy);
+	ret = phy_configure(phy, &ctrl->phy_opts);
+	if (ret) {
+		DRM_ERROR("Unable to configure phy for %u kHz / %u lanes. ret=%d\n",
+			  ctrl->phy_opts.dp.link_rate * 100, ctrl->phy_opts.dp.lanes, ret);
+		return ret;
+	}
+	ret = phy_power_on(phy);
+	if (ret) {
+		DRM_ERROR("Unable to power on phy. ret=%d\n", ret);
+		return ret;
+	}
 
 	dev_pm_opp_set_rate(ctrl->dev, ctrl->link->link_params.rate * 1000);
 	ret = msm_dp_ctrl_link_clk_enable(&ctrl->msm_dp_ctrl);
