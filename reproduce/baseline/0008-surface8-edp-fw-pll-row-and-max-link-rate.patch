 	writel(code1_mode0, edp->pll + DP_QSERDES_V8_COM_BIN_VCOCAL_CMP_CODE1_MODE0);
 	writel(code2_mode0, edp->pll + DP_QSERDES_V8_COM_BIN_VCOCAL_CMP_CODE2_MODE0);
@@ -1163,6 +1186,13 @@
 	writel(0x05, edp->edp + DP_PHY_TX0_TX1_LANE_CTL);
 	writel(0x05, edp->edp + DP_PHY_TX2_TX3_LANE_CTL);
 
+	if (edp->cfg->ver_ops == &qcom_edp_phy_ops_v8) {
+		writel(0x05, edp->edp + 0xc0);	/* v8 TX2_TX3_LANE_CTL */
+		writel(0x10, edp->edp + 0x78);	/* v8 TSYNC_OVRD */
+		writel(0x12, edp->edp + 0xe4);	/* v8 LN0_DRV_LVL */
+		writel(0x12, edp->edp + 0xe8);	/* v8 LN1_DRV_LVL */
+	}
+
 	/* TX-0 register configuration */
 	writel(0x03, edp->tx0 + TXn_TRANSCEIVER_BIAS_EN);
 	writel(0x0f, edp->tx0 + TXn_CLKBUF_ENABLE);
@@ -1204,6 +1234,26 @@
 	writel(0x11, edp->tx1 + TXn_RES_CODE_LANE_OFFSET_TX0);
 	writel(0x11, edp->tx1 + TXn_RES_CODE_LANE_OFFSET_TX1);
 
+	if (edp->cfg->ver_ops == &qcom_edp_phy_ops_v8) {
+		/*
+		 * v8 TX lane register map differs from the TXn_ offsets above:
+		 * 0x44/0x48 are not RES_CODE_LANE_OFFSET and 0x84 is LANE_MODE_1
+		 * (the LDO_CONFIG write hits it). Values as programmed by the
+		 * Surface Laptop 8 firmware; without them clock recovery passes
+		 * but channel equalization never completes.
+		 */
+		writel(0x06, edp->tx0 + 0x44);
+		writel(0x06, edp->tx0 + 0x48);
+		writel(0x06, edp->tx1 + 0x44);
+		writel(0x06, edp->tx1 + 0x48);
+		writel(0xd0, edp->tx0 + 0x84);
+		writel(0xd0, edp->tx1 + 0x84);
+		writel(0x44, edp->tx0 + 0x88);
+		writel(0x44, edp->tx1 + 0x88);
+		writel(0x01, edp->tx0 + 0x90);
+		writel(0x01, edp->tx1 + 0x90);
+	}
+
 	writel(0x10, edp->tx0 + TXn_TX_EMP_POST1_LVL);
 	writel(0x10, edp->tx1 + TXn_TX_EMP_POST1_LVL);
 	writel(0x1f, edp->tx0 + TXn_TX_DRV_LVL);
