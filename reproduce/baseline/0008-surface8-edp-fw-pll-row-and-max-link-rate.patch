 #define DP_INTF_CONFIG_DATABUS_WIDEN     BIT(4)
 
+/*
+ * Bring-up knob: train an eDP sink at DPCD MAX_LINK_RATE, ignoring its
+ * SUPPORTED_LINK_RATES table and the endpoint's link-frequencies cap.
+ */
+static bool edp_force_max_link_rate;
+module_param(edp_force_max_link_rate, bool, 0444);
+MODULE_PARM_DESC(edp_force_max_link_rate, "eDP: train at DPCD MAX_LINK_RATE (ignore SUPPORTED_LINK_RATES and link-frequencies)");
+
 struct msm_dp_panel_private {
 	struct device *dev;
 	struct drm_device *drm_dev;
