From: Jim Martin <jimmartin@gmail.com>
Subject: [PATCH] drm/msm/dp: retry link training before giving up on bridge-driven ports

msm_dp_ctrl_on_link() only retries a failed link training when the
controller's own HPD status register reports the sink as connected.  On
ports whose hot-plug arrives through a Type-C aux-hpd bridge (pmic-glink)
that register stays at zero, so the first failure is final: on a Surface
Laptop 8 with a Dell U5226KW about one reverse-orientation plug in four
failed channel equalization at the monitor's repeater, the enable aborted
with -ECONNRESET, and the output stayed dark until the next replug even
though turning the output off and on again trained cleanly every time.

Decide whether to retry from the software plug state the display code
already keeps (AUX transfers enabled and not eDP) as well as the HPD
register, and retry channel-equalization failures twice with unchanged
link parameters before reducing the rate or lane count.

Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
diff -ru a/drivers/gpu/drm/msm/dp/dp_aux.c b/drivers/gpu/drm/msm/dp/dp_aux.c
--- a/drivers/gpu/drm/msm/dp/dp_aux.c	2026-09-14 10:26:55.738453612 -0500
+++ b/drivers/gpu/drm/msm/dp/dp_aux.c	2026-09-14 10:26:55.755599518 -0500
@@ -499,6 +499,25 @@
 	return IRQ_HANDLED;
 }
 
+/*
+ * Whether the sink is still plugged for the purpose of retrying link
+ * training.  On ports where hot-plug arrives through a Type-C bridge rather
+ * than the controller's HPD pin the hardware HPD status stays at zero, so
+ * also honour the software plug state the display code keeps in
+ * enable_xfers.
+ */
+bool msm_dp_aux_link_plugged(struct drm_dp_aux *msm_dp_aux)
+{
+	struct msm_dp_aux_private *aux;
+
+	aux = container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+
+	if (msm_dp_aux_is_link_connected(msm_dp_aux))
+		return true;
+
+	return !aux->is_edp && aux->enable_xfers;
+}
+
 void msm_dp_aux_enable_xfers(struct drm_dp_aux *msm_dp_aux, bool enabled)
 {
 	struct msm_dp_aux_private *aux;
diff -ru a/drivers/gpu/drm/msm/dp/dp_aux.h b/drivers/gpu/drm/msm/dp/dp_aux.h
--- a/drivers/gpu/drm/msm/dp/dp_aux.h	2026-09-14 10:26:55.738453612 -0500
+++ b/drivers/gpu/drm/msm/dp/dp_aux.h	2026-09-14 10:26:55.755326324 -0500
@@ -22,6 +22,7 @@
 void msm_dp_aux_hpd_intr_disable(struct drm_dp_aux *msm_dp_aux);
 u32 msm_dp_aux_get_hpd_intr_status(struct drm_dp_aux *msm_dp_aux);
 u32 msm_dp_aux_is_link_connected(struct drm_dp_aux *msm_dp_aux);
+bool msm_dp_aux_link_plugged(struct drm_dp_aux *msm_dp_aux);
 
 struct phy;
 struct drm_dp_aux *msm_dp_aux_get(struct device *dev,
diff -ru a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c	2026-09-14 10:26:55.738453612 -0500
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c	2026-09-14 10:26:55.756187398 -0500
@@ -2354,6 +2354,12 @@
 	struct msm_dp_ctrl_private *ctrl;
 	u32 rate;
 	int link_train_max_retries = 5;
+	/*
+	 * Retries with unchanged link parameters before the rate or lane count
+	 * is reduced: the first training after a Type-C plug can fail channel
+	 * equalization at a repeater and pass unchanged on the next attempt.
+	 */
+	int same_params_retries = 2;
 	u32 const phy_cts_pixel_clk_khz = 148500;
 	u8 link_status[DP_LINK_STATUS_SIZE];
 	unsigned int training_step;
@@ -2398,7 +2404,7 @@
 			break;
 		} else if (training_step == DP_TRAINING_1) {
 			/* link train_1 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			if (!msm_dp_aux_link_plugged(ctrl->aux))
 				break;
 
 			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
@@ -2423,20 +2429,27 @@
 			}
 		} else if (training_step == DP_TRAINING_2) {
 			/* link train_2 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			if (!msm_dp_aux_link_plugged(ctrl->aux))
 				break;
 
-			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+			if (same_params_retries-- > 0) {
+				drm_dbg_dp(ctrl->drm_dev,
+					   "retrying link training at rate=%d lanes=%d\n",
+					   ctrl->link->link_params.rate,
+					   ctrl->link->link_params.num_lanes);
+			} else {
+				drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+
+				if (!drm_dp_clock_recovery_ok(link_status,
+						ctrl->link->link_params.num_lanes))
+					rc = msm_dp_ctrl_link_rate_down_shift(ctrl);
+				else
+					rc = msm_dp_ctrl_link_lane_down_shift(ctrl, panel);
 
-			if (!drm_dp_clock_recovery_ok(link_status,
-					ctrl->link->link_params.num_lanes))
-				rc = msm_dp_ctrl_link_rate_down_shift(ctrl);
-			else
-				rc = msm_dp_ctrl_link_lane_down_shift(ctrl, panel);
-
-			if (rc < 0) {
-				/* end with failure */
-				break; /* lane == 1 already */
+				if (rc < 0) {
+					/* end with failure */
+					break; /* lane == 1 already */
+				}
 			}
 
 			/* stop link training before start re training  */
