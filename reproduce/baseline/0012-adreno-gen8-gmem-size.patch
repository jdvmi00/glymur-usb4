+int a8xx_get_param(struct msm_gpu *gpu, struct msm_context *ctx,
+		   u32 param, u64 *value, u32 *len)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	int ret;
+
+	ret = adreno_get_param(gpu, ctx, param, value, len);
+	if (ret || param != MSM_PARAM_GMEM_SIZE)
+		return ret;
+
+	/* The catalog describes GMEM with all physical slices enabled. */
+	*value = (*value / adreno_gpu->info->a6xx->max_slices) *
+		hweight32(a6xx_gpu->slice_mask);
+
+	return 0;
+}
