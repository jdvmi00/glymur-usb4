+/* Status bit use established by the Glymur driver, not the USB3 PCS layout. */
+#define QPHY_V8_USB4_PCS_STATUS_1C	0x1c
+#define QPHY_V8_USB4_IVCM_RECALIBRATE	GENMASK(2, 1)
+#define QPHY_V8_USB4_IVCM_RESULT_MASK	GENMASK(5, 0)
+#define QPHY_V8_USB4_IVCM_EXPECTED	0x20
+/* Shared USB4 DP producer/AUX block offsets/values recovered from the Windows driver. */
+#define QMP_USB4_DP_AUX_MODE		0x1c
+#define QMP_USB4_DP_AUX_CFG1		0x24
+#define QMP_USB4_DP_AUX_CFG1_VAL	0x4e
+
+static int qmp_v8_usb4_wait_ready(struct qmp_combo *qmp)
+{
+	u32 status;
+
+	return readl_poll_timeout(qmp->usb4_pcs + qmp->cfg->regs[QPHY_PCS_STATUS],
+				  status, !(status & PHYSTATUS), 1000,
+				  PHY_INIT_COMPLETE_TIMEOUT);
+}
+
+static int qmp_v8_usb4_calibrate(struct qmp_combo *qmp)
+{
+	void __iomem *pcs = qmp->usb4_pcs;
+	u32 lane_a, lane_b;
+	int attempt, ret;
+
+	usleep_range(100, 110);
+	if (!(readl(pcs + QPHY_V8_USB4_PCS_STATUS_1C) &
+	      QPHY_V8_USB4_IVCM_RECALIBRATE))
+		return 0;
+
+	writel(0x22, qmp->tx + QSERDES_V8_LALB_RX_IVCM_CAL_CTRL1);
+	writel(0x22, qmp->tx2 + QSERDES_V8_LALB_RX_IVCM_CAL_CTRL1);
+
+	ret = -EIO;
+	for (attempt = 0; attempt < 2; attempt++) {
+		writel(SW_RESET, pcs + qmp->cfg->regs[QPHY_SW_RESET]);
+		udelay(1);
+		writel(0, pcs + qmp->cfg->regs[QPHY_SW_RESET]);
+
+		ret = qmp_v8_usb4_wait_ready(qmp);
+		if (ret)
+			break;
+
+		lane_a = readl(qmp->tx + QSERDES_V8_LALB_IVCM_CAL_STATUS);
+		lane_b = readl(qmp->tx2 + QSERDES_V8_LALB_IVCM_CAL_STATUS);
+		if ((lane_a & QPHY_V8_USB4_IVCM_RESULT_MASK) == QPHY_V8_USB4_IVCM_EXPECTED &&
+		    (lane_b & QPHY_V8_USB4_IVCM_RESULT_MASK) == QPHY_V8_USB4_IVCM_EXPECTED)
+			break;
+		ret = -EIO;
+	}
+
+	writel(0, qmp->tx + QSERDES_V8_LALB_RX_IVCM_CAL_CTRL1);
+	writel(0, qmp->tx2 + QSERDES_V8_LALB_RX_IVCM_CAL_CTRL1);
+	return ret;
+}
+
+static int qmp_v8_configure_usb4_phy(struct qmp_combo *qmp)
+{
+	const struct qmp_phy_init_tbl *table;
+	unsigned int count;
+	u32 tunnel_clock;
+	int ret;
+
+	if (qmp->usb4_rx_eq > 0xff)
+		return -EINVAL;
+
+	switch (qmp->usb4_phy_submode) {
+	case PHY_SUBMODE_USB4:
+		table = glymur_usb4_init_tbl;
+		count = ARRAY_SIZE(glymur_usb4_init_tbl);
+		break;
+	case PHY_SUBMODE_TBT3:
+		table = glymur_tbt3_init_tbl;
+		count = ARRAY_SIZE(glymur_tbt3_init_tbl);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * Captured order: common setup, then the shared DP producer/AUX block
+	 * (router 0: 0xfe6000, offsets 0x1c = 0 and 0x24 = 0x4e), then the
+	 * common/PCS resets and the selected table.
+	 */
+	if (qmp->usb4_dp_aux) {
+		writel(0, qmp->usb4_dp_aux + QMP_USB4_DP_AUX_MODE);
+		writel(QMP_USB4_DP_AUX_CFG1_VAL, qmp->usb4_dp_aux + QMP_USB4_DP_AUX_CFG1);
+	}
+
+	/* Clock and regulator ownership remains with qmp_combo_com_init(). */
+	tunnel_clock = readl(qmp->com + QPHY_V3_DP_COM_PHY_MODE_CTRL) &
+		       DP_TUNNELING_CLOCK_GEN_EN;
+	writel(SW_RESET, qmp->com + QPHY_V3_DP_COM_SW_RESET);
+	writel(SW_RESET, qmp->pcs + qmp->cfg->regs[QPHY_SW_RESET]);
+
+	/* First record preserves the DP tunnel clock bit; retain all other order. */
+	writel(table[0].val | tunnel_clock, qmp->com + table[0].offset);
+	qmp_configure(qmp->dev, qmp->com, table + 1, count - 1);
+
+	/* Surface RXEQ board methods override the same register on both lanes. */
+	writel(qmp->usb4_rx_eq, qmp->tx + QSERDES_V8_LALB_RX_MODE_RATE3_B4);
+	writel(qmp->usb4_rx_eq, qmp->tx2 + QSERDES_V8_LALB_RX_MODE_RATE3_B4);
+
+	/* Captured Surface PHYC packages are empty: no extra board writes apply. */
+	writel(0, qmp->com + QPHY_V3_DP_COM_SW_RESET);
+	writel(0, qmp->usb4_pcs + qmp->cfg->regs[QPHY_SW_RESET]);
+	writel(SERDES_START | PCS_START,
+	       qmp->usb4_pcs + qmp->cfg->regs[QPHY_START_CTRL]);
+	usleep_range(1000, 1100);
+
+	ret = qmp_v8_usb4_wait_ready(qmp);
+	if (ret)
+		return ret;
+
+	/* A failed calibration is reported; no router rate override is applied. */
+	return qmp_v8_usb4_calibrate(qmp);
+}
