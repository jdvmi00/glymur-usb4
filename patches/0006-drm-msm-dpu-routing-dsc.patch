+static bool dpu_crtc_quad_dsc_supported(const struct dpu_kms *dpu_kms)
+{
+	return dpu_use_virtual_planes &&
+	       dpu_kms->catalog->mdss_ver->core_major_ver >= 9 &&
+	       dpu_kms->catalog->caps->has_3d_merge &&
+	       dpu_kms->catalog->dsc_count >= 4;
