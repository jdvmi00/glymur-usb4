+static int dwc3_qcom_pre_host_init(struct dwc3 *dwc)
+{
+	struct dwc3_qcom *qcom = to_dwc3_qcom(dwc);
+	int i, ret;
+
+	/* Preserve the firmware trigger policy for initial host startup. */
+	if (!READ_ONCE(qcom->host_init_seen)) {
+		WRITE_ONCE(qcom->host_init_seen, true);
+		return 0;
+	}
+
+	/* Preserve firmware IRQ types until probe can no longer defer. */
+	if (!READ_ONCE(qcom->probe_completed))
+		return 0;
+
+	/*
+	 * Changing a PDC trigger can clear a pending connection event. Select
+	 * the disconnected-port polarity before the new host starts, while
+	 * xHCI will still be able to observe any already-connected device.
+	 * Wake IRQs remain disabled until the controller suspends.
+	 */
+	for (i = 0; i < qcom->num_ports; i++) {
+		ret = dwc3_qcom_prepare_connect_irq(qcom, qcom->ports[i].dp_hs_phy_irq);
+		if (ret)
