diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index 608daeb7ef1041fbafb03233b2ec4e595ee4945a..81691e6dc0bfbfd7274dad7c0a395d82b9993e01 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -140,6 +140,9 @@
 #define DWC3_GUSB2PHYACC(n)	(0xc280 + ((n) * 0x04))
 
 #define DWC3_GUSB3PIPECTL(n)	(0xc2c0 + ((n) * 0x04))
+/* Converged I/O (USB4 tunneling) control, per SuperSpeed port; DWC31 191A+ */
+#define DWC3_CIOCTRL(n)		(0xcd20 + ((n) * 0x30))
+#define DWC3_CIOCTRL_CIO_EN	BIT(0)
 
 #define DWC3_GTXFIFOSIZ(n)	(0xc300 + ((n) * 0x04))
 #define DWC3_GRXFIFOSIZ(n)	(0xc380 + ((n) * 0x04))
diff --git a/drivers/usb/dwc3/host.c b/drivers/usb/dwc3/host.c
index c5674161b2b08e2130c3192831014470fea8edd8..4dd3730d5c2a37ba78a7a9cc2bed04ba201a1b83 100644
--- a/drivers/usb/dwc3/host.c
+++ b/drivers/usb/dwc3/host.c
@@ -19,6 +19,7 @@
 #include "../host/xhci-caps.h"
 #include "../host/xhci-plat.h"
 #include "core.h"
+#include "io.h"
 
 #define XHCI_HCSPARAMS1		0x4
 #define XHCI_PORTSC_BASE	0x400
@@ -78,6 +79,27 @@ static void dwc3_xhci_plat_start(struct usb_hcd *hcd)
 	dwc3_enable_susphy(dwc, true);
 }
 
+/*
+ * A SuperSpeed port whose CIO block is enabled carries a USB3 link tunneled
+ * over USB4 (the USB4 router owns the wire). The register block exists on
+ * CIO-capable DWC31 cores only; the "usb4-host-interface" property marks
+ * controllers whose ports can be tunneled.
+ */
+static enum usb_link_tunnel_mode dwc3_xhci_tunnel_mode(struct usb_hcd *hcd,
+						       unsigned int port)
+{
+	struct platform_device *pdev = to_platform_device(hcd->self.controller);
+	struct dwc3 *dwc = dev_get_drvdata(pdev->dev.parent);
+	u32 reg;
+
+	/* The CIO block exists on DWC31 cores only (191A and later). */
+	if (!DWC3_IP_IS(DWC31) || DWC3_VER_IS_PRIOR(DWC31, 190A))
+		return USB_LINK_UNKNOWN;
+
+	reg = dwc3_readl(dwc, DWC3_CIOCTRL(port));
+	return (reg & DWC3_CIOCTRL_CIO_EN) ? USB_LINK_TUNNELED : USB_LINK_NATIVE;
+}
+
 static const struct xhci_plat_priv dwc3_xhci_plat_quirk = {
 	.plat_start = dwc3_xhci_plat_start,
 };
@@ -130,6 +152,7 @@ out:
 
 int dwc3_host_init(struct dwc3 *dwc)
 {
+	struct xhci_plat_priv	xhci_priv = dwc3_xhci_plat_quirk;
 	struct property_entry	props[6];
 	struct platform_device	*xhci;
 	int			ret, irq;
@@ -197,7 +220,18 @@ int dwc3_host_init(struct dwc3 *dwc)
 		}
 	}
 
-	ret = platform_device_add_data(xhci, &dwc3_xhci_plat_quirk,
+	if (device_property_present(dwc->dev, "usb4-host-interface")) {
+		/*
+		 * Bring-up policy: USB3 LPM (U1/U2) and port suspend over the
+		 * USB4 tunnel stall transfers on this host; keep tunneled links
+		 * in U0 until the tunnel-side power management is understood.
+		 */
+		xhci_priv = dwc3_xhci_plat_quirk;
+		xhci_priv.tunnel_mode = dwc3_xhci_tunnel_mode;
+		xhci_priv.tunneled_no_lpm = true;
+	}
+
+	ret = platform_device_add_data(xhci, &xhci_priv,
 				       sizeof(struct xhci_plat_priv));
 	if (ret)
 		goto err;
