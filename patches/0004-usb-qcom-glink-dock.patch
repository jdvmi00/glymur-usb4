Subject: [REVIEW 04/09] Qualcomm Type-C messaging and USB host behavior

Validate USB4 mode messages and coordinate Type-C/PHY requests. Carry the recorded DWC3, xHCI and hub behavior used by the tested dock setup. Review the scope of quirks and impact on other USB hosts.

Dependencies: Base prerequisites; this patch references no symbols from patch 01. The validated USB4 mode messages are consumed by the Type-C handling in patch 05, which drives the PHY from patch 01.

Source attribution: Local Surface integration; provenance/usb4/08-pmic-glink-tbt-payload.diff and 09-pmic-glink-usb4-validation.diff; USB host/hub changes recorded in provenance/derivation.json.

This is a review grouping of preserved source, not a new authorship claim or
an independently build-validated upstream commit. Original attribution remains
in the referenced provenance files. No new Signed-off-by trailers are added.

---
diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index 13c434f8d03a645548918b064ed79b81882f4497..390bc6e58d4c32e5bc5b02c4f7acaaf66cce005f 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -32,6 +32,20 @@
 #define ALTMODE_PAN_EN		0x10
 #define ALTMODE_PAN_ACK		0x11
 
+/*
+ * PAN_EN argument as sent by the Windows PMIC GLINK driver (qcpmicglink8480,
+ * PlatformConfig defaults): bits 0-2 carry UsbcPinAssignmentVersion (1 = "V2"),
+ * bits 3-6 an environment field (1 on an installed system, 2 under WinPE).
+ * With the legacy argument 0 the Surface Laptop 8 firmware never reports the
+ * tunneling mux state, so USB4 is never negotiated.
+ */
+#define ALTMODE_PAN_EN_V2_ARG	(1 | (1 << 3))
+
+static int pan_en_arg = -1;
+module_param(pan_en_arg, int, 0644);
+MODULE_PARM_DESC(pan_en_arg,
+		 "PAN_EN argument override (-1: per-SoC default, 0: legacy, 9: V2 as Windows)");
+
 struct usbc_write_req {
 	struct pmic_glink_hdr   hdr;
 	__le32 cmd;
@@ -129,6 +143,7 @@ struct pmic_glink_altmode {
 	struct device *dev;
 
 	unsigned int owner_id;
+	u32 pan_en_default;
 
 	/* To synchronize WRITE_REQ acks */
 	struct mutex lock;
@@ -211,9 +226,25 @@ static void pmic_glink_altmode_enable_tbt(struct pmic_glink_altmode *altmode,
 {
 	struct usbc_sc8280x_tbt_data *tbt = &port->tbt_data;
 	struct typec_thunderbolt_data tbt_data = {};
-	u32 cable_speed;
+	u32 cable_speed, cable_flags = 0;
 	int ret;
 
+	/* PAN cable types use the same encoding as Enter_USB. */
+	switch (tbt->cable_type) {
+	case EUDO_CABLE_TYPE_PASSIVE:
+	case EUDO_CABLE_TYPE_RE_DRIVER:
+		break;
+	case EUDO_CABLE_TYPE_RE_TIMER:
+		cable_flags = TBT_CABLE_RETIMER;
+		break;
+	case EUDO_CABLE_TYPE_OPTICAL:
+		cable_flags = TBT_CABLE_OPTICAL;
+		break;
+	default:
+		dev_err(altmode->dev, "Invalid TBT3 cable type: %u\n", tbt->cable_type);
+		return;
+	}
+
 	/* Device Discover Mode VDO */
 	tbt_data.device_mode = TBT_MODE;
 	tbt_data.device_mode |= TBT_SET_ADAPTER(TBT_ADAPTER_TBT3);
@@ -226,15 +257,13 @@ static void pmic_glink_altmode_enable_tbt(struct pmic_glink_altmode *altmode,
 	} else if (tbt->usb_speed == 1) {
 		cable_speed = TBT_CABLE_10_AND_20GBPS;
 	} else {
-		dev_err(altmode->dev,
-			"Got illegal TBT3 cable speed value (%u), falling back to passive\n",
-			tbt->usb_speed);
-		cable_speed = TBT_CABLE_USB3_PASSIVE;
+		dev_err(altmode->dev, "Invalid TBT3 cable speed: %u\n", tbt->usb_speed);
+		return;
 	}
 	tbt_data.cable_mode |= TBT_SET_CABLE_SPEED(cable_speed);
 
-	if (tbt->cable_type) {
-		tbt_data.cable_mode |= TBT_CABLE_ACTIVE_PASSIVE;
+	if (tbt->cable_type != EUDO_CABLE_TYPE_PASSIVE) {
+		tbt_data.cable_mode |= TBT_CABLE_ACTIVE_PASSIVE | cable_flags;
 		tbt_data.cable_mode |= TBT_SET_CABLE_ROUNDED(tbt->rounded_cable);
 	}
 
@@ -242,8 +271,8 @@ static void pmic_glink_altmode_enable_tbt(struct pmic_glink_altmode *altmode,
 	tbt_data.enter_vdo |= TBT_MODE;
 	tbt_data.enter_vdo |= TBT_ENTER_MODE_CABLE_SPEED(cable_speed);
 
-	if (tbt->cable_type) {
-		tbt_data.enter_vdo |= TBT_CABLE_ACTIVE_PASSIVE;
+	if (tbt->cable_type != EUDO_CABLE_TYPE_PASSIVE) {
+		tbt_data.enter_vdo |= TBT_ENTER_MODE_ACTIVE_CABLE | cable_flags;
 		tbt_data.enter_vdo |= TBT_SET_CABLE_ROUNDED(tbt->rounded_cable);
 	}
 
@@ -278,9 +307,13 @@ static void pmic_glink_altmode_enable_usb4(struct pmic_glink_altmode *altmode,
 	} else if (tbt->usb_speed == 1) {
 		data.eudo |= FIELD_PREP(EUDO_CABLE_SPEED_MASK, EUDO_CABLE_SPEED_USB4_GEN3);
 	} else {
-		pr_err("Got illegal USB4 cable speed value (%u), falling back to G2\n",
-		       tbt->usb_speed);
-		data.eudo |= FIELD_PREP(EUDO_CABLE_SPEED_MASK, EUDO_CABLE_SPEED_USB4_GEN2);
+		dev_err(altmode->dev, "Invalid USB4 cable speed: %u\n", tbt->usb_speed);
+		return;
+	}
+
+	if (tbt->cable_type > EUDO_CABLE_TYPE_OPTICAL) {
+		dev_err(altmode->dev, "Invalid USB4 cable type: %u\n", tbt->cable_type);
+		return;
 	}
 
 	data.eudo |= FIELD_PREP(EUDO_CABLE_TYPE_MASK, tbt->cable_type);
@@ -465,7 +498,7 @@ static void pmic_glink_altmode_sc8280xp_notify(struct pmic_glink_altmode *altmod
 	const struct usbc_sc8280x_tbt_data *tbt;
 	const struct usbc_sc8280x_dp_data *dp;
 	const struct usbc_notify *notify;
-	u8 orientation;
+	u8 orientation, version, mux_ctrl, reset;
 	u8 port;
 
 	if (len != sizeof(*notify)) {
@@ -477,7 +510,22 @@ static void pmic_glink_altmode_sc8280xp_notify(struct pmic_glink_altmode *altmod
 	notify = data;
 
 	port = notify->port_idx;
-	orientation = notify->orientation;
+	/*
+	 * V2 pin-assignment notifications (PAN_EN argument with version 1) pack
+	 * a protocol version into bits 5-7 of the orientation byte and a reset
+	 * request into bits 5-7 of the mux byte; the DSDT's PBUF layout (BORI,
+	 * BVER, BMUX, BRST) documents the fields. Mask them off so a V2 message
+	 * does not read as an unknown orientation.
+	 */
+	orientation = notify->orientation & 0x3;
+	version = notify->orientation >> 5;
+	mux_ctrl = notify->mux_ctrl & 0xf;
+	reset = notify->mux_ctrl >> 5;
+
+	dev_info(altmode->dev,
+		 "PAN port %u orientation %u version %u mux %u reset %u vid %#x svid %#x ext %*ph\n",
+		 port, orientation, version, mux_ctrl, reset, le16_to_cpu(notify->vid),
+		 svid, (int)sizeof(notify->extended_data), &notify->extended_data);
 
 	if (port >= ARRAY_SIZE(altmode->ports) || !altmode->ports[port].altmode) {
 		dev_dbg(altmode->dev, "notification on undefined port %d\n", port);
@@ -487,7 +535,7 @@ static void pmic_glink_altmode_sc8280xp_notify(struct pmic_glink_altmode *altmod
 	alt_port = &altmode->ports[port];
 	alt_port->orientation = pmic_glink_altmode_orientation(orientation);
 	alt_port->svid = svid;
-	alt_port->mux_ctrl = notify->mux_ctrl;
+	alt_port->mux_ctrl = mux_ctrl;
 
 	if (svid == USB_TYPEC_DP_SID) {
 		dp = &notify->extended_data.dp;
@@ -548,7 +596,10 @@ static void pmic_glink_altmode_enable_worker(struct work_struct *work)
 	struct pmic_glink_altmode *altmode = work_to_altmode(work);
 	int ret;
 
-	ret = pmic_glink_altmode_request(altmode, ALTMODE_PAN_EN, 0);
+	u32 arg = pan_en_arg >= 0 ? pan_en_arg : altmode->pan_en_default;
+
+	dev_info(altmode->dev, "enabling pin-assignment notifications, PAN_EN arg %#x\n", arg);
+	ret = pmic_glink_altmode_request(altmode, ALTMODE_PAN_EN, arg);
 	if (ret)
 		dev_err(altmode->dev, "failed to request altmode notifications: %d\n", ret);
 }
@@ -589,6 +640,9 @@ static int pmic_glink_altmode_probe(struct auxiliary_device *adev,
 	else
 		altmode->owner_id = PMIC_GLINK_OWNER_USBC_PAN;
 
+	if (of_device_is_compatible(dev->parent->of_node, "qcom,glymur-pmic-glink"))
+		altmode->pan_en_default = ALTMODE_PAN_EN_V2_ARG;
+
 	INIT_WORK(&altmode->enable_work, pmic_glink_altmode_enable_worker);
 	init_completion(&altmode->pan_ack);
 	mutex_init(&altmode->lock);
