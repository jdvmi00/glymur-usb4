+static int dwc3_qcom_prepare_connect_irq(struct dwc3_qcom *qcom, int irq)
+{
+	int ret;
+
+	if (!irq)
+		return 0;
+
+	ret = irq_set_irq_type(irq, IRQ_TYPE_EDGE_RISING);
