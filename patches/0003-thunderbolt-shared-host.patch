+/**
+ * nhi_remove() - Remove a successfully probed host interface
+ * @nhi: Host interface to remove
+ *
+ * Drain the domain before shutting down the host interface. The caller must
+ * keep the device and its resources available until this function returns.
+ * Bus-specific shutdown policy, such as forcing host_reset, belongs to the
+ * caller. This is not the cleanup path for a failed nhi_probe().
+ */
+void nhi_remove(struct tb_nhi *nhi)
+{
+	struct device *dev = nhi->dev;
+	struct tb *tb = dev_get_drvdata(dev);
+
+	pm_runtime_get_sync(dev);
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_forbid(dev);
+
+	tb_domain_remove(tb);
+	wait_for_completion(&nhi->domain_released);
+	nhi_shutdown(nhi);
+}
