+/**
+ * nhi_handle_interrupt() - Dispatch one captured interrupt cause
+ * @nhi: NHI that reported the cause
+ * @cause: Bit index in the TX, RX and RX overflow status fields
+ *
+ * The caller must hold @nhi->lock. This does not read or acknowledge the
+ * interrupt status. Polling rings retain their normal interrupt masking.
+ *
+ * Return: %true if a transport that masked the captured cause may reenable it.
+ * The caller must keep @nhi->lock held until it consumes this result. Stopped,
+ * polling and interrupt-disabled rings are not rearmed, nor is an NHI that is
+ * going away. This result does not change the normal notification behavior.
+ */
+bool nhi_handle_interrupt(struct tb_nhi *nhi, unsigned int cause)
+{
+	struct tb_ring *ring;
+	int hop, type;
+	bool rearm;
+
+	lockdep_assert_held(&nhi->lock);
+	if (WARN_ON_ONCE(cause >= 3 * nhi->hop_count))
+		return false;
+
+	type = cause / nhi->hop_count;
+	hop = cause % nhi->hop_count;
+	if (type == 2) {
+		dev_warn(nhi->dev, "RX overflow for ring %d\n", hop);
+		return false;
+	}
+	if (type == 0)
+		ring = nhi->tx_rings[hop];
+	else
+		ring = nhi->rx_rings[hop];
+	if (ring == NULL) {
+		dev_warn(nhi->dev,
+			 "got interrupt for inactive %s ring %d\n",
+			 type ? "RX" : "TX", hop);
+		return false;
+	}
+
+	spin_lock(&ring->lock);
+	__ring_interrupt(ring);
+	rearm = ring->running && !ring->start_poll &&
+		!(ring->flags & RING_FLAG_NO_INTERRUPT) && !nhi->going_away;
+	spin_unlock(&ring->lock);
+
+	return rearm;
+}
