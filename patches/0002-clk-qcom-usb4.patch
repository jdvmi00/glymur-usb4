+/*
+ * USB4 host router startup operations. The router frontend cannot express
+ * these through clock or reset consumers: the RX muxes must run from TCXO
+ * with their gates enabled across the router reset, the memory-force and
+ * clock-gating bits are toggled at fixed points of the firmware sequence,
+ * and the opaque control bit has no verified signal name.
+ */
+struct glymur_usb4_gcc_regs {
+	u32 ctrl;
+	u32 sys;
+	u32 pipe;
+	u32 rx_gate[2];
+	u32 rx_mux[2];
+};
+
+static const struct glymur_usb4_gcc_regs glymur_usb4_gcc_regs[] = {
+	[0] = {
+		.ctrl = 0x600c0,
+		.sys = 0x2b05c,
+		.pipe = 0x2b0bc,
+		.rx_gate = { 0x2b0c4, 0x2b0d8 },
+		.rx_mux = { 0x2b0c0, 0x2b0d4 },
+	},
+	[1] = {
+		.ctrl = 0x600ac,
+		.sys = 0x2d05c,
+		.pipe = 0x2d0e0,
+		.rx_gate = { 0x2d0e8, 0x2d0fc },
+		.rx_mux = { 0x2d0e4, 0x2d0f8 },
+	},
+};
+
+#define GLYMUR_USB4_RX_MUX_MASK		GENMASK(1, 0)
+#define GLYMUR_USB4_RX_MUX_PHY		0
+#define GLYMUR_USB4_RX_MUX_TCXO		2
+#define GLYMUR_USB4_CTRL_BIT		BIT(3)
+#define GLYMUR_USB4_PIPE_HWCG_BIT	BIT(1)
+
+static struct regmap *glymur_gcc_regmap;
+
+static const struct glymur_usb4_gcc_regs *glymur_usb4_regs(unsigned int port)
+{
+	if (!glymur_gcc_regmap || port >= ARRAY_SIZE(glymur_usb4_gcc_regs))
+		return NULL;
+	return &glymur_usb4_gcc_regs[port];
+}
+
+int glymur_gcc_usb4_rx_select(unsigned int port, bool phy)
+{
+	const struct glymur_usb4_gcc_regs *r = glymur_usb4_regs(port);
+	u32 want = phy ? GLYMUR_USB4_RX_MUX_PHY : GLYMUR_USB4_RX_MUX_TCXO;
+	u32 cur[2];
+	int i, ret;
+
+	if (!r)
+		return -ENODEV;
+	for (i = 0; i < 2; i++) {
+		ret = regmap_read(glymur_gcc_regmap, r->rx_mux[i], &cur[i]);
+		if (ret)
+			return ret;
+	}
+	if ((cur[0] & GLYMUR_USB4_RX_MUX_MASK) == want &&
+	    (cur[1] & GLYMUR_USB4_RX_MUX_MASK) == want)
+		return 0;
+	for (i = 0; i < 2; i++) {
+		ret = regmap_update_bits(glymur_gcc_regmap, r->rx_gate[i], BIT(0), 0);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < 2; i++) {
+		ret = regmap_update_bits(glymur_gcc_regmap, r->rx_mux[i],
+					 GLYMUR_USB4_RX_MUX_MASK, want);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < 2; i++) {
+		ret = regmap_update_bits(glymur_gcc_regmap, r->rx_gate[i], BIT(0), BIT(0));
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(glymur_gcc_usb4_rx_select);
+
+int glymur_gcc_usb4_ctrl_bit(unsigned int port, bool set)
+{
+	const struct glymur_usb4_gcc_regs *r = glymur_usb4_regs(port);
+
+	if (!r)
+		return -ENODEV;
+	return regmap_update_bits(glymur_gcc_regmap, r->ctrl, GLYMUR_USB4_CTRL_BIT,
+				  set ? GLYMUR_USB4_CTRL_BIT : 0);
+}
+EXPORT_SYMBOL_GPL(glymur_gcc_usb4_ctrl_bit);
+
+int glymur_gcc_usb4_sys_force_mem(unsigned int port, bool on)
+{
+	const struct glymur_usb4_gcc_regs *r = glymur_usb4_regs(port);
+
+	if (!r)
