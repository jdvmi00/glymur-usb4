@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Glymur GCC operations required by the USB4 host router startup sequence.
+ *
+ * These registers belong to the global clock controller but are not ordinary
+ * clock enables: the recovered router startup toggles them at fixed points
+ * between resets, firmware upload and PHY initialization. They are exposed as
+ * narrow checked operations owned by the GCC driver, not as fake clocks or
+ * resets. Only the port table entries verified on the Surface Laptop 8 are
+ * populated.
+ */
+#ifndef __LINUX_SOC_QCOM_GLYMUR_USB4_H
+#define __LINUX_SOC_QCOM_GLYMUR_USB4_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+#if IS_ENABLED(CONFIG_CLK_GLYMUR_GCC)
+/* Switch both RX clock muxes: gates off, selectors to PHY (true) or TCXO, gates on. */
+int glymur_gcc_usb4_rx_select(unsigned int port, bool phy);
+/* Opaque control bit 3 (GCC 0x600c0 for port 0) pulsed around router 0x81018. */
+int glymur_gcc_usb4_ctrl_bit(unsigned int port, bool set);
+/* CBCR_FORCE_MEM_CORE_ON on the router SYS branch, after firmware upload. */
+int glymur_gcc_usb4_sys_force_mem(unsigned int port, bool on);
+/* Hardware clock gating bit of the USB PIPE branch. */
+int glymur_gcc_usb4_pipe_hwcg(unsigned int port, bool enable);
+/* Poll the SYS branch CLK_OFF status clear after reset deassert. */
+int glymur_gcc_usb4_sys_ready(unsigned int port, unsigned int timeout_us);
+#else
+static inline int glymur_gcc_usb4_rx_select(unsigned int port, bool phy)
+{
+	return -ENODEV;
+}
+static inline int glymur_gcc_usb4_ctrl_bit(unsigned int port, bool set)
+{
+	return -ENODEV;
+}
+static inline int glymur_gcc_usb4_sys_force_mem(unsigned int port, bool on)
+{
+	return -ENODEV;
+}
+static inline int glymur_gcc_usb4_pipe_hwcg(unsigned int port, bool enable)
+{
+	return -ENODEV;
+}
+static inline int glymur_gcc_usb4_sys_ready(unsigned int port,
+					    unsigned int timeout_us)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif
