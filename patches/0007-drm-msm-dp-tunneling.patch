+void msm_dp_panel_dsc_link_disable(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, 0);
+}
+
+/**
+ * msm_dp_panel_dsc_config - program or clear the compressed stream setup
+ * @msm_dp_panel: DP panel
+ * @enable: program the current mode's DSC parameters, or clear them
+ *
+ * Programs the pixel data throttle, the PPS packet and the compression
+ * control for the mode selected by msm_dp_panel_init_panel_info(); with
+ * @enable false or an uncompressed mode, the stream runs uncompressed.
+ */
+void msm_dp_panel_dsc_config(struct msm_dp_panel *msm_dp_panel, bool enable)
+{
+	struct msm_dp_panel_private *panel;
+	struct msm_dp_display_mode *mode = &msm_dp_panel->msm_dp_mode;
+	const struct msm_dp_dsc_params *params = &mode->dsc_params;
+	u32 reg, compression;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	if (!enable || !mode->dsc_en) {
+		msm_dp_write_p0(panel, MMSS_DP_DSC_DTO_COUNT, 0);
+		msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, 0);
+		msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, 0);
+		return;
+	}
+
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO_COUNT, params->pclk_per_line);
+	reg = DP_DSC_DTO_EN | DP_DSC_DTO_ENABLE_HW_ACK |
+	      params->dto_n << DP_DSC_DTO_NUM_SHIFT |
+	      params->dto_d << DP_DSC_DTO_DENOM_SHIFT;
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, reg);
+
+	msm_dp_panel_dsc_write_pps(panel, &mode->dsc);
+
+	compression = DP_COMPRESSION_MODE_CTRL_EN |
+	      params->eol_byte_num << DP_COMPRESSION_MODE_CTRL_EOL_BYTE_NUM_SHIFT |
+	      (params->slice_per_pkt - 1) << DP_COMPRESSION_MODE_CTRL_SLICE_PER_PKT_SHIFT |
+	      (dp_dsc_be_in_lane & 0xf) << DP_COMPRESSION_MODE_CTRL_BE_IN_LANE_SHIFT |
+	      (dp_dsc_bytes_total ? params->bytes_per_pkt * params->slice_per_pkt : params->bytes_per_pkt)
+		<< DP_COMPRESSION_MODE_CTRL_BYTES_PER_PKT_SHIFT;
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, compression);
+
+	/* send the PPS with every frame */
+	reg = msm_dp_read_link(panel, MMSS_DP_FLUSH);
+	if (dp_dsc_pps_oneshot)
+		reg |= DP_FLUSH_PPS_ONESHOT;
+	else
+		reg &= ~DP_FLUSH_PPS_ONESHOT;
+	reg |= DP_FLUSH_PPS;
+	msm_dp_write_link(panel, MMSS_DP_FLUSH, reg);
+
+	if (dp_dsc_sdp_update) {
+		msm_dp_write_link(panel, MMSS_DP_SDP_CFG3, UPDATE_SDP);
+		msm_dp_write_link(panel, MMSS_DP_SDP_CFG3, 0x0);
+	} else {
+		msm_dp_panel_update_sdp(panel);
+	}
+
+	drm_dbg_dp(panel->drm_dev, "dsc: dto=0x%x count=%u compression=0x%x flush=0x%x\n",
+		   (u32)(DP_DSC_DTO_EN | DP_DSC_DTO_ENABLE_HW_ACK |
+			 params->dto_n << DP_DSC_DTO_NUM_SHIFT |
+			 params->dto_d << DP_DSC_DTO_DENOM_SHIFT),
+		   params->pclk_per_line, compression, reg);
+}
