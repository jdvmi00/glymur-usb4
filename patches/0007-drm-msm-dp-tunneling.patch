+	if (!msm_dp)
+		return -ENODEV;
+	dp = container_of(msm_dp, struct msm_dp_display_private, msm_dp_display);
+	if (sscanf(buf, "%7s %u %u %u", op, &rate, &lanes, &resource) < 1)
+		return -EINVAL;
+	if (lanes < 1 || lanes > 4 || resource > MSM_DP_USB4_DPIN_MUX_MASK)
+		return -EINVAL;
+
+	mux = ioremap(MSM_DP_USB4_DPIN_MUX_PA, 4);
+	if (!mux)
+		return -ENOMEM;
