+		dev_info(dev, "USB4 tunnel on: DP IN mux %08x -> %08x\n", val, readl(mux));
+	} else if (!strcmp(op, "off")) {
+		val = readl(mux);
+		writel(val & ~MSM_DP_USB4_DPIN_MUX_MASK, mux);
+		ret = msm_dp_ctrl_usb4_tunnel_prepare(dp->ctrl, false, 0, 0);
+		pm_runtime_put_sync(dev);
+		dp->usb4_manual_on = false;
+		dev_info(dev, "USB4 tunnel off: DP IN mux %08x -> %08x, ret %d\n", val,
+			 readl(mux), ret);
+	} else if (!strcmp(op, "mux")) {
+		dev_info(dev, "DP IN mux %08x\n", readl(mux));
+		ret = 0;
+	} else if (!strcmp(op, "link")) {
+		ret = msm_dp_ctrl_usb4_tunnel_link(dp->ctrl, true);
+	} else if (!strcmp(op, "unlink")) {
+		ret = msm_dp_ctrl_usb4_tunnel_link(dp->ctrl, false);
+	} else {
+		ret = -EINVAL;
+	}
