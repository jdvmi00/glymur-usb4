+		msm_dp_write_link(ctrl, 0x73c, 0x0100fefd);
+		msm_dp_write_link(ctrl, 0x740, 0x55555555);
+		msm_dp_write_link(ctrl, 0x744, 0x55555555);
+		msm_dp_write_link(ctrl, 0x748, 0x55555555);
+		msm_dp_write_link(ctrl, 0x74c, 0xffffff55);
+		msm_dp_write_link(ctrl, 0x750, 0xffffffff);
+		msm_dp_write_link(ctrl, 0x754, 0xffffffff);
+		msm_dp_write_link(ctrl, 0x758, 0x009cffff);
+		msm_dp_write_link(ctrl, REG_DP_CONFIGURATION_CTRL,
+			msm_dp_read_link(ctrl, REG_DP_CONFIGURATION_CTRL) | BIT(16));
+		mainlink_ctrl &= ~DP_MAINLINK_CTRL_FEC_SEQ_MODE;
+		mainlink_ctrl |= DP_MAINLINK_CTRL_FEC_EN;
+	} else if (enable)
+		mainlink_ctrl |= DP_MAINLINK_CTRL_FEC_EN |
+				 DP_MAINLINK_CTRL_FEC_SEQ_MODE |
+				 DP_MAINLINK_FLUSH_MODE_SDE_PERIPH_UPDATE |
+				 DP_MAINLINK_FB_BOUNDARY_SEL;
+	else
+		mainlink_ctrl &= ~DP_MAINLINK_CTRL_FEC_EN;
+
+	msm_dp_write_link(ctrl, REG_DP_MAINLINK_CTRL, mainlink_ctrl);
+	if (msm_dp_aux_usb4_attached(ctrl->aux))
+		dev_info(ctrl->dev, "USB4 FEC symbols: enable=%d mainlink=%#x config=%#x first=%#x last=%#x\n",
+			 enable, msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL),
+			 msm_dp_read_link(ctrl, REG_DP_CONFIGURATION_CTRL),
+			 msm_dp_read_link(ctrl, 0x73c), msm_dp_read_link(ctrl, 0x758));
