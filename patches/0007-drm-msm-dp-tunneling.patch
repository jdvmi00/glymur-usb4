+/* Candidate-only handoff: Type-C USB4 negotiation is not a display event. */
+static void msm_dp_usb4_hpd_work(struct work_struct *work)
+{
+	struct msm_dp_display_private *dp =
+		container_of(work, struct msm_dp_display_private, usb4_hpd_work);
+	bool connected, irq;
+	int ret = 0;
+
+	mutex_lock(&dp->usb4_lock);
+	if (!dp->usb4_bound || !dp->usb4_attached || !dp->msm_dp_display.connector) {
+		mutex_unlock(&dp->usb4_lock);
+		return;
+	}
+	connected = dp->usb4_connected;
+	irq = dp->usb4_irq;
+	dp->usb4_irq = false;
+	mutex_unlock(&dp->usb4_lock);
+
+	/* Never block the host's mailbox worker behind a modeset or AUX I/O. */
+	msm_dp_aux_usb4_set_hpd(dp->aux, connected);
+	if (connected) {
+		if (!dp->plugged)
+			ret = msm_dp_hpd_plug_handle(dp);
+		else if (irq)
+			ret = msm_dp_irq_hpd_handle(dp);
+	} else {
+		ret = msm_dp_hpd_unplug_handle(dp);
+	}
+	if (ret)
+		dev_err(&dp->msm_dp_display.pdev->dev,
+			"USB4 display event failed: %d\n", ret);
+	if (dp->drm_dev)
+		drm_kms_helper_hotplug_event(dp->drm_dev);
+}
+
+static int msm_dp_usb4_attach_locked(struct device *dev, struct drm_dp_aux *aux,
+		      const struct msm_dp_usb4_ops *ops, void *data)
+{
+	struct msm_dp_display_private *dp;
+	int ret;
+
+	if (!dev || !aux || !aux->transfer || !ops || !ops->configure_link)
+		return -ENODEV;
+	if (!dev_get_drvdata(dev))
+		return -EPROBE_DEFER;
+	dp = dev_get_dp_display_private(dev);
+	if (dp->id != MSM_DP_CONTROLLER_0 || dp->msm_dp_display.is_edp)
+		return -ENODEV;
+	if (!dp->msm_dp_display.connector || !dp->drm_dev || !dp->drm_dev->registered)
+		return -EPROBE_DEFER;
+	mutex_lock(&dp->usb4_lock);
+	if (!dp->usb4_bound || !dp->drm_dev) {
+		ret = -EPROBE_DEFER;
+		goto out;
+	}
+	if (dp->usb4_attached || dp->usb4_manual_on || dp->plugged || dp->link_pm_ref) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = msm_dp_aux_usb4_set(dp->aux, aux, ops, data);
+	if (!ret) {
+		dp->usb4_attached = true;
+		dp->usb4_connected = false;
+		dp->usb4_irq = false;
+	}
+out:
+	mutex_unlock(&dp->usb4_lock);
+	return ret;
+}
+
+int msm_dp_usb4_attach(struct device *dev, struct drm_dp_aux *aux,
+		      const struct msm_dp_usb4_ops *ops, void *data)
+{
+	int ret;
+
+	if (!dev)
+		return -ENODEV;
+	device_lock(dev);
+	ret = msm_dp_usb4_attach_locked(dev, aux, ops, data);
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(msm_dp_usb4_attach);
