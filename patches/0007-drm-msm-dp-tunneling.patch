+/* Stop reporting HPD before release. DRM owns active-stream teardown. */
+static int msm_dp_usb4_hpd_sync_locked(struct device *dev, bool connected, bool irq)
+{
+	struct msm_dp_display_private *dp;
+	int ret;
+
+	dev_info(dev, "USB4 HPD sync: enter connected=%d\n", connected);
+	ret = msm_dp_usb4_hpd_locked(dev, connected, irq);
+	if (ret)
+		return ret;
+	dp = dev_get_dp_display_private(dev);
+	dev_info(dev, "USB4 HPD sync: flush enter\n");
+	flush_work(&dp->usb4_hpd_work);
+	dev_info(dev, "USB4 HPD sync: flush returned power=%d link_ref=%d phy=%d core=%d\n",
+		 dp->msm_dp_display.power_on, dp->link_pm_ref, dp->phy_initialized, dp->core_initialized);
+	if (!connected) {
+		/* Userspace completes the atomic disable after HPD. Do not report
+		 * release failure just because that commit has not run yet.
+		 */
+		if (!wait_event_timeout(dp->usb4_stop_wait,
+				!READ_ONCE(dp->msm_dp_display.power_on) &&
+				!READ_ONCE(dp->link_pm_ref), msecs_to_jiffies(1000)))
+			return -ETIMEDOUT;
+		mutex_lock(&dp->usb4_link_lock);
+		if (dp->msm_dp_display.power_on || dp->link_pm_ref) {
+			ret = -EBUSY;
+		} else if (dp->phy_initialized) {
+			/* Unplug may already have dropped its runtime-PM reference. */
+			dev_info(dev, "USB4 HPD sync: resume for PHY exit\n");
+			ret = pm_runtime_resume_and_get(dev);
+			dev_info(dev, "USB4 HPD sync: resume returned %d\n", ret);
+			if (!ret) {
+				dev_info(dev, "USB4 HPD sync: PHY exit enter\n");
+				msm_dp_display_host_phy_exit(dp);
+				dev_info(dev, "USB4 HPD sync: PHY exit returned, runtime put\n");
+				pm_runtime_put_sync(dev);
+				dev_info(dev, "USB4 HPD sync: runtime put returned\n");
+			}
+		}
+		mutex_unlock(&dp->usb4_link_lock);
+	}
+	return ret;
+}
+
+int msm_dp_usb4_hpd_sync(struct device *dev, bool connected, bool irq)
+{
+	int ret;
+
+	if (!dev)
+		return -ENODEV;
+	device_lock(dev);
+	ret = msm_dp_usb4_hpd_sync_locked(dev, connected, irq);
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(msm_dp_usb4_hpd_sync);
+
+static void msm_dp_usb4_detach_locked(struct device *dev)
+{
+	struct msm_dp_display_private *dp;
+
+	if (!dev || !dev_get_drvdata(dev))
+		return;
+	dp = dev_get_dp_display_private(dev);
+	mutex_lock(&dp->usb4_lock);
+	dp->usb4_attached = false;
+	mutex_unlock(&dp->usb4_lock);
+	cancel_work_sync(&dp->usb4_hpd_work);
+	mutex_lock(&dp->usb4_lock);
+	if (msm_dp_aux_usb4_attached(dp->aux)) {
+		msm_dp_aux_usb4_set_hpd(dp->aux, false);
+		msm_dp_hpd_unplug_handle(dp);
+		msm_dp_aux_usb4_set(dp->aux, NULL, NULL, NULL);
+		if (dp->usb4_bound && dp->drm_dev)
+			drm_kms_helper_hotplug_event(dp->drm_dev);
+	}
+	mutex_unlock(&dp->usb4_lock);
+}
+
+void msm_dp_usb4_detach(struct device *dev)
+{
+	if (!dev)
+		return;
+	device_lock(dev);
+	msm_dp_usb4_detach_locked(dev);
+	device_unlock(dev);
+}
+EXPORT_SYMBOL_GPL(msm_dp_usb4_detach);
