+	ret = msm_dp_ctrl_link_clk_enable(msm_dp_ctrl);
+	if (ret)
+		goto err_phy;
+
+	ret = clk_prepare_enable(ctrl->dpin_clk);
+	if (ret)
+		goto err_link;
+	ctrl->dpin_clk_on = true;
+
+	dev_info(ctrl->dev, "USB4 tunnel prepare: link %u kHz x%u, dpin clock %lu Hz\n",
+		 rate, lanes, clk_get_rate(ctrl->dpin_clk));
+	return 0;
