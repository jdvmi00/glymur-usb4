+	if (msm_dp_aux_usb4_attached(dp->aux)) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	if (!strcmp(op, "on")) {
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret)
+			goto out;
+		ret = msm_dp_display_host_phy_init(dp);
+		if (ret < 0) {
+			pm_runtime_put_sync(dev);
+			goto out;
+		}
+		ret = msm_dp_ctrl_usb4_tunnel_prepare(dp->ctrl, true, rate, lanes);
+		if (ret) {
