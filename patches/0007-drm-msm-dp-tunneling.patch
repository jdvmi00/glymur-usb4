+static ssize_t usb4_tunnel_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct msm_dp *msm_dp = dev_get_drvdata(dev);
+	struct msm_dp_display_private *dp;
+	unsigned int rate = 810000, lanes = 4, resource = 1;
+	void __iomem *mux;
+	char op[8];
+	u32 val;
+	int ret;
