+int msm_dp_ctrl_usb4_tunnel_prepare(struct msm_dp_ctrl *msm_dp_ctrl, bool on,
+				    u32 rate, u32 lanes)
+{
+	struct msm_dp_ctrl_private *ctrl;
+	int ret;
+
+	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
+
+	if (!on) {
