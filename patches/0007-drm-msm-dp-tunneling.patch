+			clk_disable_unprepare(ctrl->dpin_clk);
+			ctrl->dpin_clk_on = false;
+		}
+		if (ctrl->link_clks_on)
+			msm_dp_ctrl_link_clk_disable(msm_dp_ctrl);
+		phy_power_off(ctrl->phy);
+		dev_pm_opp_set_rate(ctrl->dev, 0);
+		return 0;
+	}
+
+	if (!ctrl->dpin_clk)
+		return -ENODEV;
+
+	ret = msm_dp_ctrl_core_clk_enable(msm_dp_ctrl);
+	if (ret)
+		return ret;
+
+	ctrl->link->link_params.rate = rate;
+	ctrl->link->link_params.num_lanes = lanes;
+	ctrl->phy_opts.dp.lanes = lanes;
+	ctrl->phy_opts.dp.link_rate = rate / 100;
+	ctrl->phy_opts.dp.ssc = 0;
+
+	ret = phy_configure(ctrl->phy, &ctrl->phy_opts);
+	if (ret)
+		return ret;
+	ret = phy_power_on(ctrl->phy);
+	if (ret)
