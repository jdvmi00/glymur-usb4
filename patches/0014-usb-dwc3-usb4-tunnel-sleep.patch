Subject: [REVIEW 14/16] DWC3: keep a tunnelling controller across system sleep and resume its xHCI after the router

At system suspend, a controller marked usb4-host-interface whose SuperSpeed port is in CIO (tunnel) mode keeps its core and PHYs initialized instead of exiting and re-initializing them, so the xHCI keeps its port state and USB2 devices behind a dock can resume instead of being reset. Hibernation and runtime suspend are unchanged. The xHCI that the controller creates becomes a consumer of the USB4 router (stateless device link), so the router, which restores the tunnels, resumes before the xHCI and suspends after it.

Dependencies: Patch 04 (DWC3 files, CIO register definitions) and the usb4-host-interface property from patches 08-09. Used by patch 16, which adds the matching link from the router to the controller.

Source attribution: Local Surface change (candidates 1.139 and 1.142; the 1.141 experiment first kept the core).

This is a review grouping of preserved source, not a new authorship claim or
an independently build-validated upstream commit. Original attribution remains
in the referenced provenance files. No new Signed-off-by trailers are added.

---
diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index 8a083548ac130978ac955c6e648af4aa893641c6..2e8e611a10a1b65106a4f88944d19e35c6c47ff6 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -16,6 +16,7 @@
 #include <linux/spinlock.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/suspend.h>
 #include <linux/interrupt.h>
 #include <linux/ioport.h>
 #include <linux/io.h>
@@ -2578,8 +2579,18 @@ static int dwc3_suspend_common(struct dwc3 *dwc, pm_message_t msg)
 		dwc3_core_exit(dwc);
 		break;
 	case DWC3_GCTL_PRTCAP_HOST:
+		/*
+		 * A port in USB4 tunnel (CIO) mode stays connected across
+		 * suspend through the host router: keep the core and its PHYs
+		 * initialized so the xHCI ports keep their state.
+		 */
+		dwc->keep_core_for_tunnel = !PMSG_IS_AUTO(msg) &&
+			pm_suspend_target_state != PM_SUSPEND_ON &&
+			device_property_present(dwc->dev, "usb4-host-interface") &&
+			(dwc3_readl(dwc, DWC3_CIOCTRL(0)) & DWC3_CIOCTRL_CIO_EN);
 		if (!PMSG_IS_AUTO(msg) &&
-		    (!device_may_wakeup(dwc->dev) || dwc->needs_full_reinit)) {
+		    ((!device_may_wakeup(dwc->dev) && !dwc->keep_core_for_tunnel) ||
+		     dwc->needs_full_reinit)) {
 			dwc3_core_exit(dwc);
 			break;
 		}
@@ -2643,7 +2654,8 @@ static int dwc3_resume_common(struct dwc3 *dwc, pm_message_t msg)
 		break;
 	case DWC3_GCTL_PRTCAP_HOST:
 		if (!PMSG_IS_AUTO(msg) &&
-		    (!device_may_wakeup(dwc->dev) || dwc->needs_full_reinit)) {
+		    ((!device_may_wakeup(dwc->dev) && !dwc->keep_core_for_tunnel) ||
+		     dwc->needs_full_reinit)) {
 			ret = dwc3_core_init_for_resume(dwc);
 			if (ret)
 				return ret;
diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index b14104ef8be49f6159fb224f29c2894966537313..9c4eaec10d18dd2f188f0836925369fd61bbf1cd 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1391,6 +1391,7 @@ struct dwc3 {
 	unsigned		usb2_lpm_disable:1;
 	unsigned		usb2_gadget_lpm_disable:1;
 	unsigned		needs_full_reinit:1;
+	unsigned		keep_core_for_tunnel:1;
 	unsigned		xhci_skip_phy_init:1;
 
 	unsigned		disable_scramble_quirk:1;
diff --git a/drivers/usb/dwc3/host.c b/drivers/usb/dwc3/host.c
index 8b9d81eda456676fb599fb09a7e7c9532a81e521..6d0b928bf0fae1f1b442c84b6fc513d5baed3b0a 100644
--- a/drivers/usb/dwc3/host.c
+++ b/drivers/usb/dwc3/host.c
@@ -9,6 +9,7 @@
 
 #include <linux/irq.h>
 #include <linux/of.h>
+#include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/usb.h>
 #include <linux/usb/hcd.h>
@@ -241,6 +242,23 @@ int dwc3_host_init(struct dwc3 *dwc)
 		goto err;
 	}
 
+	/*
+	 * System sleep: the USB4 host router restores the tunnels to this
+	 * controller's ports, so it must resume before the xHCI does.
+	 */
+	if (device_property_present(dwc->dev, "usb4-host-interface")) {
+		struct device_node *np = of_parse_phandle(dwc->dev->of_node,
+							  "usb4-host-interface", 0);
+		struct platform_device *router = np ? of_find_device_by_node(np) : NULL;
+
+		of_node_put(np);
+		if (router) {
+			if (!device_link_add(&xhci->dev, &router->dev, DL_FLAG_STATELESS))
+				dev_warn(dwc->dev, "USB4 router device link failed\n");
+			put_device(&router->dev);
+		}
+	}
+
 	if (dwc->sys_wakeup) {
 		/* Restore wakeup setting if switched from device */
 		device_wakeup_enable(dwc->sysdev);
