diff --git a/drivers/thunderbolt/qcom-usb4-dp-link.c b/drivers/thunderbolt/qcom-usb4-dp-link.c
new file mode 100644
index 0000000000000000000000000000000000000000..f691a42a8756285e34b48efc3bea4d49fc5fe7ce
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-dp-link.c
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Surface Laptop 8 router 0 / DP IN 0 bring-up protocol.
+ * These adapter registers are scoped to the verified Mahua instance.
+ * Capability publication follows real receiver reads; it is not a bypass
+ * of the connection manager's DPRX completion check.
+ */
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+#include <linux/printk.h>
+#include <drm/display/drm_dp_helper.h>
+
+#include "qcom-usb4-dp-link.h"
+
+#define DP_LOCAL		0x6038
+#define DP_REMOTE	0x603c
+#define DP_COMMON	0x6044
+#define DP_LOCAL_WRITE	0x84070
+#define DP_COMMON_WRITE	0x84078
+#define DP_STATUS	0x83154
+#define DP_ACK		0x83158
+
+static u32 field(u32 word, u32 mask)
+{
+	return (word & mask) >> __ffs(mask);
+}
+
+static u32 replace(u32 word, u32 mask, u32 value)
+{
+	return (word & ~mask) | ((value << __ffs(mask)) & mask);
+}
+
+static void update(void __iomem *router, unsigned int offset, u32 mask, u32 val)
+{
+	writel((readl(router + offset) & ~mask) | (val & mask), router + offset);
+}
+
+static u32 intersect(u32 local, u32 remote, u32 common)
+{
+	static const u32 masks[] = {
+		GENMASK(3, 0), GENMASK(7, 4), GENMASK(11, 8), GENMASK(14, 12),
+		BIT(15), BIT(22), BIT(24), BIT(25), BIT(26), BIT(27), BIT(29),
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(masks); i++) {
+		u32 a = field(local, masks[i]), b = field(remote, masks[i]);
+		bool maximum = masks[i] & (BIT(25) | BIT(27) | BIT(29));
+
+		common = replace(common, masks[i], maximum ? max(a, b) : min(a, b));
+	}
+	return common & ~BIT(31);
+}
+
+static int rate_index(unsigned int rate)
+{
+	switch (rate) {
+	case 162000: return 0;
+	case 270000: return 1;
+	case 540000: return 2;
+	case 810000: return 3;
+	default: return -EINVAL;
+	}
+}
+
+static u8 link_byte(u32 caps, unsigned int rate, unsigned int lanes)
+{
+	return (caps & BIT(24) ? BIT(7) : 0) |
+	       (caps & BIT(22) ? BIT(6) : 0) | BIT(4) |
+	       ((rate & 2) << 4) | (lanes << 1) | (rate & 1);
+}
+
+int qcom_usb4_dp_negotiate_caps(void __iomem *router, struct drm_dp_aux *aux,
+			      qcom_usb4_dp_control_fn control, void *ctx)
+{
+	u8 caps[DP_RECEIVER_CAP_SIZE], tx[4] = {};
+	u32 local, common, revision, lanes;
+	int rate, ret;
+
+	local = readl(router + DP_LOCAL);
+	common = intersect(local, readl(router + DP_REMOTE),
+			   readl(router + DP_COMMON));
+	writel(common, router + DP_COMMON_WRITE);
+	ret = drm_dp_dpcd_read(aux, DP_DPCD_REV, caps, sizeof(caps));
+	if (ret != sizeof(caps))
+		return ret < 0 ? ret : -EIO;
+	if (caps[DP_TRAINING_AUX_RD_INTERVAL] & DP_EXTENDED_RECEIVER_CAP_FIELD_PRESENT) {
+		ret = drm_dp_dpcd_read(aux, DP_DP13_DPCD_REV, caps, sizeof(caps));
+		if (ret != sizeof(caps))
+			return ret < 0 ? ret : -EIO;
+	}
+	if (caps[0] < 0x11 || caps[0] > 0x14)
+		return -EOPNOTSUPP;
+	revision = caps[0] - 0x11;
+	rate = rate_index(drm_dp_bw_code_to_link_rate(caps[DP_MAX_LINK_RATE]));
+	lanes = caps[DP_MAX_LANE_COUNT] & DP_MAX_LANE_COUNT_MASK;
+	if (rate < 0 || (lanes != 1 && lanes != 2 && lanes != 4))
+		return -EOPNOTSUPP;
+	lanes = __ffs(lanes);
+	common = replace(common, GENMASK(7, 4), min(field(common, GENMASK(7, 4)), revision));
+	common = replace(common, GENMASK(11, 8), min(field(common, GENMASK(11, 8)), (u32)rate));
+	common = replace(common, GENMASK(14, 12), min(field(common, GENMASK(14, 12)), lanes));
+	if (!(caps[DP_MAX_LANE_COUNT] & DP_ENHANCED_FRAME_CAP))
+		common &= ~BIT(15);
+	if (!(caps[DP_MAX_LANE_COUNT] & DP_TPS3_SUPPORTED))
+		common &= ~BIT(22);
+	if (!(caps[DP_MAX_DOWNSPREAD] & DP_TPS4_SUPPORTED))
+		common &= ~BIT(24);
+	writel(common, router + DP_COMMON_WRITE);
+
+	/* Tell the far adapter the receiver revision. This has TX completion only. */
+	tx[0] = revision;
+	tx[1] = 0x13;
+	tx[2] = link_byte(common, field(common, GENMASK(11, 8)),
+			  1U << field(common, GENMASK(14, 12)));
+	ret = control(ctx, tx, NULL);
+	if (ret)
+		return ret;
+	writel(common | BIT(31), router + DP_COMMON_WRITE);
+	return 0;
+}
+
+int qcom_usb4_dp_configure_link(void __iomem *router,
+			       qcom_usb4_dp_dpsw_fn dpsw, void *ctx,
+			       unsigned int rate_khz, unsigned int lanes)
+{
+	u32 value, common = readl(router + DP_COMMON);
+	int rate = rate_index(rate_khz), ret;
+
+	if (rate < 0 || (lanes != 1 && lanes != 2 && lanes != 4))
+		return -EINVAL;
+	if (!(common & BIT(31)) || rate > field(common, GENMASK(11, 8)) ||
+	    lanes > (1U << field(common, GENMASK(14, 12))))
+		return -EINVAL;
+	update(router, 0x85000, BIT(0), rate < 2 ? BIT(0) : 0);
+
+	/* Native producer reset acknowledgment, after its clocks/PHY are ready. */
+	if (!(readl(router + 0x84044) & BIT(1))) {
+		writel(BIT(5), router + DP_ACK);
+		update(router, 0x84044, BIT(0), BIT(0));
+		ret = readl_poll_timeout(router + DP_STATUS, value, value & BIT(5), 100, 50000);
+		if (!ret) {
+			writel(BIT(5), router + DP_ACK);
+		} else {
+			/* Windows only pulses this reset when the first request times out. */
+			pr_warn("qcom-usb4-dp: initial reset ACK timed out (%#x), trying fallback\n", value);
+			update(router, 0x85008, BIT(0), BIT(0));
+			usleep_range(1000, 1100);
+			update(router, 0x85008, BIT(0), 0);
+			update(router, 0x84044, BIT(0), BIT(0));
+			ret = readl_poll_timeout(router + 0x84044, value,
+					 value & BIT(1), 100, 50000);
+			if (ret) {
+				pr_err("qcom-usb4-dp: fallback reset ACK timed out (%#x)\n", value);
+				return ret;
+			}
+		}
+	}
+	writel(BIT(4), router + DP_ACK);
+	ret = dpsw(ctx, 1);
+	if (ret) {
+		pr_err("qcom-usb4-dp: producer-enable command failed: %d\n", ret);
+		return ret;
+	}
+	ret = readl_poll_timeout(router + DP_STATUS, value, value & BIT(4), 100, 50000);
+	if (ret) {
+		pr_err("qcom-usb4-dp: producer-enable ACK timed out (%#x)\n", value);
+		return ret;
+	}
+	writel(BIT(4), router + DP_ACK);
+	update(router, 0x84000, GENMASK(5, 0), 0);
+	/* The scoped MSM path is SST; this bit selects MST producer framing. */
+	update(router, 0x84004, BIT(0), 0);
+	value = readl(router + 0x84008);
+	switch (rate) {
+	case 3:
+		value = (value & ~7) | 0x300;
+		writel(value, router + 0x84008);
+		usleep_range(1000, 1100);
+		value = (value & ~0x204) | 0x103;
+		break;
+	case 2: value = (value & ~0x105) | 0x202; break;
+	case 1: value = (value & ~6) | 0x301; break;
+	default: value = (value & ~7) | 0x300; break;
+	}
+	writel(value, router + 0x84008);
+	update(router, 0x84084, BIT(3), 0);
+	pr_debug("qcom-usb4-dp: producer configured at %u kHz, %u lanes\n", rate_khz, lanes);
+	return 0;
+}
+
+/* USB4 2.0 autonomous mode: autonomous DP OUT training, then clock sync. */
+int qcom_usb4_dp_train_link(void __iomem *router,
+			    qcom_usb4_dp_control_fn control, void *ctx,
+			    unsigned int rate_khz, unsigned int lanes)
+{
+	u8 tx[4] = {}, rx[4];
+	u32 value, common = readl(router + DP_COMMON);
+	int rate = rate_index(rate_khz), ret;
+
+	if (rate < 0 || (lanes != 1 && lanes != 2 && lanes != 4))
+		return -EINVAL;
+	if (!(common & BIT(31)) || rate > field(common, GENMASK(11, 8)) ||
+	    lanes > (1U << field(common, GENMASK(14, 12))))
+		return -EINVAL;
+
+	/*
+	 * Windows requests link down before startup training. With LC=LR=0
+	 * there is no training result; control() waits for control completion.
+	 */
+	tx[1] = 1;
+	tx[2] = link_byte(common, 0, 0);
+	ret = control(ctx, tx, NULL);
+	if (ret)
+		return ret;
+	/* Respect the SET_CONFIG minimum gap before the next request. */
+	usleep_range(50, 100);
+
+	/* Mode zero: the DP OUT adapter trains its physical link itself.
+	 * Its matching SET_LINK response reports completed receiver training.
+	 */
+	tx[1] = 1;
+	tx[2] = link_byte(common, rate, lanes);
+	ret = control(ctx, tx, rx);
+	if (ret)
+		return ret;
+	if (rx[1] != tx[1] || rx[0] || ((rx[2] ^ tx[2]) & 0x2f))
+		return -EREMOTEIO;
+	update(router, 0x84074, 0xf07, (rate << 8) | lanes);
+
+	/* Windows 0x1d43d8: request sync, wait for status bit 3, acknowledge. */
+	writel(BIT(3), router + DP_ACK);
+	update(router, 0x8400c, BIT(0), BIT(0));
+	ret = readl_poll_timeout(router + DP_STATUS, value, value & BIT(3), 100, 36000);
+	if (ret) {
+		pr_err("qcom-usb4-dp: clock-sync ACK timed out (%#x)\n", value);
+		return ret;
+	}
+	writel(BIT(3), router + DP_ACK);
+	pr_info("qcom-usb4-dp: receiver trained and clock sync complete at %u kHz, %u lanes\n",
+		rate_khz, lanes);
+	return 0;
+}
