+/* Resources. */
+
+static int qcom_usb4_host_get_serial(struct qcom_usb4_host *host)
+{
+	struct socinfo *info;
+	size_t size;
+
+	info = qcom_smem_get(QCOM_SMEM_HOST_ANY, SMEM_HW_SW_BUILD_ID, &size);
+	if (IS_ERR(info))
+		return dev_err_probe(host->dev, PTR_ERR(info), "SoC info unavailable\n");
+	if (offsetofend(struct socinfo, serial_num) > size)
+		return dev_err_probe(host->dev, -ENODEV, "SoC info lacks a serial number\n");
+	host->serial = le32_to_cpu(info->serial_num);
+	if (!host->serial)
+		return dev_err_probe(host->dev, -ENODEV, "SoC serial number is zero\n");
+	return 0;
+}
+
+static int qcom_usb4_host_get_resources(struct qcom_usb4_host *host)
+{
+	struct platform_device *pdev = to_platform_device(host->dev);
+	struct device *dev = host->dev;
+	struct resource *res;
+	unsigned int i;
+	int ret;
+
+	host->router = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(host->router))
+		return PTR_ERR(host->router);
+	if (resource_size(res) < QCOM_USB4_ROUTER_SIZE)
+		return dev_err_probe(dev, -EINVAL, "router window smaller than %#x\n",
+				     QCOM_USB4_ROUTER_SIZE);
+
+	host->nhi_irq = platform_get_irq_byname(pdev, "nhi");
+	if (host->nhi_irq < 0)
+		return host->nhi_irq;
+	host->mcu_irq = platform_get_irq_byname(pdev, "mcu");
+	if (host->mcu_irq < 0)
+		return host->mcu_irq;
+
+	host->num_clks = devm_clk_bulk_get_all(dev, &host->clks);
+	if (host->num_clks <= 0)
+		return dev_err_probe(dev, host->num_clks ?: -ENOENT, "no clocks\n");
+	host->clk_enabled = devm_kcalloc(dev, host->num_clks, sizeof(bool), GFP_KERNEL);
+	if (!host->clk_enabled)
+		return -ENOMEM;
+
+	host->router_reset = devm_reset_control_get_exclusive(dev, "router");
+	if (IS_ERR(host->router_reset))
+		return dev_err_probe(dev, PTR_ERR(host->router_reset), "router reset\n");
+	host->phy_reset = devm_reset_control_get_exclusive(dev, "phy");
+	if (IS_ERR(host->phy_reset))
+		return dev_err_probe(dev, PTR_ERR(host->phy_reset), "phy reset\n");
+	host->dp_reset = devm_reset_control_get_exclusive(dev, "dp");
+	if (IS_ERR(host->dp_reset))
+		return dev_err_probe(dev, PTR_ERR(host->dp_reset), "dp reset\n");
+
+	host->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(host->pinctrl))
+		return dev_err_probe(dev, PTR_ERR(host->pinctrl), "pinctrl\n");
+	for (i = 0; i < QCOM_USB4_PIN_COUNT; i++) {
+		host->pins[i] = pinctrl_lookup_state(host->pinctrl, qcom_usb4_pin_names[i]);
+		if (IS_ERR(host->pins[i]))
+			return dev_err_probe(dev, PTR_ERR(host->pins[i]),
+					     "pinctrl state %s\n", qcom_usb4_pin_names[i]);
+	}
+
+	host->tcsr = syscon_regmap_lookup_by_phandle(dev->of_node, "qcom,tcsr");
+	if (IS_ERR(host->tcsr))
+		return dev_err_probe(dev, PTR_ERR(host->tcsr), "TCSR syscon\n");
+
+	host->phy = devm_phy_get(dev, "usb4");
+	if (IS_ERR(host->phy))
+		return dev_err_probe(dev, PTR_ERR(host->phy), "USB4 PHY\n");
+
+	host->icc_ddr = devm_of_icc_get(dev, "usb4-ddr");
+	if (IS_ERR(host->icc_ddr))
+		return dev_err_probe(dev, PTR_ERR(host->icc_ddr), "usb4-ddr interconnect\n");
+	host->icc_apps = devm_of_icc_get(dev, "apps-usb4");
+	if (IS_ERR(host->icc_apps))
+		return dev_err_probe(dev, PTR_ERR(host->icc_apps), "apps-usb4 interconnect\n");
+
+	ret = qcom_usb4_host_get_serial(host);
+	if (ret)
+		return ret;
+
+	ret = qcom_usb4_mcu_init(&host->mcu, host->router, QCOM_USB4_ROUTER_SIZE,
+				 QCOM_USB4_MCU_RAM_SIZE, QCOM_USB4_MCU_LEGACY);
+	if (ret)
+		return dev_err_probe(dev, ret, "MCU layout\n");
+
+	return dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40));
+}
+
+static void qcom_usb4_host_clocks_disable(struct qcom_usb4_host *host)
+{
+	int i;
+
+	for (i = host->num_clks - 1; i >= 0; i--) {
+		if (host->clk_enabled[i]) {
+			clk_disable_unprepare(host->clks[i].clk);
+			host->clk_enabled[i] = false;
+		}
+	}
+}
+
+static void qcom_usb4_host_clocks_enable(struct qcom_usb4_host *host)
+{
+	int i, ret;
+
+	for (i = 0; i < host->num_clks; i++) {
+		ret = clk_prepare_enable(host->clks[i].clk);
+		if (ret)
+			dev_warn(host->dev, "clock %s enable failed: %d\n",
+				 host->clks[i].id ?: "?", ret);
+		else
+			host->clk_enabled[i] = true;
+	}
+}
+
+static int qcom_usb4_host_start(struct qcom_usb4_host *host)
+{
+	struct qcom_usb4_start_config cfg = {
+		.profile = QCOM_USB4_START_SURFACE_A8_PORT0,
+		.pcie_policy = QCOM_USB4_START_PCIE_ENABLE,
+		.mcu = &host->mcu,
+		.firmware = host->fw->data,
+		.firmware_size = host->fw->size,
+		.serial = host->serial,
+		.preset = QCOM_USB4_SURFACE_PRESET,
+		.command_timeout_us = QCOM_USB4_COMMAND_TIMEOUT_US,
+		.connection = {
+			.mode = QCOM_USB4_TUNNEL_USB4,
+			.orientation = QCOM_USB4_PAN_NORMAL,
+			.cable_type = QCOM_USB4_PAN_PASSIVE,
+			.cable_speed = 0,
+			.rounded = 0,
+			.board_retimer = QCOM_USB4_SURFACE_BOARD_RETIMER,
+		},
+	};
+	int ret;
+
+	memset(&host->start_state, 0, sizeof(host->start_state));
+	ret = qcom_usb4_startup_run(&host->start_state, &cfg, &qcom_usb4_host_start_ops, host);
+	if (ret) {
+		dev_err(host->dev,
+			"router startup failed at step %d (last completed %d): %d\n",
+			host->start_state.active_step, host->start_state.last_completed_step,
+			ret);
+		return ret;
+	}
+	dev_info(host->dev, "router firmware running, shared memory at %#x\n",
+		 host->start_state.shared_offset);
+	return 0;
+}
+
+static int qcom_usb4_host_probe_nhi(struct qcom_usb4_host *host)
+{
+	struct tb_nhi *nhi = &host->qnhi.nhi;
+	enum qcom_usb4_irq_width width;
+	unsigned int paths;
+	u32 caps;
+	int ret;
+
+	nhi->dev = host->dev;
+	nhi->iobase = host->router + QCOM_USB4_NHI_OFFSET;
+	nhi->ops = &qcom_usb4_host_nhi_ops;
+
+	caps = readl(nhi->iobase + REG_CAPS);
+	paths = caps & 0x3ff;
+	width = paths <= 10 ? QCOM_USB4_IRQ_32 : QCOM_USB4_IRQ_NATIVE_64;
+	dev_info(host->dev, "NHI capabilities %#010x: %u paths, version %lu\n",
+		 caps, paths, FIELD_GET(REG_CAPS_VERSION_MASK, caps));
+
+	ret = qcom_usb4_nhi_prepare(&host->qnhi, QCOM_USB4_ROUTER_SIZE - QCOM_USB4_NHI_OFFSET,
+				    paths, width, host->nhi_irq);
+	if (ret)
+		return dev_err_probe(host->dev, ret, "NHI adapter preparation\n");
+
+	/* nhi_probe() drops one runtime reference; balance it here. */
+	pm_runtime_get_noresume(host->dev);
+	ret = nhi_probe(nhi);
+	if (ret) {
+		pm_runtime_put_noidle(host->dev);
+		return ret;
+	}
+	/* No validated router suspend/resume sequence: keep the device active. */
+	pm_runtime_forbid(host->dev);
+	host->nhi_probed = true;
+	return 0;
+}
+
+static ssize_t startup_state_show(struct device *dev, struct device_attribute *attr,
+				  char *buf)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+
+	if (!host)
+		return -ENODEV;
+	return sysfs_emit(buf, "phase %d active_step %d last_completed %d error %d shared %#x started %d nhi %d connected %d\n",
+			  host->start_state.phase, host->start_state.active_step,
+			  host->start_state.last_completed_step, host->start_state.error,
+			  host->start_state.shared_offset, host->started, host->nhi_probed,
+			  host->connected);
+}
+static DEVICE_ATTR_RO(startup_state);
+
+/* Bring-up only: send one raw mailbox word (hex) to running router firmware. */
+static ssize_t mailbox_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+	u32 command;
+	int ret;
+
+	if (!host)
+		return -ENODEV;
+	ret = kstrtou32(buf, 16, &command);
+	if (ret)
+		return ret;
+	mutex_lock(&host->lock);
+	if (!host->started)
+		ret = -EHOSTDOWN;
+	else
+		ret = qcom_usb4_host_send_command(host, command, "manual");
+	mutex_unlock(&host->lock);
+	return ret ?: count;
+}
+static DEVICE_ATTR_WO(mailbox);
+
+/*
+ * Bring-up only: the Windows display driver programs a per-DP-IN register
+ * block inside the router window (0x83000 for the first DP IN adapter,
+ * +0x3000 for the second) plus a few shared words. Dump the words it uses
+ * so the DisplayPort tunneling work can compare live state with Windows.
+ */
+#define QCOM_USB4_DPIN_BLOCK(n)		(0x83000 + (n) * 0x3000)
+#define QCOM_USB4_DPIN_CTRL		0x150
+#define QCOM_USB4_DPIN_STATUS		0x154
+#define QCOM_USB4_DPIN_CONFIG		0x158
+#define QCOM_USB4_DPIN_CMD_RESP		0x22c
+#define QCOM_USB4_DPIN_CMD		0x230
+#define QCOM_USB4_DPIN_CMD_TIMEOUT_MS	1000
+
+static ssize_t dpin_regs_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+	static const u32 shared[] = { 0x7f400, 0x7f404, 0x7f408, 0x7f40c,
+				      0x84040, 0x84044, 0x84048, 0x8404c,
+				      0x84070, 0x84074, 0x84078, 0x8407c,
+				      0x85000, 0x85004, 0x85008, 0x8500c,
+				      0x87040, 0x87044, 0x87070, 0x87074,
+				      0x87078, 0x88000, 0x88004, 0x88008,
+				      0x8800c };
+	ssize_t len = 0;
+	unsigned int n, i;
+
+	if (!host)
+		return -ENODEV;
+	mutex_lock(&host->lock);
+	if (!host->started) {
+		mutex_unlock(&host->lock);
+		return -EHOSTDOWN;
+	}
+	for (n = 0; n < 2; n++) {
+		u32 base = QCOM_USB4_DPIN_BLOCK(n);
+
+		len += sysfs_emit_at(buf, len, "dpin%u @%#x:", n, base);
+		for (i = 0; i < 0x40; i += 4)
+			len += sysfs_emit_at(buf, len, " %08x",
+					     readl(host->router + base + i));
+		len += sysfs_emit_at(buf, len, "\n");
+		len += sysfs_emit_at(buf, len, "dpin%u +0x140:", n);
+		for (i = 0x140; i < 0x160; i += 4)
+			len += sysfs_emit_at(buf, len, " %08x",
+					     readl(host->router + base + i));
+		len += sysfs_emit_at(buf, len, "\n");
+		len += sysfs_emit_at(buf, len, "dpin%u +0x220:", n);
+		for (i = 0x220; i < 0x240; i += 4)
+			len += sysfs_emit_at(buf, len, " %08x",
+					     readl(host->router + base + i));
+		len += sysfs_emit_at(buf, len, "\n");
+	}
+	len += sysfs_emit_at(buf, len, "shared:");
+	for (i = 0; i < ARRAY_SIZE(shared); i++)
+		len += sysfs_emit_at(buf, len, " %#x=%08x", shared[i],
+				     readl(host->router + shared[i]));
+	len += sysfs_emit_at(buf, len, "\n");
+	mutex_unlock(&host->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(dpin_regs);
+
+/*
+ * Bring-up only: "<adapter> <hex command>" writes one DPSW command word the
+ * way the Windows display driver does (command register, poll for clear,
+ * read the response word). The result is logged, not acted upon.
+ */
+static ssize_t dpsw_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+	unsigned int adapter, waited = 0;
+	u32 command, pending, response;
+	void __iomem *block;
+
+	if (!host)
+		return -ENODEV;
+	if (qcom_usb4_dp_active(host->dp))
+		return -EBUSY;
+	if (sscanf(buf, "%u %x", &adapter, &command) != 2 || adapter > 1)
+		return -EINVAL;
+	mutex_lock(&host->lock);
+	if (!host->started) {
+		mutex_unlock(&host->lock);
+		return -EHOSTDOWN;
+	}
+	block = host->router + QCOM_USB4_DPIN_BLOCK(adapter);
+	pending = readl(block + QCOM_USB4_DPIN_CMD);
+	if (pending) {
+		dev_warn(dev, "DPSW adapter %u busy: command %#x pending\n",
+			 adapter, pending);
+		mutex_unlock(&host->lock);
+		return -EBUSY;
+	}
+	writel(command, block + QCOM_USB4_DPIN_CMD);
+	do {
+		msleep(10);
+		waited += 10;
+		pending = readl(block + QCOM_USB4_DPIN_CMD);
+	} while (pending && waited < QCOM_USB4_DPIN_CMD_TIMEOUT_MS);
+	response = readl(block + QCOM_USB4_DPIN_CMD_RESP);
+	dev_info(dev, "DPSW adapter %u command %#x: %s after %u ms, response %#x, ctrl %08x status %08x config %08x\n",
+		 adapter, command, pending ? "still pending" : "consumed", waited,
+		 response, readl(block + QCOM_USB4_DPIN_CTRL),
+		 readl(block + QCOM_USB4_DPIN_STATUS),
+		 readl(block + QCOM_USB4_DPIN_CONFIG));
+	mutex_unlock(&host->lock);
+	return pending ? -ETIMEDOUT : count;
+}
+static DEVICE_ATTR_WO(dpsw);
+
+/*
+ * Bring-up only: "<hex offset> <hex value>" writes one word into the DP IN
+ * glue area of the router window (0x7f000..0x89fff), for replaying the
+ * Windows display driver's register sequence by hand.
+ */
+static ssize_t poke_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+	u32 offset, value, before;
+
+	if (!host)
+		return -ENODEV;
+	if (qcom_usb4_dp_active(host->dp))
+		return -EBUSY;
+	if (sscanf(buf, "%x %x", &offset, &value) != 2 || offset & 3 ||
+	    offset < 0x7f000 || offset >= 0x8a000)
+		return -EINVAL;
+	mutex_lock(&host->lock);
+	if (!host->started) {
+		mutex_unlock(&host->lock);
+		return -EHOSTDOWN;
+	}
+	before = readl(host->router + offset);
+	writel(value, host->router + offset);
+	dev_info(dev, "poke %#x: %08x -> wrote %08x, reads %08x\n", offset, before,
+		 value, readl(host->router + offset));
+	mutex_unlock(&host->lock);
+	return count;
+}
+static DEVICE_ATTR_WO(poke);
+
+/*
+ * Bring-up only: run the USB4 DP resource router operations on demand.
+ * "query <port>" addresses a host router DP IN adapter; "retry" re-runs
+ * the connection manager's DP IN discovery and DP tunneling.
+ *
+ * Raw allocation/deallocation cannot be exposed here: they bypass the
+ * connection manager's resource list and live tunnels. In particular,
+ * deallocation can release the producer while its tunnel still owns it.
+ * This is invalid even with the experimental display provider disabled.
+ */
+static ssize_t dp_resource_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+	struct tb_switch *sw;
+	struct tb_port *port;
+	unsigned int number;
+	struct tb *tb;
+	char op[8], extra;
+
+	if (!host)
+		return -ENODEV;
+	if (sscanf(buf, "%7s", op) != 1)
+		return -EINVAL;
+	if (!strcmp(op, "alloc") || !strcmp(op, "dealloc"))
+		return -EOPNOTSUPP;
+	if (!host->nhi_probed)
+		return -EHOSTDOWN;
+	tb = dev_get_drvdata(host->dev);
+	if (!tb)
+		return -ENODEV;
+	if (sysfs_streq(buf, "retry")) {
+		tb_qcom_retry_dp_resources(tb);
+		return count;
+	}
+	if (sscanf(buf, "%7s %u %c", op, &number, &extra) != 2 ||
+	    strcmp(op, "query"))
+		return -EINVAL;
+	mutex_lock(&tb->lock);
+	sw = tb->root_switch;
+	if (!sw || number > sw->config.max_port_number) {
+		mutex_unlock(&tb->lock);
+		return -ENODEV;
+	}
+	port = &sw->ports[number];
+	if (!tb_port_is_dpin(port)) {
+		mutex_unlock(&tb->lock);
+		return -EINVAL;
+	}
+	dev_info(dev, "port %u query: %s\n", number,
+		 tb_switch_query_dp_resource(sw, port) ? "available" : "not available");
+	mutex_unlock(&tb->lock);
+	return count;
+}
+static DEVICE_ATTR_WO(dp_resource);
+
+static ssize_t usb4_dp_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+
+	if (!host || !host->dp)
+		return -ENODEV;
+	return qcom_usb4_dp_status(host->dp, buf);
+}
+
+static ssize_t usb4_dp_store(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(dev);
+	int ret;
+
+	if (!host || !host->dp || !host->started || !host->nhi_probed)
+		return -ENODEV;
+	if (sysfs_streq(buf, "on"))
+		ret = qcom_usb4_dp_enable(host->dp);
+	else if (sysfs_streq(buf, "off"))
+		ret = qcom_usb4_dp_disable(host->dp, false);
+	else if (sysfs_streq(buf, "discover"))
+		ret = qcom_usb4_dp_discover(host->dp);
+	else
+		return -EINVAL;
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(usb4_dp);
+
+static struct attribute *qcom_usb4_host_attrs[] = {
+	&dev_attr_startup_state.attr,
+	&dev_attr_mailbox.attr,
+	&dev_attr_dpin_regs.attr,
+	&dev_attr_dpsw.attr,
+	&dev_attr_poke.attr,
+	&dev_attr_dp_resource.attr,
+	&dev_attr_usb4_dp.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(qcom_usb4_host);
+
+static int qcom_usb4_host_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct qcom_usb4_host *host;
+	const char *fw_name;
+	unsigned int i;
+	int ret;
+
+	host = devm_kzalloc(dev, sizeof(*host), GFP_KERNEL);
+	if (!host)
+		return -ENOMEM;
+	host->dev = dev;
+	mutex_init(&host->lock);
+	init_completion(&host->stop_event);
+	host->orientation = TYPEC_ORIENTATION_NONE;
+
+	ret = of_property_read_u32(dev->of_node, "qcom,router-index", &host->port);
+	if (ret && ret != -EINVAL)
+		return ret;
+	if (host->port != 0)
+		return dev_err_probe(dev, -EINVAL,
+				     "only router 0 has a verified startup profile\n");
+
+	ret = of_property_read_string(dev->of_node, "firmware-name", &fw_name);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware-name\n");
+
+	ret = qcom_usb4_host_get_resources(host);
+	if (ret)
+		return ret;
+	host->dp = qcom_usb4_dp_create(dev, host->router);
+	if (IS_ERR(host->dp))
+		return PTR_ERR(host->dp);
+
+	mutex_lock(&qcom_usb4_hosts_lock);
+	for (i = 0; i < QCOM_USB4_MAX_ROUTERS; i++) {
+		if (!qcom_usb4_hosts[i]) {
+			qcom_usb4_hosts[i] = host;
+			break;
+		}
+	}
+	mutex_unlock(&qcom_usb4_hosts_lock);
+	if (i == QCOM_USB4_MAX_ROUTERS)
+		return -EBUSY;
+
+	/* Register early so the alternate-mode driver can bind regardless. */
+	ret = qcom_usb4_host_typec_register(host);
+	if (ret)
+		goto err_unlist;
+
+	if (!qcom_startup) {
+		dev_warn(dev, "router startup disabled by module parameter\n");
+		return 0;
+	}
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		goto err_unlist;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0) {
+		dev_err(dev, "power on failed: %d\n", ret);
+		goto err_unlist;
+	}
+	host->runtime_held = true;
+
+	ret = icc_set_bw(host->icc_ddr, 0, QCOM_USB4_DDR_PEAK_BW);
+	if (ret)
+		dev_warn(dev, "usb4-ddr bandwidth vote failed: %d\n", ret);
+	ret = icc_set_bw(host->icc_apps, 0, QCOM_USB4_APPS_PEAK_BW);
+	if (ret)
+		dev_warn(dev, "apps-usb4 bandwidth vote failed: %d\n", ret);
+
+	qcom_usb4_host_clocks_enable(host);
+
+	ret = request_firmware(&host->fw, fw_name, dev);
+	if (ret) {
+		dev_err(dev, "router firmware %s unavailable: %d\n", fw_name, ret);
+		goto out_stopped;
+	}
+	dev_info(dev, "router firmware %s: %zu bytes, SoC serial %#x\n", fw_name,
+		 host->fw->size, host->serial);
+
+	ret = devm_request_threaded_irq(dev, host->mcu_irq, NULL, qcom_usb4_host_mcu_irq,
+					IRQF_ONESHOT, "qcom-usb4-mcu", host);
+	if (ret) {
+		dev_err(dev, "MCU interrupt request failed: %d\n", ret);
+		goto out_stopped;
+	}
+
+	ret = qcom_usb4_host_start(host);
+	if (ret)
+		goto out_stopped;
+
+	/* Enable MCU event delivery now that the shared memory is known. */
+	host->event_consumer = 0;
+	host->mcu_irq_enabled = true;
+	qcom_usb4_host_update_router(host, QCOM_USB4_MCU_IRQ_ENABLE, BIT(0), BIT(0));
+
+	ret = qcom_usb4_host_probe_nhi(host);
+	if (ret) {
+		dev_err(dev, "NHI probe failed: %d\n", ret);
+		/* nhi_probe() already ran our shutdown on its failure path. */
+		goto out_stopped;
+	}
+
+	mutex_lock(&host->lock);
+	host->started = true;
+	qcom_usb4_host_apply_link(host);
+	mutex_unlock(&host->lock);
+
+	dev_info(dev, "USB4 host router %u up\n", host->port);
+	return 0;
+
+out_stopped:
+	/* Keep the device bound and inspectable; the router stays down. */
+	qcom_usb4_host_stop_hardware(host);
+	dev_err(dev, "USB4 host router %u not started (%d)\n", host->port, ret);
+	return 0;
+
+err_unlist:
+	mutex_lock(&qcom_usb4_hosts_lock);
+	qcom_usb4_hosts[i] = NULL;
+	mutex_unlock(&qcom_usb4_hosts_lock);
+	return ret;
+}
+
+static void qcom_usb4_host_teardown(struct qcom_usb4_host *host)
+{
+	unsigned int i;
+
+	if (host->nhi_probed) {
+		/* Domain removal ends in our NHI shutdown, which stops the hardware. */
+		nhi_remove(&host->qnhi.nhi);
+		host->nhi_probed = false;
+		pm_runtime_put_noidle(host->dev);
+	} else {
+		qcom_usb4_host_stop_hardware(host);
+	}
+	qcom_usb4_host_clocks_disable(host);
+	if (host->runtime_held) {
+		pm_runtime_put_sync(host->dev);
+		host->runtime_held = false;
+	}
+	if (host->fw) {
+		release_firmware(host->fw);
+		host->fw = NULL;
+	}
+	mutex_lock(&qcom_usb4_hosts_lock);
+	for (i = 0; i < QCOM_USB4_MAX_ROUTERS; i++)
+		if (qcom_usb4_hosts[i] == host)
+			qcom_usb4_hosts[i] = NULL;
+	mutex_unlock(&qcom_usb4_hosts_lock);
+}
+
+static void qcom_usb4_host_remove(struct platform_device *pdev)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(&pdev->dev);
+
+	if (host)
+		qcom_usb4_host_teardown(host);
+}
+
+static void qcom_usb4_host_shutdown(struct platform_device *pdev)
+{
+	struct qcom_usb4_host *host = qcom_usb4_host_from_dev(&pdev->dev);
+
+	if (host)
+		qcom_usb4_host_teardown(host);
+}
+
+static const struct of_device_id qcom_usb4_host_of_match[] = {
+	{ .compatible = "qcom,glymur-usb4" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qcom_usb4_host_of_match);
+/* Surface Laptop 8 router 0 image; initramfs tooling picks it up from here. */
+MODULE_FIRMWARE("qcom/glymur/surface-laptop8/usb4-router-legacy.bin");
+
+struct platform_driver qcom_usb4_host_driver = {
+	.probe = qcom_usb4_host_probe,
+	.remove = qcom_usb4_host_remove,
+	.shutdown = qcom_usb4_host_shutdown,
+	.driver = {
+		.name = "qcom-usb4-host",
+		.of_match_table = qcom_usb4_host_of_match,
+		.dev_groups = qcom_usb4_host_groups,
+		/* Type-C requests may arrive before startup; do not probe asynchronously. */
+	},
+};
diff --git a/drivers/thunderbolt/qcom-usb4-irq.c b/drivers/thunderbolt/qcom-usb4-irq.c
new file mode 100644
index 0000000000000000000000000000000000000000..5bc992989114757cb0f2755169cf9dde579d6301
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-irq.c
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Original transport for the recovered Qualcomm NHI line-interrupt layout. */
+
+#include <linux/bits.h>
+#include <linux/errno.h>
+
+#include "qcom-usb4-irq.h"
+
+#define QCOM_USB4_IRQ_PENDING		0x37800
+#define QCOM_USB4_IRQ_ACK			0x37808
+#define QCOM_USB4_IRQ_MASK		0x38208
+#define QCOM_USB4_IRQ_ENABLE		0x38210
+#define QCOM_USB4_IRQ_DMA_MISC		0x39864
+#define QCOM_USB4_IRQ_DISABLE_CLEAR_ON_READ	BIT(17)
+
+static bool qcom_usb4_irq_valid(const struct qcom_usb4_irq *irq)
+{
+	if (!irq || !irq->base || !irq->paths || irq->paths > 21)
+		return false;
+	if ((unsigned long)irq->base &
+	    (irq->width == QCOM_USB4_IRQ_NATIVE_64 ? 7 : 3))
+		return false;
+	if (irq->paths <= 10)
+		return irq->width == QCOM_USB4_IRQ_32;
+	return irq->width == QCOM_USB4_IRQ_NATIVE_64 ||
+	       irq->width == QCOM_USB4_IRQ_SPLIT_64;
+}
+
+int qcom_usb4_irq_init(struct qcom_usb4_irq *irq, void __iomem *base,
+		      size_t mapping_size, unsigned int paths,
+		      enum qcom_usb4_irq_width width)
+{
+	struct qcom_usb4_irq layout = {
+		.base = base,
+		.paths = paths,
+		.width = width,
+	};
+
+	if (!irq)
+		return -EINVAL;
+	*irq = (struct qcom_usb4_irq) { 0 };
+	if (mapping_size < QCOM_USB4_IRQ_DMA_MISC + sizeof(u32) ||
+	    !qcom_usb4_irq_valid(&layout))
+		return -EINVAL;
+	*irq = layout;
+	return 0;
+}
+
+static u64 qcom_usb4_irq_read(const struct qcom_usb4_irq *irq)
+{
+	u32 low, high;
+
+	if (irq->width == QCOM_USB4_IRQ_NATIVE_64)
+		return readq(irq->base + QCOM_USB4_IRQ_PENDING);
+	low = readl(irq->base + QCOM_USB4_IRQ_PENDING);
+	if (irq->width == QCOM_USB4_IRQ_32)
+		return low;
+	high = readl(irq->base + QCOM_USB4_IRQ_PENDING + sizeof(u32));
+	return low | (u64)high << 32;
+}
+
+static void qcom_usb4_irq_write(const struct qcom_usb4_irq *irq, u32 offset,
+			       u64 value)
+{
+	if (irq->width == QCOM_USB4_IRQ_NATIVE_64) {
+		writeq(value, irq->base + offset);
+		return;
+	}
+	writel((u32)value, irq->base + offset);
+	if (irq->width == QCOM_USB4_IRQ_SPLIT_64)
+		writel((u32)(value >> 32), irq->base + offset + sizeof(u32));
+}
+
+int qcom_usb4_irq_configure(struct qcom_usb4_irq *irq)
+{
+	u32 value;
+
+	if (!qcom_usb4_irq_valid(irq))
+		return -EINVAL;
+	value = readl(irq->base + QCOM_USB4_IRQ_DMA_MISC);
+	writel(value | QCOM_USB4_IRQ_DISABLE_CLEAR_ON_READ,
+	       irq->base + QCOM_USB4_IRQ_DMA_MISC);
+	return 0;
+}
+
+int qcom_usb4_irq_capture(struct qcom_usb4_irq *irq, u64 *pending)
+{
+	u64 value;
+
+	if (!pending || !qcom_usb4_irq_valid(irq))
+		return -EINVAL;
+	value = qcom_usb4_irq_read(irq);
+	if (value) {
+		qcom_usb4_irq_write(irq, QCOM_USB4_IRQ_MASK, value);
+		qcom_usb4_irq_write(irq, QCOM_USB4_IRQ_ACK, value);
+	}
+	*pending = value;
+	return value ? 1 : 0;
+}
+
+int qcom_usb4_irq_set_mask(struct qcom_usb4_irq *irq, unsigned int cause,
+			  bool mask)
+{
+	if (!qcom_usb4_irq_valid(irq) || cause >= 3 * irq->paths)
+		return -EINVAL;
+	qcom_usb4_irq_write(irq, mask ? QCOM_USB4_IRQ_MASK : QCOM_USB4_IRQ_ENABLE,
+			    BIT_ULL(cause));
+	return 0;
+}
+
+int qcom_usb4_irq_disable(struct qcom_usb4_irq *irq)
+{
+	if (!qcom_usb4_irq_valid(irq))
+		return -EINVAL;
+	/* The line pool implements 63 slots; 32-bit access truncates this mask. */
+	qcom_usb4_irq_write(irq, QCOM_USB4_IRQ_MASK, BIT_ULL(63) - 1);
+	qcom_usb4_irq_write(irq, QCOM_USB4_IRQ_ACK, ~0ULL);
+	/* Flush the mask/ack writes before the owner proceeds with teardown. */
+	readl(irq->base + QCOM_USB4_IRQ_DMA_MISC);
+	return 0;
+}
+
+int qcom_usb4_irq_clear_cause(struct qcom_usb4_irq *irq, unsigned int cause)
+{
+	if (!qcom_usb4_irq_valid(irq) || cause >= 3 * irq->paths)
+		return -EINVAL;
+	qcom_usb4_irq_write(irq, QCOM_USB4_IRQ_MASK, BIT_ULL(cause));
+	qcom_usb4_irq_write(irq, QCOM_USB4_IRQ_ACK, BIT_ULL(cause));
+	readl(irq->base + QCOM_USB4_IRQ_DMA_MISC);
+	return 0;
+}
diff --git a/drivers/thunderbolt/qcom-usb4-irq.h b/drivers/thunderbolt/qcom-usb4-irq.h
new file mode 100644
index 0000000000000000000000000000000000000000..cde63ac02ee2f14469c17e992900ac64a201c834
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-irq.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QCOM_USB4_IRQ_H
+#define QCOM_USB4_IRQ_H
+
+#include <linux/io.h>
+#include <linux/types.h>
+
+enum qcom_usb4_irq_width {
+	QCOM_USB4_IRQ_32,
+	QCOM_USB4_IRQ_NATIVE_64,
+	QCOM_USB4_IRQ_SPLIT_64,
+};
+
+/* Initialized layout, immutable while in use. This object does not own MMIO. */
+struct qcom_usb4_irq {
+	void __iomem *base;
+	unsigned int paths;
+	enum qcom_usb4_irq_width width;
+};
+
+/*
+ * The caller supplies verified capabilities and the NHI-relative mapping.
+ * Only the normal acknowledgment layout at 0x37808 is supported. Width is
+ * 32 bits for up to ten paths, otherwise native or split 64-bit access.
+ * The base must be aligned to eight bytes for native 64-bit access, otherwise
+ * four bytes. Initialization checks bounds without touching hardware.
+ */
+int qcom_usb4_irq_init(struct qcom_usb4_irq *irq, void __iomem *base,
+		      size_t mapping_size, unsigned int paths,
+		      enum qcom_usb4_irq_width width);
+
+/*
+ * All following operations require exclusive/serialized ownership of the
+ * registers and a powered, accessible mapping. They do not manage IRQs,
+ * clocks, work, vectors or ring lifetime. Configure clear-on-read off before
+ * capturing causes, including after any reset that loses this configuration.
+ */
+int qcom_usb4_irq_configure(struct qcom_usb4_irq *irq);
+
+/*
+ * Capture, mask and acknowledge the entire pending bank, in that order.
+ * Returns 1 for a captured snapshot, 0 for an empty bank, or a negative error
+ * before MMIO for invalid arguments. On error *pending is unchanged.
+ * The caller must consume the snapshot while maintaining ring/lifetime locks;
+ * this helper does not queue or accumulate it. Filter unsupported causes only
+ * after capture: even reserved pending bits must be masked and acknowledged.
+ * A repeated same-bit event before W1C may coalesce; the snapshot is not an
+ * event counter and does not establish descriptor DMA completion.
+ */
+int qcom_usb4_irq_capture(struct qcom_usb4_irq *irq, u64 *pending);
+
+/* Mask or reenable one valid cause through the write-one mask/set registers. */
+int qcom_usb4_irq_set_mask(struct qcom_usb4_irq *irq, unsigned int cause,
+			  bool mask);
+
+/*
+ * Init/shutdown only: mask the line pool's 63 slots (all 32 bits for a 32-bit
+ * bank), including quiet causes, then discard all pending status. The reserved
+ * bit 63 is excluded from this fixed mask but included in the full-bank ACK,
+ * matching the recovered teardown sequence. A DMA-misc readback follows.
+ * The owner must quiesce ring producers and serialize this operation against
+ * handlers/poll completion, preventing subsequent rearm. This does not release
+ * or synchronize the physical IRQ, drain work, or stop MCU/DMA/power. In
+ * particular, the separate MCU completion IRQ remains outside this helper.
+ */
+int qcom_usb4_irq_disable(struct qcom_usb4_irq *irq);
+
+/*
+ * Discard one stopped cause before reuse: mask, ACK that bit, then read back.
+ * Other causes are untouched; the selected cause stays masked. The caller
+ * must own the cause under the NHI lock and prevent new descriptor submissions.
+ * Do not use during polling completion: a new completion could be discarded.
+ */
+int qcom_usb4_irq_clear_cause(struct qcom_usb4_irq *irq, unsigned int cause);
+
+#endif
diff --git a/drivers/thunderbolt/qcom-usb4-mcu.c b/drivers/thunderbolt/qcom-usb4-mcu.c
new file mode 100644
index 0000000000000000000000000000000000000000..cf72671a5975e56378ea8d24915d029b31e1b4b8
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-mcu.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Qualcomm USB4 MCU run/ready handshake, recovered from the 8480 driver. */
+
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+#include <linux/unaligned.h>
+
+#include "qcom-usb4-drom.h"
+#include "qcom-usb4-fw.h"
+#include "qcom-usb4-mcu.h"
+
+#define QCOM_USB4_MCU_STATUS		0x18
+#define QCOM_USB4_MCU_HOST_CONTROL	0x8018
+#define QCOM_USB4_MCU_UID_HIGH		0x801c
+#define QCOM_USB4_MCU_UID_LOW		0x8020
+#define QCOM_USB4_MCU_READY		BIT(24)
+#define QCOM_USB4_MCU_RUN			BIT(0)
+#define QCOM_USB4_MCU_SHARED_MIN_SIZE	12
+#define QCOM_USB4_MCU_COMMAND_RELATIVE	0xc
+#define QCOM_USB4_MCU_MAX_COMMAND_TIMEOUT_US	1000000
+
+int qcom_usb4_mcu_init(struct qcom_usb4_mcu *mcu, void __iomem *base,
+		       size_t mapping_size, size_t ram_size,
+		       enum qcom_usb4_mcu_layout layout)
+{
+	u32 ram, control, shared;
+
+	if (!mcu)
+		return -EINVAL;
+	*mcu = (struct qcom_usb4_mcu) { 0 };
+	if (!base || (unsigned long)base % sizeof(u32) ||
+	    ram_size < QCOM_USB4_MCU_SHARED_MIN_SIZE)
+		return -EINVAL;
+
+	switch (layout) {
+	case QCOM_USB4_MCU_LEGACY:
+		ram = 0x13000;
+		control = 0x22000;
+		shared = 0x22010;
+		break;
+	case QCOM_USB4_MCU_V2:
+		ram = 0x1e000;
+		control = 0x14000;
+		shared = 0x14010;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* The shared register is the highest control register accessed here. */
+	if (mapping_size < shared + sizeof(u32) || ram > mapping_size ||
+	    ram_size > mapping_size - ram ||
+	    (ram <= control && ram_size > control - ram))
+		return -EINVAL;
+
+	mcu->base = base;
+	mcu->ram_size = ram_size;
+	mcu->ram_offset = ram;
+	mcu->control_offset = control;
+	mcu->shared_offset_reg = shared;
+	mcu->drom_offset = layout == QCOM_USB4_MCU_V2 ? 0xff20 : 0xdf20;
+	return 0;
+}
+
+static int qcom_usb4_mcu_write_word(void *context, u32 offset, u32 value)
+{
+	struct qcom_usb4_mcu *mcu = context;
+
+	writel(value, mcu->base + mcu->ram_offset + offset);
+	return 0;
+}
+
+static int qcom_usb4_mcu_prepare_drom(struct qcom_usb4_mcu *mcu, u8 *drom,
+				      u32 serial, u8 router)
+{
+	if (!mcu || !mcu->base)
+		return -EINVAL;
+	if (mcu->drom_offset > mcu->ram_size ||
+	    QCOM_USB4_DROM_SIZE > mcu->ram_size - mcu->drom_offset)
+		return -EFBIG;
+	return qcom_usb4_drom_build(drom, QCOM_USB4_DROM_SIZE, serial, router);
+}
+
+int qcom_usb4_mcu_upload(struct qcom_usb4_mcu *mcu, const u8 *data, size_t size)
+{
+	int ret;
+
+	if (!mcu || !mcu->base)
+		return -EINVAL;
+	ret = qcom_usb4_fw_validate(data, size, mcu->ram_size);
+	if (ret)
+		return ret;
+	if (readl(mcu->base + mcu->control_offset) & QCOM_USB4_MCU_RUN)
+		return -EBUSY;
+
+	/* The observed upload sequence writes zero before copying any records. */
+	writel(0, mcu->base + mcu->control_offset);
+	ret = qcom_usb4_fw_upload(data, size, mcu->ram_size,
+				 qcom_usb4_mcu_write_word, mcu);
+	if (!ret)
+		/* Flush writes before an intervening provider operation. */
+		readl(mcu->base + mcu->control_offset);
+	return ret;
+}
+
+static void qcom_usb4_mcu_store_drom(struct qcom_usb4_mcu *mcu, const u8 *drom)
+{
+	unsigned int i;
+
+	writel(get_unaligned_le32(drom + 5), mcu->base + QCOM_USB4_MCU_UID_HIGH);
+	writel(get_unaligned_le32(drom + 1), mcu->base + QCOM_USB4_MCU_UID_LOW);
+	for (i = 0; i < QCOM_USB4_DROM_SIZE; i += sizeof(u32))
+		qcom_usb4_mcu_write_word(mcu, mcu->drom_offset + i,
+					 get_unaligned_le32(drom + i));
+	readl(mcu->base + mcu->control_offset);
+}
+
+int qcom_usb4_mcu_write_drom(struct qcom_usb4_mcu *mcu, u32 serial, u8 router)
+{
+	u8 drom[QCOM_USB4_DROM_SIZE];
+	int ret;
+
+	ret = qcom_usb4_mcu_prepare_drom(mcu, drom, serial, router);
+	if (ret)
+		return ret;
+	if (readl(mcu->base + mcu->control_offset) & QCOM_USB4_MCU_RUN)
+		return -EBUSY;
+	qcom_usb4_mcu_store_drom(mcu, drom);
+	return 0;
+}
+
+int qcom_usb4_mcu_load(struct qcom_usb4_mcu *mcu, const u8 *data, size_t size,
+		       u32 serial, u8 router)
+{
+	u8 drom[QCOM_USB4_DROM_SIZE];
+	int ret;
+
+	/* Validate the descriptor before upload can modify any hardware. */
+	ret = qcom_usb4_mcu_prepare_drom(mcu, drom, serial, router);
+	if (ret)
+		return ret;
+	ret = qcom_usb4_mcu_upload(mcu, data, size);
+	if (ret)
+		return ret;
+	qcom_usb4_mcu_store_drom(mcu, drom);
+	return 0;
+}
+
+static void qcom_usb4_mcu_update(struct qcom_usb4_mcu *mcu, u32 offset,
+				u32 mask, u32 value)
+{
+	u32 reg = readl(mcu->base + offset);
+
+	writel((reg & ~mask) | (value & mask), mcu->base + offset);
+}
+
+void qcom_usb4_mcu_stop(struct qcom_usb4_mcu *mcu)
+{
+	if (!mcu || !mcu->base)
+		return;
+
+	qcom_usb4_mcu_update(mcu, mcu->control_offset, QCOM_USB4_MCU_RUN, 0);
+	qcom_usb4_mcu_update(mcu, QCOM_USB4_MCU_HOST_CONTROL,
+			     QCOM_USB4_MCU_READY, 0);
+	/* Complete posted writes before the caller releases power or clocks. */
+	readl(mcu->base + QCOM_USB4_MCU_HOST_CONTROL);
+}
+
+int qcom_usb4_mcu_start(struct qcom_usb4_mcu *mcu, u32 *shared_offset)
+{
+	u32 status, offset;
+	int ret;
+
+	if (!shared_offset)
+		return -EINVAL;
+	*shared_offset = 0;
+	if (!mcu || !mcu->base)
+		return -EINVAL;
+	if (readl(mcu->base + mcu->control_offset) & QCOM_USB4_MCU_RUN)
+		return -EBUSY;
+
+	qcom_usb4_mcu_update(mcu, QCOM_USB4_MCU_HOST_CONTROL,
+			     QCOM_USB4_MCU_READY, 0);
+	qcom_usb4_mcu_update(mcu, mcu->control_offset,
+			     QCOM_USB4_MCU_RUN, QCOM_USB4_MCU_RUN);
+	ret = readl_poll_timeout(mcu->base + QCOM_USB4_MCU_STATUS, status,
+				 status & QCOM_USB4_MCU_READY, 5000, 1000000);
+	if (ret)
+		goto stop;
+
+	offset = readl(mcu->base + mcu->shared_offset_reg);
+	if (offset % sizeof(u32) ||
+	    offset > mcu->ram_size - QCOM_USB4_MCU_SHARED_MIN_SIZE) {
+		ret = -EPROTO;
+		goto stop;
+	}
+
+	*shared_offset = offset;
+	return 0;
+
+stop:
+	qcom_usb4_mcu_stop(mcu);
+	return ret;
+}
+
+int qcom_usb4_mcu_command(struct qcom_usb4_mcu *mcu, u32 command,
+			 unsigned int timeout_us)
+{
+	void __iomem *mailbox;
+	u32 value;
+
+	if (!mcu || !mcu->base || !command || !timeout_us ||
+	    timeout_us > QCOM_USB4_MCU_MAX_COMMAND_TIMEOUT_US)
+		return -EINVAL;
+	if (!(readl(mcu->base + mcu->control_offset) & QCOM_USB4_MCU_RUN))
+		return -EHOSTDOWN;
+	if (!(readl(mcu->base + QCOM_USB4_MCU_STATUS) & QCOM_USB4_MCU_READY))
+		return -EAGAIN;
+
+	/* Both layouts place the mailbox before the validated shared register. */
+	mailbox = mcu->base + mcu->control_offset + QCOM_USB4_MCU_COMMAND_RELATIVE;
+	if (readl(mailbox))
+		return -EBUSY;
+
+	writel(command, mailbox);
+	return readl_poll_timeout(mailbox, value, !value, 1, timeout_us);
+}
diff --git a/drivers/thunderbolt/qcom-usb4-mcu.h b/drivers/thunderbolt/qcom-usb4-mcu.h
new file mode 100644
index 0000000000000000000000000000000000000000..df49836bfcf3d13f0762ba5d6a38299b4da599cc
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-mcu.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QCOM_USB4_MCU_H
+#define QCOM_USB4_MCU_H
+
+#include <linux/io.h>
+#include <linux/types.h>
+
+enum qcom_usb4_mcu_layout {
+	QCOM_USB4_MCU_LEGACY,
+	QCOM_USB4_MCU_V2,
+};
+
+struct qcom_usb4_mcu {
+	void __iomem *base;
+	size_t ram_size;
+	u32 ram_offset;
+	u32 control_offset;
+	u32 shared_offset_reg;
+	u32 drom_offset;
+};
+
+/*
+ * The caller must verify the router variant and usable RAM size, own the
+ * mapping, serialize all operations, and maintain power/clocks throughout.
+ * The register mapping base must be aligned to four bytes.
+ * Initializing this helper does not touch hardware. It is not a power/reset
+ * sequence or a platform driver. Do not modify the fields after initialization.
+ */
+int qcom_usb4_mcu_init(struct qcom_usb4_mcu *mcu, void __iomem *base,
+		       size_t mapping_size, size_t ram_size,
+		       enum qcom_usb4_mcu_layout layout);
+
+/*
+ * Separate stopped-state operations for platform sequencing. Upload validates
+ * the entire image before zeroing control and writing firmware; it does not
+ * write UID/DROM or start the MCU. A control readback follows successful
+ * upload before returning. The owner can then perform the required
+ * provider memory-force and board-extension steps before writing UID/DROM.
+ * Both operations reject running firmware without writes. DROM input/bounds
+ * validation happens before any MMIO. Neither operation establishes power,
+ * image identity, physical halt or successful completion of the other step.
+ * Keep exclusive ownership across the entire sequence, including provider work.
+ */
+int qcom_usb4_mcu_upload(struct qcom_usb4_mcu *mcu, const u8 *data, size_t size);
+int qcom_usb4_mcu_write_drom(struct qcom_usb4_mcu *mcu, u32 serial, u8 router);
+
+/*
+ * Upload a caller-selected immutable image and generated DROM while stopped.
+ * serial and router must be validated hardware identity, as for the DROM
+ * builder. Malformed input or running firmware causes no hardware writes.
+ * This convenience operation provides no intervening provider step. The Surface
+ * platform sequence requires upload and write_drom separately, with memory
+ * force and the board extension between them. This does not select an image
+ * or establish the board's power/reset state.
+ */
+int qcom_usb4_mcu_load(struct qcom_usb4_mcu *mcu, const u8 *data, size_t size,
+		       u32 serial, u8 router);
+
+/*
+ * Start requires a fully uploaded firmware image and DROM. Already running
+ * firmware is rejected without modifying hardware. On failure after starting,
+ * stop the MCU and leave shared_offset zero. Success validates only the first
+ * 12 shared bytes; further accesses require their own bounds checks.
+ */
+int qcom_usb4_mcu_start(struct qcom_usb4_mcu *mcu, u32 *shared_offset);
+void qcom_usb4_mcu_stop(struct qcom_usb4_mcu *mcu);
+
+/*
+ * Send a caller-validated, nonzero command to running, ready firmware.
+ * Requires sleepable context and exclusive command/lifecycle ownership.
+ * timeout_us must be in 1..1000000; it is caller policy, not a discovered
+ * hardware limit. Success means only that firmware cleared the mailbox.
+ * On timeout the command may still be executing: do not retry blindly. This
+ * helper neither clears a pending command nor resets/stops firmware.
+ */
+int qcom_usb4_mcu_command(struct qcom_usb4_mcu *mcu, u32 command,
+			 unsigned int timeout_us);
+
+#endif
diff --git a/drivers/thunderbolt/qcom-usb4-nhi.c b/drivers/thunderbolt/qcom-usb4-nhi.c
new file mode 100644
index 0000000000000000000000000000000000000000..d73ac6a0a756b2a4612f29c8daefea95abe3536e
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-nhi.c
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/lockdep.h>
+
+#include "qcom-usb4-nhi.h"
+
+static struct qcom_usb4_nhi *to_qcom_nhi(struct tb_nhi *nhi)
+{
+	return container_of(nhi, struct qcom_usb4_nhi, nhi);
+}
+
+static struct tb_ring *qcom_usb4_nhi_owned_ring(struct qcom_usb4_nhi *qnhi,
+					     unsigned int cause)
+{
+	struct tb_nhi *nhi = &qnhi->nhi;
+	struct tb_ring *ring;
+
+	lockdep_assert_held(&nhi->lock);
+	if (cause >= 2 * nhi->hop_count)
+		return NULL;
+	if (cause < nhi->hop_count)
+		ring = nhi->tx_rings[cause];
+	else
+		ring = nhi->rx_rings[cause - nhi->hop_count];
+	if (!ring || (ring->flags & RING_FLAG_NO_INTERRUPT) ||
+	    ring->irq != qnhi->irq || ring->vector >= QCOM_USB4_NHI_MESSAGE_IDS ||
+	    qnhi->owners[ring->vector] != ring)
+		return NULL;
+	return ring;
+}
+
+int qcom_usb4_nhi_prepare(struct qcom_usb4_nhi *qnhi, size_t mapping_size,
+			 unsigned int paths, enum qcom_usb4_irq_width width,
+			 int irq)
+{
+	struct qcom_usb4_irq transport;
+	int ret;
+
+	if (!qnhi || !qnhi->nhi.dev || irq <= 0)
+		return -EINVAL;
+	if (qnhi->prepared)
+		return -EBUSY;
+	ret = qcom_usb4_irq_init(&transport, qnhi->nhi.iobase, mapping_size,
+			       paths, width);
+	if (ret)
+		return ret;
+	qnhi->transport = transport;
+	qnhi->irq = irq;
+	ida_init(&qnhi->message_ids);
+	mutex_init(&qnhi->ownership_lock);
+	qnhi->prepared = true;
+	return 0;
+}
+
+static irqreturn_t qcom_usb4_nhi_interrupt(int irq, void *data)
+{
+	struct qcom_usb4_nhi *qnhi = data;
+	struct tb_nhi *nhi = &qnhi->nhi;
+	unsigned long flags;
+	unsigned int cause;
+	u64 pending;
+	int ret = 0;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	if (!qnhi->accept_rearm || nhi->going_away)
+		goto unlock;
+	ret = qcom_usb4_irq_capture(&qnhi->transport, &pending);
+	if (ret <= 0)
+		goto unlock;
+	for (cause = 0; cause < 3 * qnhi->transport.paths; cause++) {
+		if (!(pending & BIT_ULL(cause)))
+			continue;
+		if (cause < 2 * nhi->hop_count &&
+		    !qcom_usb4_nhi_owned_ring(qnhi, cause))
+			continue;
+		if (nhi_handle_interrupt(nhi, cause))
+			qcom_usb4_irq_set_mask(&qnhi->transport, cause, false);
+	}
+unlock:
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	return ret > 0 ? IRQ_HANDLED : IRQ_NONE;
+}
+
+int qcom_usb4_nhi_init_interrupts(struct tb_nhi *nhi)
+{
+	struct qcom_usb4_nhi *qnhi = to_qcom_nhi(nhi);
+	unsigned long flags;
+	int ret;
+
+	if (!qnhi->prepared || qnhi->released)
+		return -EINVAL;
+	if (qnhi->init_attempted)
+		return -EBUSY;
+	if (!nhi->tx_rings || !nhi->rx_rings ||
+	    nhi->hop_count != qnhi->transport.paths ||
+	    (nhi->quirks & QUIRK_AUTO_CLEAR_INT))
+		return -EINVAL;
+	qnhi->core_ready = true;
+	qnhi->init_attempted = true;
+	spin_lock_irqsave(&nhi->lock, flags);
+	qnhi->accept_rearm = false;
+	ret = qcom_usb4_irq_configure(&qnhi->transport);
+	if (!ret)
+		ret = qcom_usb4_irq_disable(&qnhi->transport);
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	if (ret)
+		return ret;
+
+	/* Control rings require NO_SUSPEND; this is one controller-owned IRQ. */
+	ret = request_irq(qnhi->irq, qcom_usb4_nhi_interrupt, IRQF_NO_SUSPEND,
+			 dev_name(nhi->dev), qnhi);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&nhi->lock, flags);
+	qnhi->irq_requested = true;
+	qnhi->accept_rearm = true;
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	return 0;
+}
+
+int qcom_usb4_nhi_request_ring_irq(struct tb_ring *ring, bool no_suspend)
+{
+	struct qcom_usb4_nhi *qnhi = to_qcom_nhi(ring->nhi);
+	unsigned long flags;
+	int id, ret = 0;
+
+	if (!qnhi->prepared)
+		return -EINVAL;
+	mutex_lock(&qnhi->ownership_lock);
+	if (!qnhi->core_ready || qnhi->released ||
+	    (ring->flags & RING_FLAG_NO_INTERRUPT)) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	/* All rings share the NO_SUSPEND physical IRQ, including these requests. */
+	(void)no_suspend;
+	id = ida_alloc_max(&qnhi->message_ids, QCOM_USB4_NHI_MESSAGE_IDS - 1,
+			   GFP_KERNEL);
+	if (id < 0) {
+		ret = id;
+		goto unlock;
+	}
+	spin_lock_irqsave(&ring->nhi->lock, flags);
+	if (!qnhi->accept_rearm || ring->nhi->going_away)
+		ret = -ESHUTDOWN;
+	else if (ring->irq)
+		ret = -EBUSY;
+	else {
+		qnhi->owners[id] = ring;
+		ring->vector = id;
+		ring->irq = qnhi->irq;
+		/* Match the captured default of 125 units, each nominally 256 ns. */
+		ring->interval_nsec = 32000;
+	}
+	spin_unlock_irqrestore(&ring->nhi->lock, flags);
+	if (ret)
+		ida_free(&qnhi->message_ids, id);
+unlock:
+	mutex_unlock(&qnhi->ownership_lock);
+	return ret;
+}
+
+void qcom_usb4_nhi_release_ring_irq(struct tb_ring *ring)
+{
+	struct qcom_usb4_nhi *qnhi = to_qcom_nhi(ring->nhi);
+	unsigned long flags;
+	int id = -1;
+
+	if (!qnhi->prepared)
+		return;
+	mutex_lock(&qnhi->ownership_lock);
+	if (!qnhi->core_ready || qnhi->released)
+		goto unlock;
+	spin_lock_irqsave(&ring->nhi->lock, flags);
+	if (ring->irq == qnhi->irq && ring->vector < QCOM_USB4_NHI_MESSAGE_IDS &&
+	    qnhi->owners[ring->vector] == ring) {
+		id = ring->vector;
+		qnhi->owners[id] = NULL;
+		ring->irq = 0;
+		ring->vector = 0;
+	}
+	spin_unlock_irqrestore(&ring->nhi->lock, flags);
+	if (id >= 0)
+		ida_free(&qnhi->message_ids, id);
+	/* No cause MMIO: the old hop can already belong to another ring. */
+unlock:
+	mutex_unlock(&qnhi->ownership_lock);
+}
+
+void qcom_usb4_nhi_ring_interrupt_mask(struct tb_nhi *nhi, unsigned int cause,
+				     bool mask)
+{
+	struct qcom_usb4_nhi *qnhi = to_qcom_nhi(nhi);
+	struct tb_ring *ring;
+
+	lockdep_assert_held(&nhi->lock);
+	if (!qnhi->accept_rearm || nhi->going_away || cause >= 2 * nhi->hop_count)
+		return;
+	ring = qcom_usb4_nhi_owned_ring(qnhi, cause);
+	if (!ring)
+		return;
+	/* Start precedes running=true. Poll rearm must preserve new pending bits. */
+	if (!mask && !ring->running &&
+	    qcom_usb4_irq_clear_cause(&qnhi->transport, cause))
+		return;
+	qcom_usb4_irq_set_mask(&qnhi->transport, cause, mask);
+}
+
+void qcom_usb4_nhi_disable_interrupts(struct tb_nhi *nhi)
+{
+	struct qcom_usb4_nhi *qnhi = to_qcom_nhi(nhi);
+	unsigned long flags;
+
+	if (!qnhi->prepared || qnhi->released)
+		return;
+	/* The common caller initializes the lock before its first disable call. */
+	if (!qnhi->core_ready)
+		qnhi->core_ready = true;
+	spin_lock_irqsave(&nhi->lock, flags);
+	qnhi->accept_rearm = false;
+	qcom_usb4_irq_disable(&qnhi->transport);
+	spin_unlock_irqrestore(&nhi->lock, flags);
+}
+
+void qcom_usb4_nhi_shutdown(struct tb_nhi *nhi)
+{
+	struct qcom_usb4_nhi *qnhi = to_qcom_nhi(nhi);
+	unsigned int id;
+
+	if (!qnhi->prepared)
+		return;
+	mutex_lock(&qnhi->ownership_lock);
+	if (qnhi->released)
+		goto unlock;
+	if (qnhi->core_ready)
+		qcom_usb4_nhi_disable_interrupts(nhi);
+	if (qnhi->irq_requested) {
+		free_irq(qnhi->irq, qnhi);
+		qnhi->irq_requested = false;
+	}
+	/* Keep ownership intact if the caller has not yet drained its rings. */
+	for (id = 0; id < QCOM_USB4_NHI_MESSAGE_IDS; id++) {
+		if (WARN_ON(qnhi->owners[id]))
+			goto unlock;
+	}
+	ida_destroy(&qnhi->message_ids);
+	qnhi->released = true;
+unlock:
+	mutex_unlock(&qnhi->ownership_lock);
+}
diff --git a/drivers/thunderbolt/qcom-usb4-nhi.h b/drivers/thunderbolt/qcom-usb4-nhi.h
new file mode 100644
index 0000000000000000000000000000000000000000..09f97ec7b082277f4612e97be3fb172592abf084
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-nhi.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QCOM_USB4_NHI_H
+#define QCOM_USB4_NHI_H
+
+#include <linux/idr.h>
+#include <linux/mutex.h>
+
+#include "nhi.h"
+#include "qcom-usb4-irq.h"
+
+#define QCOM_USB4_NHI_MESSAGE_IDS 16
+
+/* One lifetime, initially zeroed; the frontend owns the surrounding object. */
+struct qcom_usb4_nhi {
+	struct tb_nhi nhi;
+	struct qcom_usb4_irq transport;
+	struct ida message_ids;
+	struct mutex ownership_lock;
+	struct tb_ring *owners[QCOM_USB4_NHI_MESSAGE_IDS];
+	int irq;
+	bool prepared;
+	bool core_ready;
+	bool init_attempted;
+	bool irq_requested;
+	bool accept_rearm;
+	bool released;
+};
+
+/*
+ * Set nhi.dev and nhi.iobase first. Validate the caller-supplied capabilities
+ * and initialize ownership before common probe; no MMIO or IRQ registration.
+ * Prepare, init, controller disable and shutdown must be serialized by the
+ * frontend. Repeating prepare is rejected, including after shutdown. This is
+ * not a platform driver or a complete tb_nhi_ops implementation.
+ */
+int qcom_usb4_nhi_prepare(struct qcom_usb4_nhi *qnhi, size_t mapping_size,
+			 unsigned int paths, enum qcom_usb4_irq_width width,
+			 int irq);
+
+/*
+ * Individual callbacks for a frontend's tb_nhi_ops. They require the embedded
+ * NHI above. Common probe must initialize its lock and ring arrays before
+ * init_interrupts; its earlier disable_interrupts call is supported.
+ *
+ * The single physical IRQ uses IRQF_NO_SUSPEND for the control rings. Its
+ * handler accesses MMIO only while accept_rearm is true; the owner must close
+ * that gate while registers remain accessible before removing power. This
+ * flag is not system wake enablement. The separate MCU event IRQ is not owned.
+ * Request/release callbacks run in sleepable context without the NHI lock.
+ * Their ownership mutex is always acquired before the NHI spinlock.
+ */
+int qcom_usb4_nhi_init_interrupts(struct tb_nhi *nhi);
+int qcom_usb4_nhi_request_ring_irq(struct tb_ring *ring, bool no_suspend);
+void qcom_usb4_nhi_release_ring_irq(struct tb_ring *ring);
+void qcom_usb4_nhi_ring_interrupt_mask(struct tb_nhi *nhi, unsigned int cause,
+				     bool mask);
+void qcom_usb4_nhi_disable_interrupts(struct tb_nhi *nhi);
+
+/*
+ * Idempotent final cleanup, also usable after failed probe. The owner must
+ * release every ring first. Mask/ack under the NHI lock, then free the physical
+ * IRQ outside it (waiting for handlers) before destroying the ID allocator.
+ * There is no adapter workqueue. Core ring work and domain lifetime must be
+ * drained by their owner; this callback does not stop MCU, DMA or power.
+ * An ownership mutex serializes complete allocation/release callbacks against
+ * allocator destruction. Before freeing the surrounding object, the caller
+ * must also exclude every future callback and complete all existing callers.
+ */
+void qcom_usb4_nhi_shutdown(struct tb_nhi *nhi);
+
+#endif
diff --git a/drivers/thunderbolt/qcom-usb4-startup.c b/drivers/thunderbolt/qcom-usb4-startup.c
new file mode 100644
index 0000000000000000000000000000000000000000..177e66454440f5d87ef2267e410dbff980cfb85e
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-startup.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Original, unbound forward sequence for the captured Surface A8 router 0. */
+
+#include <linux/array_size.h>
+#include <linux/bits.h>
+#include <linux/errno.h>
+
+#include "qcom-usb4-drom.h"
+#include "qcom-usb4-fw.h"
+#include "qcom-usb4-startup.h"
+
+enum start_kind {
+	START_PROVIDER,
+	START_UPDATE,
+	START_DELAY,
+	START_CLEAR_1200C,
+	START_UPLOAD,
+	START_DROM,
+	START_MCU,
+	START_PRESET,
+	START_PCIE,
+};
+
+struct start_operation {
+	enum qcom_usb4_start_step step;
+	enum start_kind kind;
+	u32 offset;
+	u32 mask;
+	u32 value;
+};
+
+#define PROVIDER(s) { .step = QCOM_USB4_START_##s, .kind = START_PROVIDER }
+#define UPDATE(s, o, m, v) { QCOM_USB4_START_##s, START_UPDATE, o, m, v }
+#define DELAY(s, us) { QCOM_USB4_START_##s, START_DELAY, 0, 0, us }
+#define SPECIAL(s, k) { .step = QCOM_USB4_START_##s, .kind = k }
+
+static const struct start_operation start_operations[] = {
+	PROVIDER(RX_PAD_PREPARE),
+	PROVIDER(TX_B_PAD_PREPARE),
+	PROVIDER(TX_A_PAD_PREPARE),
+	PROVIDER(RX_CLOCKS_REFERENCE),
+	PROVIDER(USB4_RESET_ASSERT),
+	PROVIDER(COMBO_RESET_ASSERT),
+	PROVIDER(DP_RESET_ASSERT),
+	DELAY(ASSERT_STALL, 1),
+	DELAY(ASSERT_SETTLE, 100),
+	PROVIDER(DP_RESET_DEASSERT),
+	PROVIDER(COMBO_RESET_DEASSERT),
+	PROVIDER(USB4_RESET_DEASSERT),
+	PROVIDER(CLOCK_READY),
+	DELAY(DEASSERT_SETTLE, 100),
+	PROVIDER(RX_CLOCKS_PHY),
+	SPECIAL(ROUTER_1200C_CLEAR, START_CLEAR_1200C),
+	PROVIDER(RX_PAD_ACTIVE),
+	PROVIDER(TX_B_PAD_ACTIVE),
+	PROVIDER(TX_A_PAD_ACTIVE),
+	UPDATE(ROUTER_81000_SET, 0x81000, BIT(0), BIT(0)),
+	PROVIDER(GCC_600C0_BIT3_SET),
+	DELAY(CONTROL_ASSERT_STALL, 1000),
+	DELAY(CONTROL_ASSERT_SETTLE, 100),
+	UPDATE(ROUTER_81018_SET, 0x81018, BIT(0), BIT(0)),
+	PROVIDER(GCC_600C0_BIT3_CLEAR),
+	DELAY(CONTROL_DEASSERT_STALL, 1000),
+	DELAY(CONTROL_DEASSERT_SETTLE, 100),
+	UPDATE(ROUTER_81000_CLEAR, 0x81000, BIT(0), 0),
+	SPECIAL(FIRMWARE_UPLOAD, START_UPLOAD),
+	PROVIDER(SYS_MEMORY_FORCE),
+	/* The captured Surface PHYC extension is empty, verified by owner_check. */
+	SPECIAL(DROM, START_DROM),
+	PROVIDER(TCSR_ROUTE),
+	PROVIDER(PIPE_HWCG_OFF),
+	UPDATE(ROUTER_81004_SET, 0x81004, BIT(0), BIT(0)),
+	UPDATE(TIMER_HIGH, 0x80c8, 0xffff0000, 0x00040000),
+	UPDATE(TIMER_LOW, 0x80c8, 0x0000ffff, 0),
+	UPDATE(TIMER_8148, 0x8148, 0xffffffff, 250000),
+	UPDATE(TIMER_8144, 0x8144, 0xffffffff, 4000),
+	PROVIDER(PHY_COMPOSITE),
+	UPDATE(ADAPTER_BIT23, 0xd000, BIT(23), 0),
+	UPDATE(ADAPTER_BIT22, 0xd000, BIT(22), 0),
+	UPDATE(ADAPTER_BIT21, 0xd000, BIT(21), 0),
+	SPECIAL(MCU, START_MCU),
+	SPECIAL(PRESET, START_PRESET),
+	SPECIAL(PCIE_POLICY, START_PCIE),
+};
+
+static int start_validate(const struct qcom_usb4_start_config *cfg,
+			  const struct qcom_usb4_start_ops *ops)
+{
+	const struct qcom_usb4_mcu *mcu;
+	u8 drom[QCOM_USB4_DROM_SIZE];
+	u32 command;
+	int ret;
+
+	if (!cfg || !ops || !ops->owner_check || !ops->provider ||
+	    !ops->read_router || !ops->update_router || !ops->delay_us)
+		return -EINVAL;
+	if (cfg->profile != QCOM_USB4_START_SURFACE_A8_PORT0 ||
+	    (cfg->pcie_policy != QCOM_USB4_START_PCIE_SKIP &&
+	     cfg->pcie_policy != QCOM_USB4_START_PCIE_ENABLE))
+		return -EINVAL;
+	if (cfg->preset != 0x4421 || !cfg->command_timeout_us ||
+	    cfg->command_timeout_us > 1000000 || cfg->connection.board_retimer != 1)
+		return -EINVAL;
+	mcu = cfg->mcu;
+	if (!mcu || !mcu->base || (unsigned long)mcu->base % sizeof(u32) ||
+	    mcu->ram_offset != 0x13000 || mcu->control_offset != 0x22000 ||
+	    mcu->shared_offset_reg != 0x22010 || mcu->drom_offset != 0xdf20 ||
+	    mcu->ram_size < 0xdf20 + sizeof(drom) || mcu->ram_size > 0xf000)
+		return -EINVAL;
+	ret = qcom_usb4_typec_connect_command(&cfg->connection, &command);
+	if (ret)
+		return ret;
+	ret = qcom_usb4_drom_build(drom, sizeof(drom), cfg->serial, 0);
+	if (ret)
+		return ret;
+	return qcom_usb4_fw_validate(cfg->firmware, cfg->firmware_size, mcu->ram_size);
+}
+
+static int start_clear_1200c(const struct qcom_usb4_start_ops *ops, void *ctx)
+{
+	u32 value;
+	unsigned int i;
+	int ret;
+
+	ret = ops->read_router(ctx, 0x1200c, &value);
+	if (ret)
+		return ret;
+	for (i = 0; value & BIT(31); i++) {
+		if (i == 11)
+			return -ETIMEDOUT;
+		ret = ops->update_router(ctx, 0x1200c, BIT(31), 0);
+		if (ret)
+			return ret;
+		ops->delay_us(ctx, 1);
+		/* Explicit final verification, unlike the vendor's fallthrough. */
+		ret = ops->read_router(ctx, 0x1200c, &value);
+		if (ret)
+			return ret;
+	}
+	ops->delay_us(ctx, 10000);
+	return 0;
+}
+
+static int start_execute(const struct start_operation *op,
+			 struct qcom_usb4_start_state *state,
+			 const struct qcom_usb4_start_config *cfg,
+			 const struct qcom_usb4_start_ops *ops, void *ctx)
+{
+	u32 command;
+	int ret;
+
+	switch (op->kind) {
+	case START_PROVIDER:
+		return ops->provider(ctx, op->step, cfg);
+	case START_UPDATE:
+		return ops->update_router(ctx, op->offset, op->mask, op->value);
+	case START_DELAY:
+		ops->delay_us(ctx, op->value);
+		return 0;
+	case START_CLEAR_1200C:
+		return start_clear_1200c(ops, ctx);
+	case START_UPLOAD:
+		return qcom_usb4_mcu_upload(cfg->mcu, cfg->firmware, cfg->firmware_size);
+	case START_DROM:
+		return qcom_usb4_mcu_write_drom(cfg->mcu, cfg->serial, 0);
+	case START_MCU:
+		return qcom_usb4_mcu_start(cfg->mcu, &state->shared_offset);
+	case START_PRESET:
+		ret = qcom_usb4_typec_preset_command(cfg->preset, &command);
+		if (ret)
+			return ret;
+		return qcom_usb4_mcu_command(cfg->mcu, command, cfg->command_timeout_us);
+	case START_PCIE:
+		if (cfg->pcie_policy == QCOM_USB4_START_PCIE_SKIP)
+			return 0;
+		return ops->update_router(ctx, 0x82010, 0xc, 0xc);
+	}
+	return -EINVAL;
+}
+
+int qcom_usb4_startup_run(struct qcom_usb4_start_state *state,
+			const struct qcom_usb4_start_config *cfg,
+			const struct qcom_usb4_start_ops *ops, void *context)
+{
+	unsigned int i;
+	int ret;
+
+	if (!state)
+		return -EINVAL;
+	if (state->phase != QCOM_USB4_START_NEW)
+		return state->phase == QCOM_USB4_START_RUNNING ? -EBUSY : -EALREADY;
+	state->phase = QCOM_USB4_START_RUNNING;
+	state->active_step = QCOM_USB4_START_VALIDATE;
+	state->last_completed_step = QCOM_USB4_START_NONE;
+	state->shared_offset = 0;
+	state->error = 0;
+	ret = start_validate(cfg, ops);
+	if (ret)
+		goto failed;
+	state->last_completed_step = state->active_step;
+	state->active_step = QCOM_USB4_START_OWNER_CHECK;
+	ret = ops->owner_check(context, cfg);
+	if (ret)
+		goto failed;
+	state->last_completed_step = state->active_step;
+
+	for (i = 0; i < ARRAY_SIZE(start_operations); i++) {
+		state->active_step = start_operations[i].step;
+		ret = start_execute(&start_operations[i], state, cfg, ops, context);
+		if (ret)
+			goto failed;
+		state->last_completed_step = state->active_step;
+	}
+	state->active_step = QCOM_USB4_START_NONE;
+	state->phase = QCOM_USB4_START_COMPLETE;
+	return 0;
+
+failed:
+	state->error = ret < 0 ? ret : -EPROTO;
+	state->phase = QCOM_USB4_START_FAILED;
+	return state->error;
+}
diff --git a/drivers/thunderbolt/qcom-usb4-startup.h b/drivers/thunderbolt/qcom-usb4-startup.h
new file mode 100644
index 0000000000000000000000000000000000000000..4967947490644f8ead4e74a5dbc74706421aabc1
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-startup.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QCOM_USB4_STARTUP_H
+#define QCOM_USB4_STARTUP_H
+
+#include "qcom-usb4-mcu.h"
+#include "qcom-usb4-typec.h"
+
+enum qcom_usb4_start_profile {
+	QCOM_USB4_START_PROFILE_UNSET,
+	QCOM_USB4_START_SURFACE_A8_PORT0,
+};
+
+enum qcom_usb4_start_pcie_policy {
+	QCOM_USB4_START_PCIE_UNSET,
+	QCOM_USB4_START_PCIE_SKIP,
+	QCOM_USB4_START_PCIE_ENABLE,
+};
+
+enum qcom_usb4_start_phase {
+	QCOM_USB4_START_NEW,
+	QCOM_USB4_START_RUNNING,
+	QCOM_USB4_START_FAILED,
+	QCOM_USB4_START_COMPLETE,
+};
+
+enum qcom_usb4_start_step {
+	QCOM_USB4_START_NONE,
+	QCOM_USB4_START_VALIDATE,
+	QCOM_USB4_START_OWNER_CHECK,
+	QCOM_USB4_START_RX_PAD_PREPARE,
+	QCOM_USB4_START_TX_B_PAD_PREPARE,
+	QCOM_USB4_START_TX_A_PAD_PREPARE,
+	QCOM_USB4_START_RX_CLOCKS_REFERENCE,
+	QCOM_USB4_START_USB4_RESET_ASSERT,
+	QCOM_USB4_START_COMBO_RESET_ASSERT,
+	QCOM_USB4_START_DP_RESET_ASSERT,
+	QCOM_USB4_START_ASSERT_STALL,
+	QCOM_USB4_START_ASSERT_SETTLE,
+	QCOM_USB4_START_DP_RESET_DEASSERT,
+	QCOM_USB4_START_COMBO_RESET_DEASSERT,
+	QCOM_USB4_START_USB4_RESET_DEASSERT,
+	QCOM_USB4_START_CLOCK_READY,
+	QCOM_USB4_START_DEASSERT_SETTLE,
+	QCOM_USB4_START_RX_CLOCKS_PHY,
+	QCOM_USB4_START_ROUTER_1200C_CLEAR,
+	QCOM_USB4_START_RX_PAD_ACTIVE,
+	QCOM_USB4_START_TX_B_PAD_ACTIVE,
+	QCOM_USB4_START_TX_A_PAD_ACTIVE,
+	QCOM_USB4_START_ROUTER_81000_SET,
+	QCOM_USB4_START_GCC_600C0_BIT3_SET,
+	QCOM_USB4_START_CONTROL_ASSERT_STALL,
+	QCOM_USB4_START_CONTROL_ASSERT_SETTLE,
+	QCOM_USB4_START_ROUTER_81018_SET,
+	QCOM_USB4_START_GCC_600C0_BIT3_CLEAR,
+	QCOM_USB4_START_CONTROL_DEASSERT_STALL,
+	QCOM_USB4_START_CONTROL_DEASSERT_SETTLE,
+	QCOM_USB4_START_ROUTER_81000_CLEAR,
+	QCOM_USB4_START_FIRMWARE_UPLOAD,
+	QCOM_USB4_START_SYS_MEMORY_FORCE,
+	QCOM_USB4_START_DROM,
+	QCOM_USB4_START_TCSR_ROUTE,
+	QCOM_USB4_START_PIPE_HWCG_OFF,
+	QCOM_USB4_START_ROUTER_81004_SET,
+	QCOM_USB4_START_TIMER_HIGH,
+	QCOM_USB4_START_TIMER_LOW,
+	QCOM_USB4_START_TIMER_8148,
+	QCOM_USB4_START_TIMER_8144,
+	QCOM_USB4_START_PHY_COMPOSITE,
+	QCOM_USB4_START_ADAPTER_BIT23,
+	QCOM_USB4_START_ADAPTER_BIT22,
+	QCOM_USB4_START_ADAPTER_BIT21,
+	QCOM_USB4_START_MCU,
+	QCOM_USB4_START_PRESET,
+	QCOM_USB4_START_PCIE_POLICY,
+};
+
+struct qcom_usb4_start_config {
+	enum qcom_usb4_start_profile profile;
+	enum qcom_usb4_start_pcie_policy pcie_policy;
+	struct qcom_usb4_mcu *mcu;
+	const u8 *firmware;
+	size_t firmware_size;
+	u32 serial;
+	u32 preset;
+	unsigned int command_timeout_us;
+	struct qcom_usb4_pan_connect connection;
+};
+
+/*
+ * Zero-initialize once for a fresh, owner-established cold-start attempt.
+ * Failure may have partial hardware effects, including in active_step itself.
+ * This state is not a rollback log or proof that firmware/DMA has halted.
+ */
+struct qcom_usb4_start_state {
+	enum qcom_usb4_start_phase phase;
+	enum qcom_usb4_start_step active_step;
+	enum qcom_usb4_start_step last_completed_step;
+	int error;
+	u32 shared_offset;
+};
+
+/*
+ * Integer callbacks return 0 on completed success or a negative errno.
+ * Positive statuses are rejected. The caller serializes the sleepable operation,
+ * retains immutable inputs, and owns all mappings/providers until recovery.
+ *
+ * owner_check must verify this exact board/image, empty PHYC, powered/exclusive
+ * cold state and inactive shared DP before any effectful callback. Holding the
+ * shared owners' locks is required; merely observing MODE clear is insufficient.
+ * No MCU/DMA/NHI traffic or Type-C command may race this sequence.
+ *
+ * provider implements only the typed provider steps in the source table, using
+ * the owning pinctrl/clock/reset/PHY interfaces. CLOCK_READY needs a finite,
+ * explicit readiness policy; the vendor's impossible clock predicate is not
+ * copied. PHY_COMPOSITE must include common PHY setup, then the separate DP
+ * producer/AUX operation, then table/start/calibration. The existing bare PHY
+ * callback does not yet supply that composite operation. RX clock transitions
+ * must establish both selectors, with both gates off around the switch.
+ *
+ * Router offsets below refer to the expanded router window, never GCC/TLMM.
+ * update_router preserves bits outside mask. delay_us must honor the requested
+ * minimum delay and return only when complete. No provider backend is supplied.
+ */
+struct qcom_usb4_start_ops {
+	int (*owner_check)(void *context, const struct qcom_usb4_start_config *cfg);
+	int (*provider)(void *context, enum qcom_usb4_start_step step,
+			const struct qcom_usb4_start_config *cfg);
+	int (*read_router)(void *context, u32 offset, u32 *value);
+	int (*update_router)(void *context, u32 offset, u32 mask, u32 value);
+	void (*delay_us)(void *context, unsigned int usec);
+};
+
+/*
+ * One attempt only: no automatic restart, rollback, connect command, NHI
+ * registration, event consumer, suspend or shutdown. Success means only this
+ * forward sequence completed. On failure no later step is attempted. The owner
+ * must decide recovery, even when a callback reports failure before completion.
+ * The existing MCU-start helper locally clears RUN/host-ready after a timeout
+ * or bad shared pointer. This is not whole-sequence rollback or physical halt.
+ */
+int qcom_usb4_startup_run(struct qcom_usb4_start_state *state,
+			const struct qcom_usb4_start_config *cfg,
+			const struct qcom_usb4_start_ops *ops, void *context);
+
+#endif
diff --git a/drivers/thunderbolt/qcom-usb4-typec.c b/drivers/thunderbolt/qcom-usb4-typec.c
new file mode 100644
index 0000000000000000000000000000000000000000..2acc0e81e8087ae1f34957b143a76e87932fad36
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-typec.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Original encoder of the Surface Qualcomm USB4 MCU mailbox contract.
+ * Evidence: TYPEC-MAILBOX.md, UCSI 0xac18..0xace4 and filter 0x14720.
+ * Command completion, power sequencing and link readiness belong to callers;
+ * encoding a word does not establish that the MCU can accept it.
+ */
+#include <linux/errno.h>
+#include <linux/usb/pd.h>
+
+#include "qcom-usb4-typec.h"
+
+int qcom_usb4_typec_connect_command(const struct qcom_usb4_pan_connect *pan,
+				   u32 *command)
+{
+	u32 cable_class;
+
+	if (!pan || !command)
+		return -EINVAL;
+	if (pan->mode > QCOM_USB4_TUNNEL_USB4 ||
+	    pan->orientation > QCOM_USB4_PAN_REVERSE ||
+	    pan->rounded > 1 || pan->board_retimer > 1)
+		return -EINVAL;
+	if (pan->cable_type > QCOM_USB4_PAN_RETIMER || pan->cable_speed > 1)
+		return -EOPNOTSUPP;
+
+	cable_class = 0;
+	if (pan->cable_type == QCOM_USB4_PAN_RETIMER) {
+		cable_class = 1;
+		if (pan->mode == QCOM_USB4_TUNNEL_TBT && !pan->rounded)
+			cable_class = 3;
+	}
+
+	*command = 1U | (u32)pan->mode << 8 | (u32)pan->orientation << 9 |
+		   (u32)pan->board_retimer << 10 | cable_class << 11 |
+		   (u32)pan->cable_speed << 13;
+	return 0;
+}
+
+int qcom_usb4_typec_usb4_command(const struct enter_usb_data *data,
+				enum typec_orientation orientation,
+				u8 board_retimer, u32 *command)
+{
+	struct qcom_usb4_pan_connect pan = {
+		.mode = QCOM_USB4_TUNNEL_USB4,
+		.board_retimer = board_retimer,
+	};
+	u32 speed;
+
+	if (!data || !command)
+		return -EINVAL;
+	if (((data->eudo & EUDO_USB_MODE_MASK) >> EUDO_USB_MODE_SHIFT) !=
+	    EUDO_USB_MODE_USB4)
+		return -EINVAL;
+	if (data->active_link_training)
+		return -EOPNOTSUPP;
+
+	switch (orientation) {
+	case TYPEC_ORIENTATION_NORMAL:
+		pan.orientation = QCOM_USB4_PAN_NORMAL;
+		break;
+	case TYPEC_ORIENTATION_REVERSE:
+		pan.orientation = QCOM_USB4_PAN_REVERSE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	speed = (data->eudo & EUDO_CABLE_SPEED_MASK) >> EUDO_CABLE_SPEED_SHIFT;
+	switch (speed) {
+	case EUDO_CABLE_SPEED_USB4_GEN2:
+		pan.cable_speed = 0;
+		break;
+	case EUDO_CABLE_SPEED_USB4_GEN3:
+		pan.cable_speed = 1;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	pan.cable_type = (data->eudo & EUDO_CABLE_TYPE_MASK) >> EUDO_CABLE_TYPE_SHIFT;
+
+	return qcom_usb4_typec_connect_command(&pan, command);
+}
+
+int qcom_usb4_typec_tbt_command(const struct typec_thunderbolt_data *data,
+			      enum typec_orientation orientation,
+			      u8 board_retimer, u32 *command)
+{
+	struct qcom_usb4_pan_connect pan = {
+		.mode = QCOM_USB4_TUNNEL_TBT,
+		.board_retimer = board_retimer,
+	};
+	u32 cable, enter, speed, rounded;
+	bool active, retimer;
+
+	if (!data || !command)
+		return -EINVAL;
+	cable = data->cable_mode;
+	enter = data->enter_vdo;
+	if (!(data->device_mode & TBT_MODE) || !(cable & TBT_MODE) ||
+	    !(enter & TBT_MODE))
+		return -EINVAL;
+	if (TBT_ADAPTER(data->device_mode) != TBT_ADAPTER_TBT3)
+		return -EOPNOTSUPP;
+	if ((cable | enter) & (TBT_CABLE_OPTICAL | TBT_CABLE_LINK_TRAINING))
+		return -EOPNOTSUPP;
+
+	active = !!(cable & TBT_CABLE_ACTIVE_PASSIVE);
+	retimer = !!(cable & TBT_CABLE_RETIMER);
+	if (active != !!(enter & TBT_ENTER_MODE_ACTIVE_CABLE) ||
+	    retimer != !!(enter & TBT_CABLE_RETIMER) || (!active && retimer))
+		return -EINVAL;
+	/* Redriver or old GLINK active-only data must not become a retimer. */
+	if (active && !retimer)
+		return -EOPNOTSUPP;
+	pan.cable_type = retimer ? QCOM_USB4_PAN_RETIMER : QCOM_USB4_PAN_PASSIVE;
+
+	speed = TBT_CABLE_SPEED(cable);
+	if (speed != TBT_CABLE_SPEED(enter))
+		return -EINVAL;
+	switch (speed) {
+	case TBT_CABLE_USB3_PASSIVE:
+		pan.cable_speed = 0;
+		break;
+	case TBT_CABLE_10_AND_20GBPS:
+		pan.cable_speed = 1;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	rounded = TBT_CABLE_ROUNDED_SUPPORT(cable);
+	if (rounded != TBT_CABLE_ROUNDED_SUPPORT(enter))
+		return -EINVAL;
+	if (rounded > 1)
+		return -EOPNOTSUPP;
+	pan.rounded = rounded;
+
+	switch (orientation) {
+	case TYPEC_ORIENTATION_NORMAL:
+		pan.orientation = QCOM_USB4_PAN_NORMAL;
+		break;
+	case TYPEC_ORIENTATION_REVERSE:
+		pan.orientation = QCOM_USB4_PAN_REVERSE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return qcom_usb4_typec_connect_command(&pan, command);
+}
+
+int qcom_usb4_typec_preset_command(u32 preset, u32 *command)
+{
+	if (!command || preset > 0xffff)
+		return -EINVAL;
+	*command = 2U | preset << 8;
+	return 0;
+}
+
+int qcom_usb4_typec_disconnect_command(u32 *command)
+{
+	if (!command)
+		return -EINVAL;
+	*command = 6;
+	return 0;
+}
diff --git a/drivers/thunderbolt/qcom-usb4-typec.h b/drivers/thunderbolt/qcom-usb4-typec.h
new file mode 100644
index 0000000000000000000000000000000000000000..fe90e894d322ee61babb58952b637dd0140c03c1
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-typec.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef QCOM_USB4_TYPEC_H
+#define QCOM_USB4_TYPEC_H
+
+#include <linux/types.h>
+#include <linux/usb/typec.h>
+#include <linux/usb/typec_tbt.h>
+
+enum qcom_usb4_tunnel_mode {
+	QCOM_USB4_TUNNEL_TBT = 0,
+	QCOM_USB4_TUNNEL_USB4 = 1,
+};
+
+/* PAN wire values, deliberately distinct from enum typec_orientation. */
+enum qcom_usb4_pan_orientation {
+	QCOM_USB4_PAN_NORMAL = 0,
+	QCOM_USB4_PAN_REVERSE = 1,
+};
+
+enum qcom_usb4_pan_cable_type {
+	QCOM_USB4_PAN_PASSIVE = 0,
+	QCOM_USB4_PAN_RETIMER = 1,
+};
+
+/*
+ * Validated PAN fields for the observed Surface PS8830 path.
+ * cable_speed is the PAN value 0/1: USB4 Gen2/Gen3 respectively;
+ * TBT maps these to TBT_CABLE_USB3_PASSIVE/TBT_CABLE_10_AND_20GBPS.
+ * rounded and board_retimer must be 0/1. The latter describes the board,
+ * never the cable. Determine it from verified board configuration.
+ * Do not truncate raw fields before calling: unavailable mode/orientation,
+ * unsupported cable types and higher cable speeds must remain distinguishable.
+ */
+struct qcom_usb4_pan_connect {
+	u8 mode;
+	u8 orientation;
+	u8 cable_type;
+	u8 cable_speed;
+	u8 rounded;
+	u8 board_retimer;
+};
+
+/* All helpers leave *command unchanged on error. They perform no hardware I/O. */
+int qcom_usb4_typec_connect_command(const struct qcom_usb4_pan_connect *pan,
+				   u32 *command);
+
+/*
+ * Adapter for TYPEC_MODE_USB4's enter_usb_data, not a mux callback.
+ * Caller must establish the payload's mode/type before passing it here.
+ * Gen4, redriver, optical and active-link-training cases are unsupported.
+ */
+int qcom_usb4_typec_usb4_command(const struct enter_usb_data *data,
+				enum typec_orientation orientation,
+				u8 board_retimer, u32 *command);
+
+/*
+ * Adapter for a verified TBT modal payload. Requires standard cable-type and
+ * Enter Mode flags, including TBT_CABLE_RETIMER for a retimer cable. The older
+ * GLINK producer omits this flag; its ambiguous active payload is rejected.
+ * Optical/redriver cables, link training and unsupported rates are rejected.
+ */
+int qcom_usb4_typec_tbt_command(const struct typec_thunderbolt_data *data,
+			      enum typec_orientation orientation,
+			      u8 board_retimer, u32 *command);
+
+/* Only packs a verified 16-bit PMSK/preset; does not choose or apply a preset. */
+int qcom_usb4_typec_preset_command(u32 preset, u32 *command);
+int qcom_usb4_typec_disconnect_command(u32 *command);
+
+#endif
diff --git a/include/linux/soc/qcom/usb4-dp.h b/include/linux/soc/qcom/usb4-dp.h
new file mode 100644
index 0000000000000000000000000000000000000000..18f8b49e08755efa0363810ccb66a271040e591c
--- /dev/null
+++ b/include/linux/soc/qcom/usb4-dp.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _QCOM_USB4_DP_H
+#define _QCOM_USB4_DP_H
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct device;
+struct drm_dp_aux;
+
+/* Surface 8 opt-in experiment; not a general upstream provider ABI.
+ * Callbacks may sleep. They must not re-enter the MSM AUX wrapper.
+ * The caller retains aux, ops and data until detach has returned.
+ * Exported calls acquire the display device lock; callers must not hold it.
+ */
+struct msm_dp_usb4_ops {
+	int (*configure_link)(void *data, unsigned int rate, unsigned int lanes);
+	int (*train_link)(void *data, unsigned int rate, unsigned int lanes);
+	/* Prepare the sink and both tunnel adapters for FEC before training.
+	 * Must write DPCD FEC_READY and complete any required SET_FEC_READY
+	 * acknowledgment. Return an error if this is unsupported or uncertain.
+	 * Runs with the MSM AUX mutex held; must not re-enter its wrapper.
+	 */
+	int (*set_fec_ready)(void *data, bool ready);
+	void (*unconfigure_link)(void *data);
+};
+
+#if IS_REACHABLE(CONFIG_DRM_MSM)
+int msm_dp_usb4_attach(struct device *dev, struct drm_dp_aux *aux,
+		      const struct msm_dp_usb4_ops *ops, void *data);
+void msm_dp_usb4_detach(struct device *dev);
+int msm_dp_usb4_hpd(struct device *dev, bool connected, bool irq);
+/* Returns -EBUSY on disconnect while DRM still owns an active/prepared link. */
+int msm_dp_usb4_hpd_sync(struct device *dev, bool connected, bool irq);
+int msm_dp_usb4_route(struct device *dev, unsigned int resource);
+#else
+static inline int msm_dp_usb4_attach(struct device *dev, struct drm_dp_aux *aux,
+		const struct msm_dp_usb4_ops *ops, void *data) { return -ENODEV; }
+static inline void msm_dp_usb4_detach(struct device *dev) { }
+static inline int msm_dp_usb4_hpd(struct device *dev, bool connected, bool irq)
+{ return -ENODEV; }
+static inline int msm_dp_usb4_hpd_sync(struct device *dev, bool connected, bool irq)
+{ return -ENODEV; }
+static inline int msm_dp_usb4_route(struct device *dev, unsigned int resource)
+{ return -ENODEV; }
+#endif
+#endif
