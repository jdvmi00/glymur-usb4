diff --git a/drivers/thunderbolt/qcom-usb4-dp.c b/drivers/thunderbolt/qcom-usb4-dp.c
new file mode 100644
index 0000000000000000000000000000000000000000..1e2070667d46921bc9de22c41fee7d700900fab7
--- /dev/null
+++ b/drivers/thunderbolt/qcom-usb4-dp.c
@@ -0,0 +1,876 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Surface Laptop 8 router 0 / DP IN 0 experimental display owner.
+ *
+ * The firmware's op-4 mailbox messages are requests to the display owner,
+ * not adapter hardware commands. Service them independently of the USB4
+ * connection manager, which may be synchronously waiting for their replies.
+ * FIFO AUX/control transactions use a separate lock and work item so that
+ * slow receiver discovery cannot stall those mailbox replies.
+ */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/device/driver.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <linux/soc/qcom/usb4-dp.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#include <drm/display/drm_dp_helper.h>
+
+#include "qcom-usb4-dp.h"
+#include "qcom-usb4-dp-link.h"
+
+#define DP_AUX_BASE		0x83000
+#define DP_ADAPTER_STRIDE	0x3000
+#define DP_FIFO_TX		0x000
+#define DP_FIFO_TX_DATA		0x004
+#define DP_FIFO_RX_CONSUME	0x03c
+#define DP_FIFO_RX_STATUS	0x044
+#define DP_FIFO_READY		0x048
+#define DP_FIFO_RX_HEADER	0x050
+#define DP_FIFO_RX_DATA		0x054
+#define DP_IRQ_ENABLE		0x150
+#define DP_IRQ_STATUS		0x154
+#define DP_IRQ_CLEAR		0x158
+#define DP_MCU_REQUEST		0x22c
+#define DP_MCU_REPLY		0x230
+#define DP_IRQ_MCU_REQUEST	BIT(11)
+#define DP_IRQ_RESOURCE		BIT(9)
+#define DP_IRQ_TX_DONE		BIT(0)
+#define DP_IRQ_CONTROL_DONE	BIT(7)
+#define DP_IRQ_RX_READY		BIT(1)
+#define DP_RX_COUNT		GENMASK(29, 26)
+#define DP_RX_ERROR		BIT(15)
+#define DP_PACKET_TYPE		GENMASK(31, 28)
+#define DP_PACKET_COUNT		GENMASK(15, 8)
+#define DP_PACKET_AUX		0
+#define DP_PACKET_CONTROL	2
+#define DP_FIFO_TIMEOUT_US	100000
+#define DP_FIFO_MAX_PACKETS	32
+#define DP_MAILBOX_POLL_MS	2
+#define DP_CAPS_POLL_MS		20
+#define DP_CAPS_MAX_POLLS	500
+
+struct qcom_usb4_dp {
+	struct device *dev;
+	void __iomem *router;
+	struct device *display;
+	struct platform_device *child;
+	struct work_struct link_work;
+	bool connected;
+	bool stopping;
+	struct drm_dp_aux aux;
+	struct mutex lifecycle_lock;
+	struct mutex state_lock;
+	struct mutex fifo_lock;
+	struct mutex command_lock;
+	u32 pending_reply[2];
+	struct delayed_work mailbox_work;
+	struct delayed_work caps_work;
+	bool enabled;
+	bool allocated;
+	bool ready;
+	bool fifo_fault;
+	bool release_failed;
+	bool runtime_held;
+	unsigned int caps_polls;
+	unsigned int messages;
+	bool fec_trace;
+	unsigned int fec_trace_events;
+};
+
+static void __iomem *dp_base(struct qcom_usb4_dp *dp, unsigned int adapter)
+{
+	return dp->router + DP_AUX_BASE + adapter * DP_ADAPTER_STRIDE;
+}
+
+static bool dp_known_control(const u8 packet[4])
+{
+	switch (packet[1]) {
+	case 0x02:
+	case 0x03:
+	case 0x0c:
+	case 0x12:
+	case 0x16:
+	case 0x1d:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* fifo_lock held. Every observed packet is consumed exactly once. */
+static int dp_fifo_rx(struct qcom_usb4_dp *dp, unsigned int *type,
+		      u8 payload[20], unsigned int *count)
+{
+	void __iomem *base = dp_base(dp, 0);
+	u32 status = readl(base + DP_FIFO_RX_STATUS);
+	u32 header;
+	unsigned int i, raw_count;
+	int ret = 0;
+
+	if (!(status & DP_RX_COUNT))
+		return -EAGAIN;
+	header = readl(base + DP_FIFO_RX_HEADER);
+	*type = FIELD_GET(DP_PACKET_TYPE, header);
+	raw_count = FIELD_GET(DP_PACKET_COUNT, header);
+	if (status & DP_RX_ERROR) {
+		ret = -EIO;
+		goto consume;
+	}
+	if (*type == DP_PACKET_AUX) {
+		if (raw_count < 6 || raw_count > 25) {
+			ret = -EPROTO;
+			goto consume;
+		}
+		*count = raw_count - 5;
+	} else if (*type == DP_PACKET_CONTROL && raw_count == 4) {
+		*count = 4;
+	} else {
+		ret = -EPROTO;
+		goto consume;
+	}
+	for (i = 0; i < *count; i += 4)
+		put_unaligned_le32(readl(base + DP_FIFO_RX_DATA + i), payload + i);
+consume:
+	if (dp->fec_trace && dp->fec_trace_events < 64) {
+		dp->fec_trace_events++;
+		if (!ret)
+			dev_info(dp->dev, "FEC trace RX type=%u data=%*ph\n",
+				 *type, *count, payload);
+		else
+			dev_info(dp->dev, "FEC trace RX error=%d header=%#x status=%#x\n",
+				 ret, header, status);
+	}
+	/* Complete the payload reads before releasing the receive slot. */
+	mb();
+	writel(1, base + DP_FIFO_RX_CONSUME);
+	writel(DP_IRQ_RX_READY, base + DP_IRQ_CLEAR);
+	return ret;
+}
+
+/* A previous unmatched AUX reply cannot belong to a new transaction. */
+static int dp_fifo_drain(struct qcom_usb4_dp *dp)
+{
+	u8 payload[20];
+	unsigned int type, count, i;
+	int ret;
+
+	for (i = 0; i < DP_FIFO_MAX_PACKETS; i++) {
+		ret = dp_fifo_rx(dp, &type, payload, &count);
+		if (ret == -EAGAIN)
+			return 0;
+		if (ret)
+			return ret;
+		if (type != DP_PACKET_CONTROL || !dp_known_control(payload))
+			return -EPROTO;
+		dev_dbg(dp->dev, "DP control notification %*ph\n", 4, payload);
+	}
+	return -EOVERFLOW;
+}
+
+static int dp_fifo_tx(struct qcom_usb4_dp *dp, unsigned int type,
+		      const u8 *payload, unsigned int count)
+{
+	void __iomem *base = dp_base(dp, 0);
+	u8 padded[20] = {};
+	u32 status;
+	unsigned int i;
+
+	if (count > sizeof(padded))
+		return -EINVAL;
+	memcpy(padded, payload, count);
+	if (dp->fec_trace && dp->fec_trace_events < 64) {
+		dp->fec_trace_events++;
+		dev_info(dp->dev, "FEC trace TX type=%u data=%*ph\n",
+			 type, count, payload);
+	}
+	writel(DP_IRQ_TX_DONE | DP_IRQ_RX_READY, base + DP_IRQ_CLEAR);
+	for (i = 0; i < sizeof(padded); i += 4)
+		writel(get_unaligned_le32(padded + i), base + DP_FIFO_TX_DATA + i);
+	wmb();
+	writel(FIELD_PREP(DP_PACKET_TYPE, type) |
+	       FIELD_PREP(DP_PACKET_COUNT, count + (type == DP_PACKET_AUX ? 5 : 0)) |
+	       BIT(0), base + DP_FIFO_TX);
+	return readl_poll_timeout(base + DP_IRQ_STATUS, status,
+				  status & DP_IRQ_TX_DONE, 100, DP_FIFO_TIMEOUT_US);
+}
+
+static int dp_fifo_wait(struct qcom_usb4_dp *dp, unsigned int wanted_type,
+			int wanted_opcode, u8 payload[20], unsigned int *count)
+{
+	unsigned long deadline = jiffies + usecs_to_jiffies(DP_FIFO_TIMEOUT_US);
+	unsigned int type, packets = 0;
+	int ret;
+
+	do {
+		ret = dp_fifo_rx(dp, &type, payload, count);
+		if (ret == -EAGAIN) {
+			usleep_range(100, 200);
+			continue;
+		}
+		if (ret)
+			return ret;
+		if (type == wanted_type &&
+		    (wanted_type == DP_PACKET_AUX || payload[1] == wanted_opcode))
+			return 0;
+		if (type != DP_PACKET_CONTROL || !dp_known_control(payload))
+			return -EPROTO;
+		dev_dbg(dp->dev, "DP control while waiting: %*ph\n", 4, payload);
+		if (++packets >= DP_FIFO_MAX_PACKETS)
+			return -EOVERFLOW;
+	} while (time_before(jiffies, deadline));
+	return -ETIMEDOUT;
+}
+
+static int dp_fifo_fault(struct qcom_usb4_dp *dp, int ret)
+{
+	if (ret < 0) {
+		/* No transaction IDs exist: a late response after timeout cannot
+		 * safely be distinguished from a subsequent transaction's reply.
+		 */
+		WRITE_ONCE(dp->fifo_fault, true);
+		dev_err(dp->dev, "DP FIFO stopped after error %d; router reset required\n", ret);
+	}
+	return ret;
+}
+
+static int dp_control(void *ctx, const u8 tx[4], u8 rx[4])
+{
+	struct qcom_usb4_dp *dp = ctx;
+	void __iomem *base = dp_base(dp, 0);
+	u32 status;
+	u8 payload[20];
+	unsigned int count;
+	int ret;
+
+	mutex_lock(&dp->fifo_lock);
+	if (!READ_ONCE(dp->enabled) || !READ_ONCE(dp->allocated) ||
+	    READ_ONCE(dp->fifo_fault) ||
+	    READ_ONCE(dp->release_failed)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = dp_fifo_drain(dp);
+	if (ret)
+		goto fault;
+	/*
+	 * Windows clears and waits for control completion separately from TX.
+	 * Clear the prior completion before submission; AUX keeps its own path.
+	 */
+	writel(DP_IRQ_CONTROL_DONE, base + DP_IRQ_CLEAR);
+	ret = dp_fifo_tx(dp, DP_PACKET_CONTROL, tx, 4);
+	if (!ret)
+		ret = readl_poll_timeout(base + DP_IRQ_STATUS, status,
+					 status & DP_IRQ_CONTROL_DONE,
+					 100, DP_FIFO_TIMEOUT_US);
+	if (!ret && rx) {
+		ret = dp_fifo_wait(dp, DP_PACKET_CONTROL, tx[1], payload, &count);
+		if (!ret)
+			memcpy(rx, payload, 4);
+	}
+fault:
+	dp_fifo_fault(dp, ret);
+out:
+	mutex_unlock(&dp->fifo_lock);
+	return ret;
+}
+
+static ssize_t dp_aux_transfer(struct drm_dp_aux *aux, struct drm_dp_aux_msg *msg)
+{
+	struct qcom_usb4_dp *dp = container_of(aux, struct qcom_usb4_dp, aux);
+	u8 tx[20] = {}, rx[20];
+	unsigned int request = msg->request & ~DP_AUX_I2C_MOT;
+	unsigned int count, tx_count = 4;
+	bool read;
+	int ret;
+
+	if (!msg->size || msg->size > 16 || !msg->buffer || msg->address > 0xfffff)
+		return -EINVAL;
+	switch (request) {
+	case DP_AUX_NATIVE_READ:
+	case DP_AUX_I2C_READ:
+		read = true;
+		break;
+	case DP_AUX_NATIVE_WRITE:
+	case DP_AUX_I2C_WRITE:
+	case DP_AUX_I2C_WRITE_STATUS_UPDATE:
+		read = false;
+		break;
+	default:
+		return -EINVAL;
+	}
+	tx[0] = (msg->request << 4) | (msg->address >> 16);
+	tx[1] = msg->address >> 8;
+	tx[2] = msg->address;
+	tx[3] = msg->size - 1;
+	if (!read && request != DP_AUX_I2C_WRITE_STATUS_UPDATE) {
+		memcpy(tx + 4, msg->buffer, msg->size);
+		tx_count += msg->size;
+	}
+
+	mutex_lock(&dp->fifo_lock);
+	if (!READ_ONCE(dp->enabled) || !READ_ONCE(dp->allocated) ||
+	    READ_ONCE(dp->fifo_fault) || READ_ONCE(dp->release_failed)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = dp_fifo_drain(dp);
+	if (ret)
+		goto fault;
+	/* Diagnostic capture only: preserve AUX/control handling unchanged. */
+	if (request == DP_AUX_NATIVE_WRITE && msg->address == DP_FEC_CONFIGURATION)
+		dp->fec_trace = true;
+	ret = dp_fifo_tx(dp, DP_PACKET_AUX, tx, tx_count);
+	if (ret)
+		goto fault;
+	ret = dp_fifo_wait(dp, DP_PACKET_AUX, 0, rx, &count);
+	if (ret)
+		goto fault;
+	/* This FIFO carries the raw AUX reply byte, whose reply code is the
+	 * upper nibble (the same framing as its raw request header).
+	 */
+	if (rx[0] & 0x0f) {
+		ret = -EPROTO;
+		goto fault;
+	}
+	msg->reply = rx[0] >> 4;
+	if ((msg->reply & DP_AUX_NATIVE_REPLY_MASK) == DP_AUX_NATIVE_REPLY_MASK ||
+	    (msg->reply & DP_AUX_I2C_REPLY_MASK) == DP_AUX_I2C_REPLY_MASK) {
+		ret = -EPROTO;
+		goto fault;
+	}
+	if (msg->reply) {
+		ret = 0;
+		goto out;
+	}
+	if (read) {
+		if (count - 1 > msg->size) {
+			ret = -EPROTO;
+			goto fault;
+		}
+		memcpy(msg->buffer, rx + 1, count - 1);
+		ret = count - 1;
+	} else if (count == 1) {
+		ret = msg->size;
+	} else if (count == 2 && rx[1] <= msg->size) {
+		ret = rx[1];
+	} else {
+		ret = -EPROTO;
+		goto fault;
+	}
+	goto out;
+fault:
+	dp_fifo_fault(dp, ret);
+out:
+	mutex_unlock(&dp->fifo_lock);
+	return ret;
+}
+
+static int dp_dpsw(void *ctx, u32 command)
+{
+	struct qcom_usb4_dp *dp = ctx;
+	void __iomem *base = dp_base(dp, 0);
+	u32 value;
+	int ret;
+
+	mutex_lock(&dp->command_lock);
+	if (!READ_ONCE(dp->enabled) ||
+	    (command == 5 ? READ_ONCE(dp->allocated) : !READ_ONCE(dp->allocated)) ||
+	    READ_ONCE(dp->fifo_fault) || READ_ONCE(dp->release_failed) ||
+	    dp->pending_reply[0] ||
+	    readl(base + DP_MCU_REQUEST) || readl(base + DP_MCU_REPLY)) {
+		ret = -EBUSY;
+	} else {
+		writel(command, base + DP_MCU_REPLY);
+		ret = 0;
+	}
+	mutex_unlock(&dp->command_lock);
+	if (ret)
+		return ret;
+	/* Never hold the command lock while firmware may ask its display owner
+	 * for a resource. The mailbox worker must be able to send that reply.
+	 */
+	return readl_poll_timeout(base + DP_MCU_REPLY, value, !value,
+				  100, DP_FIFO_TIMEOUT_US);
+}
+
+static int dp_discover(struct qcom_usb4_dp *dp)
+{
+	int ret;
+
+	if (!READ_ONCE(dp->enabled))
+		return -ENODEV;
+	if (READ_ONCE(dp->allocated))
+		return -EALREADY;
+	/* The proven initial request causes firmware to ask its display owner
+	 * for allocation. A plain core resource query does not start this flow.
+	 */
+	ret = dp_dpsw(dp, 5);
+	if (ret)
+		dev_warn(dp->dev, "DP discovery command failed (%d); mailbox service retained, inspect usb4_dp before retrying discover\n", ret);
+	return ret;
+}
+
+static int dp_configure_link(void *ctx, unsigned int rate, unsigned int lanes)
+{
+	struct qcom_usb4_dp *dp = ctx;
+
+	return qcom_usb4_dp_configure_link(dp->router, dp_dpsw, dp, rate, lanes);
+}
+
+/* Called under the producer AUX mutex before training, with source FEC off. */
+static int dp_set_fec_ready(void *ctx, bool enable)
+{
+	struct qcom_usb4_dp *dp = ctx;
+	u8 ready, status, tx[4] = { enable, 0x0a, 0, 0 }, rx[4] = {};
+	int ret;
+
+	/* Receiver readiness may survive a previous stream or a host reset. */
+	ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_CONFIGURATION, &ready);
+	if (ret)
+		return ret;
+	/* Preserve the error-counter selection while changing readiness. */
+	ready = (ready & ~DP_FEC_READY) | (enable ? DP_FEC_READY : 0);
+	ret = drm_dp_dpcd_write_byte(&dp->aux, DP_FEC_CONFIGURATION, ready);
+	if (ret)
+		return ret;
+	ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_CONFIGURATION, &status);
+	if (ret)
+		return ret;
+	if (status != ready)
+		return -EIO;
+
+	/* FEC detection flags are latched W1C events, not current encoder state.
+	 * Require a fresh enable event from the next stream's FEC sequence.
+	 */
+	ret = drm_dp_dpcd_write_byte(&dp->aux, DP_FEC_STATUS,
+			DP_FEC_DECODE_EN_DETECTED | DP_FEC_DECODE_DIS_DETECTED);
+	if (ret)
+		return ret;
+	ret = drm_dp_dpcd_read_byte(&dp->aux, DP_FEC_STATUS, &status);
+	if (ret)
+		return ret;
+	if (status & (DP_FEC_DECODE_EN_DETECTED | DP_FEC_DECODE_DIS_DETECTED))
+		return -EIO;
+	dev_info(dp->dev, "USB4 FEC readiness prepared: ready=%#x status=%#x\n",
+		 ready, status);
+
+	/* USB4 2.0 section 10.4.9: SET_FEC_READY needs a matching
+	 * acknowledgment; its returned data bytes have no defined meaning.
+	 * Raw software AUX transactions do not drive the DPTX snooper.
+	 */
+	tx[0] = enable;
+	ret = dp_control(dp, tx, rx);
+	dev_dbg(dp->dev, "FEC readiness acknowledged: %d\n", ret);
+	return ret;
+}
+
+static int dp_train_link(void *ctx, unsigned int rate, unsigned int lanes)
+{
+	struct qcom_usb4_dp *dp = ctx;
+
+	return qcom_usb4_dp_train_link(dp->router, dp_control, dp, rate, lanes);
+}
+
+static const struct msm_dp_usb4_ops dp_producer_ops = {
+	.configure_link = dp_configure_link,
+	.train_link = dp_train_link,
+	.set_fec_ready = dp_set_fec_ready,
+};
+
+static void dp_caps_work(struct work_struct *work)
+{
+	struct qcom_usb4_dp *dp = container_of(to_delayed_work(work),
+					      struct qcom_usb4_dp, caps_work);
+	int ret;
+
+	if (!READ_ONCE(dp->enabled) || !READ_ONCE(dp->allocated) ||
+	    READ_ONCE(dp->ready) || READ_ONCE(dp->fifo_fault))
+		return;
+	if ((readl(dp->router + 0x6028) & GENMASK(31, 30)) != GENMASK(31, 30) ||
+	    !(readl(dp_base(dp, 0) + DP_FIFO_READY) & BIT(0))) {
+		if (++dp->caps_polls < DP_CAPS_MAX_POLLS)
+			queue_delayed_work(system_unbound_wq, &dp->caps_work,
+					   msecs_to_jiffies(DP_CAPS_POLL_MS));
+		else
+			dev_warn(dp->dev, "DP tunnel/AUX readiness deadline expired\n");
+		return;
+	}
+	ret = qcom_usb4_dp_negotiate_caps(dp->router, &dp->aux, dp_control, dp);
+	if (ret) {
+		dev_err(dp->dev, "DP receiver capability negotiation failed: %d\n", ret);
+		return;
+	}
+	mutex_lock(&dp->state_lock);
+	if (dp->enabled && dp->allocated) {
+		dp->ready = true;
+		ret = msm_dp_usb4_hpd(dp->display, true, false);
+		dev_info(dp->dev, "DP receiver ready; HPD queued: %d\n", ret);
+	}
+	mutex_unlock(&dp->state_lock);
+}
+
+static void dp_mailbox_work(struct work_struct *work)
+{
+	struct qcom_usb4_dp *dp = container_of(to_delayed_work(work),
+					      struct qcom_usb4_dp, mailbox_work);
+	unsigned int adapter;
+
+	if (!READ_ONCE(dp->enabled))
+		return;
+	for (adapter = 0; adapter < 2; adapter++) {
+		void __iomem *base = dp_base(dp, adapter);
+		u32 request, reply = 0;
+		bool release = false;
+		int ret = 0;
+
+		mutex_lock(&dp->command_lock);
+		if (readl(base + DP_MCU_REPLY)) {
+			mutex_unlock(&dp->command_lock);
+			continue;
+		}
+		if (dp->pending_reply[adapter]) {
+			writel(dp->pending_reply[adapter], base + DP_MCU_REPLY);
+			dp->pending_reply[adapter] = 0;
+			mutex_unlock(&dp->command_lock);
+			continue;
+		}
+		request = readl(base + DP_MCU_REQUEST);
+		if (!request) {
+			mutex_unlock(&dp->command_lock);
+			continue;
+		}
+		if (request != 0x1004 && request != 0x1104 &&
+		    request != 0x1204 && request != 0x2) {
+			mutex_unlock(&dp->command_lock);
+			dev_warn_ratelimited(dp->dev, "DP%u unknown request %#x left pending\n",
+					    adapter, request);
+			continue;
+		}
+		writel(DP_IRQ_MCU_REQUEST, base + DP_IRQ_CLEAR);
+		writel(0, base + DP_MCU_REQUEST);
+		/* Reserve this adapter's response slot while callbacks execute. */
+		dp->pending_reply[adapter] = U32_MAX;
+		mutex_unlock(&dp->command_lock);
+		mutex_lock(&dp->state_lock);
+		switch (request) {
+		case 0x1004:
+			reply = !adapter && !dp->allocated && !dp->fifo_fault && !dp->release_failed ?
+				0x1006 : 0x11006;
+			break;
+		case 0x1104:
+			if (!adapter && !dp->fifo_fault && !dp->release_failed) {
+				ret = msm_dp_usb4_route(dp->display, 1);
+				if (!ret) {
+					writel(readl(base + DP_IRQ_ENABLE) | DP_IRQ_RESOURCE,
+					       base + DP_IRQ_ENABLE);
+					dp->allocated = true;
+					dp->caps_polls = 0;
+					queue_delayed_work(system_unbound_wq, &dp->caps_work,
+							   msecs_to_jiffies(DP_CAPS_POLL_MS));
+				}
+			} else {
+				ret = -ENOSPC;
+			}
+			reply = ret ? 0x11106 : 0x1106;
+			break;
+		case 0x1204:
+			dev_info(dp->dev, "USB4 release: request adapter=%u allocated=%d ready=%d\n",
+				 adapter, dp->allocated, dp->ready);
+			if (!adapter && dp->allocated) {
+				dp->allocated = false;
+				dp->ready = false;
+				release = true;
+			}
+			reply = 0x1206;
+			break;
+		case 0x2:
+			/* Notification only; no opcode-6 response. */
+			break;
+		}
+		mutex_unlock(&dp->state_lock);
+		if (release) {
+			/* The capability worker takes state_lock at completion. Do
+			 * not hold it while draining work or stopping the producer.
+			 */
+			dev_info(dp->dev, "USB4 release: drain caps\n");
+			cancel_delayed_work_sync(&dp->caps_work);
+			dev_info(dp->dev, "USB4 release: HPD sync enter\n");
+			ret = msm_dp_usb4_hpd_sync(dp->display, false, false);
+			dev_info(dp->dev, "USB4 release: HPD sync return %d\n", ret);
+			if (!ret)
+				ret = msm_dp_usb4_route(dp->display, 0);
+			dev_info(dp->dev, "USB4 release: route return %d, clear resource\n", ret);
+			writel(readl(dp->router + 0x84078) & ~BIT(31),
+			       dp->router + 0x84078);
+			dev_info(dp->dev, "USB4 release: resource cleared\n");
+			mutex_lock(&dp->state_lock);
+			dp->release_failed = !!ret;
+			if (ret) {
+				dp->allocated = true;
+				/* Failure status uses the observed opcode-6 layout;
+				 * this negative release encoding is not hardware-tested.
+				 */
+				reply = 0x11206;
+				dev_warn(dp->dev, "DP release incomplete (%d); ownership retained\n", ret);
+			}
+			mutex_unlock(&dp->state_lock);
+		}
+		mutex_lock(&dp->command_lock);
+		dp->pending_reply[adapter] = reply;
+		if (reply && !readl(base + DP_MCU_REPLY)) {
+			wmb();
+			writel(reply, base + DP_MCU_REPLY);
+			dp->pending_reply[adapter] = 0;
+		}
+		mutex_unlock(&dp->command_lock);
+		if (release && !ret && !READ_ONCE(dp->stopping))
+			schedule_work(&dp->link_work);
+		dp->messages++;
+		dev_dbg(dp->dev, "DP%u request %#x reply %#x\n", adapter, request, reply);
+	}
+	if (READ_ONCE(dp->enabled))
+		queue_delayed_work(system_unbound_wq, &dp->mailbox_work,
+				   msecs_to_jiffies(DP_MAILBOX_POLL_MS));
+}
+
+/* A separate consumer lets DRM defer until its connector exists without
+ * deferring the host mux on which the Type-C display bridge itself depends.
+ * Only USB4/TBT link ownership creates this child; native DP keeps its AUX.
+ */
+static int qcom_usb4_dp_probe(struct platform_device *pdev)
+{
+	struct qcom_usb4_dp *dp = *(struct qcom_usb4_dp **)dev_get_platdata(&pdev->dev);
+	struct device_link *link;
+	int ret;
+
+	if (READ_ONCE(dp->stopping) || !READ_ONCE(dp->connected))
+		return -ENODEV;
+	ret = qcom_usb4_dp_enable(dp);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "display provider attachment failed\n");
+	link = device_link_add(&pdev->dev, dp->display, DL_FLAG_AUTOREMOVE_CONSUMER);
+	if (!link) {
+		qcom_usb4_dp_disable(dp, true);
+		return -ENOMEM;
+	}
+	platform_set_drvdata(pdev, dp);
+	return 0;
+}
+
+static void qcom_usb4_dp_remove(struct platform_device *pdev)
+{
+	qcom_usb4_dp_disable(platform_get_drvdata(pdev), true);
+}
+
+struct platform_driver qcom_usb4_dp_driver = {
+	.probe = qcom_usb4_dp_probe,
+	.remove = qcom_usb4_dp_remove,
+	.shutdown = qcom_usb4_dp_remove,
+	.driver.name = "qcom-usb4-dp",
+};
+
+static void qcom_usb4_dp_link_work(struct work_struct *work)
+{
+	struct qcom_usb4_dp *dp = container_of(work, struct qcom_usb4_dp, link_work);
+	struct platform_device *child;
+	int ret;
+
+	if (READ_ONCE(dp->stopping))
+		return;
+	if (READ_ONCE(dp->connected)) {
+		if (!dp->child) {
+			child = platform_device_register_data(dp->dev, "qcom-usb4-dp",
+					PLATFORM_DEVID_AUTO, &dp, sizeof(dp));
+			if (IS_ERR(child)) {
+				dev_err(dp->dev, "display child registration failed: %ld\n", PTR_ERR(child));
+				return;
+			}
+			dp->child = child;
+		} else if (READ_ONCE(dp->enabled) && !READ_ONCE(dp->allocated)) {
+			dp_discover(dp);
+		}
+		return;
+	}
+	/* Keep servicing firmware release until DRM has stopped the producer. */
+	ret = qcom_usb4_dp_disable(dp, false);
+	if (ret)
+		return;
+	if (dp->child) {
+		platform_device_unregister(dp->child);
+		dp->child = NULL;
+	}
+}
+
+void qcom_usb4_dp_set_connected(struct qcom_usb4_dp *dp, bool connected)
+{
+	if (!dp || READ_ONCE(dp->stopping))
+		return;
+	WRITE_ONCE(dp->connected, connected);
+	schedule_work(&dp->link_work);
+}
+
+void qcom_usb4_dp_stop(struct qcom_usb4_dp *dp)
+{
+	if (!dp)
+		return;
+	WRITE_ONCE(dp->stopping, true);
+	cancel_work_sync(&dp->link_work);
+	if (dp->child) {
+		platform_device_unregister(dp->child);
+		dp->child = NULL;
+	}
+	qcom_usb4_dp_disable(dp, true);
+}
+
+struct qcom_usb4_dp *qcom_usb4_dp_create(struct device *dev, void __iomem *router)
+{
+	struct qcom_usb4_dp *dp;
+
+	dp = devm_kzalloc(dev, sizeof(*dp), GFP_KERNEL);
+	if (!dp)
+		return ERR_PTR(-ENOMEM);
+	dp->dev = dev;
+	dp->router = router;
+	mutex_init(&dp->lifecycle_lock);
+	mutex_init(&dp->state_lock);
+	mutex_init(&dp->fifo_lock);
+	mutex_init(&dp->command_lock);
+	INIT_WORK(&dp->link_work, qcom_usb4_dp_link_work);
+	INIT_DELAYED_WORK(&dp->mailbox_work, dp_mailbox_work);
+	INIT_DELAYED_WORK(&dp->caps_work, dp_caps_work);
+	dp->aux.name = "Surface USB4 router0 DP-IN0";
+	dp->aux.dev = dev;
+	dp->aux.transfer = dp_aux_transfer;
+	dp->aux.no_zero_sized = true;
+	drm_dp_aux_init(&dp->aux);
+	return dp;
+}
+
+int qcom_usb4_dp_enable(struct qcom_usb4_dp *dp)
+{
+	unsigned int adapter;
+	int ret;
+
+	mutex_lock(&dp->lifecycle_lock);
+	if (dp->enabled) {
+		ret = -EALREADY;
+		goto out;
+	}
+	if (dp->fifo_fault) {
+		ret = -EIO;
+		goto out;
+	}
+	for (adapter = 0; adapter < 2; adapter++) {
+		if (readl(dp_base(dp, adapter) + DP_MCU_REPLY)) {
+			ret = -EBUSY;
+			goto out;
+		}
+	}
+	dp->display = bus_find_device_by_name(&platform_bus_type, NULL,
+					      "af54000.displayport-controller");
+	if (!dp->display) {
+		ret = -EPROBE_DEFER;
+		goto out;
+	}
+	ret = pm_runtime_resume_and_get(dp->dev);
+	if (ret < 0)
+		goto put_display;
+	dp->runtime_held = true;
+	ret = msm_dp_usb4_attach(dp->display, &dp->aux,
+				 &dp_producer_ops,
+				 dp);
+	if (ret)
+		goto put_runtime;
+	WRITE_ONCE(dp->enabled, true);
+	queue_delayed_work(system_unbound_wq, &dp->mailbox_work, 0);
+	dev_info(dp->dev, "DP0 mailbox owner and router AUX enabled\n");
+	/* Discovery failure does not undo the live owner. A later link event
+	 * can retry without creating an unbound child with active callbacks.
+	 */
+	dp_discover(dp);
+	ret = 0;
+	goto out;
+put_runtime:
+	pm_runtime_put(dp->dev);
+	dp->runtime_held = false;
+put_display:
+	put_device(dp->display);
+	dp->display = NULL;
+out:
+	mutex_unlock(&dp->lifecycle_lock);
+	return ret;
+}
+
+int qcom_usb4_dp_discover(struct qcom_usb4_dp *dp)
+{
+	int ret;
+
+	mutex_lock(&dp->lifecycle_lock);
+	ret = dp_discover(dp);
+	mutex_unlock(&dp->lifecycle_lock);
+	return ret;
+}
+
+int qcom_usb4_dp_disable(struct qcom_usb4_dp *dp, bool force)
+{
+	int ret = 0;
+
+	if (!dp)
+		return 0;
+	mutex_lock(&dp->lifecycle_lock);
+	if (!dp->enabled)
+		goto out;
+	mutex_lock(&dp->state_lock);
+	if (dp->allocated && !force) {
+		mutex_unlock(&dp->state_lock);
+		ret = -EBUSY;
+		goto out;
+	}
+	WRITE_ONCE(dp->enabled, false);
+	mutex_unlock(&dp->state_lock);
+	cancel_delayed_work_sync(&dp->mailbox_work);
+	cancel_delayed_work_sync(&dp->caps_work);
+	msm_dp_usb4_detach(dp->display);
+	msm_dp_usb4_route(dp->display, 0);
+	writel(readl(dp->router + 0x84078) & ~BIT(31), dp->router + 0x84078);
+	/* Detach has stopped producer transfers; drain direct AUX users too. */
+	mutex_lock(&dp->fifo_lock);
+	mutex_unlock(&dp->fifo_lock);
+	dp->allocated = false;
+	dp->ready = false;
+	if (dp->runtime_held) {
+		pm_runtime_put(dp->dev);
+		dp->runtime_held = false;
+	}
+	put_device(dp->display);
+	dp->display = NULL;
+	dev_info(dp->dev, "experimental DP mailbox owner disabled\n");
+out:
+	mutex_unlock(&dp->lifecycle_lock);
+	return ret;
+}
+
+bool qcom_usb4_dp_active(struct qcom_usb4_dp *dp)
+{
+	return dp && READ_ONCE(dp->enabled);
+}
+
+ssize_t qcom_usb4_dp_status(struct qcom_usb4_dp *dp, char *buf)
+{
+	return sysfs_emit(buf, "enabled %u allocated %u ready %u fifo_fault %u release_failed %u messages %u\n",
+			  READ_ONCE(dp->enabled), READ_ONCE(dp->allocated),
+			  READ_ONCE(dp->ready), READ_ONCE(dp->fifo_fault),
+			  READ_ONCE(dp->release_failed), READ_ONCE(dp->messages));
+}
